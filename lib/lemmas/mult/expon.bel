%======================================================%
% Algebraic properties of multiplicities
% (linear systems with exponentials)
%======================================================%

% Remark: • is not total since 𝟙 • 𝟙, ω • 𝟙, etc. are undefined

% Functionality: If α₁ • α₂ = α and α₁ • α₂ = α', then α = α'

rec mult_func : [ ⊢ • α₁ α₂ α] → [ ⊢ • α₁ α₂ α'] → [ ⊢ mult_eq α α'] =
  / total /
  fn m1, m2 ⇒ case m1 of
  | [ ⊢ •/00] ⇒ let [ ⊢ •/00] = m2 in [ ⊢ mult/refl]
  | [ ⊢ •/01] ⇒ let [ ⊢ •/01] = m2 in [ ⊢ mult/refl]
  | [ ⊢ •/10] ⇒ let [ ⊢ •/10] = m2 in [ ⊢ mult/refl]
  | [ ⊢ •/ωω] ⇒ let [ ⊢ •/ωω] = m2 in [ ⊢ mult/refl]
  ;

% Identity elements:
% (1) 𝟘 and ω are identity elements
% (2) every harmless element is an identity element

rec ident_0_prf : {m:[ ⊢ mult]} {m2:[ ⊢ mult]} [ ⊢ • 𝟘 m m2]
                → [ ⊢ mult_eq m m2] =
  / total /
  mlam m, m2 ⇒ fn d ⇒ case d of
  | [ ⊢ •/00] ⇒ [ ⊢ mult/refl]
  | [ ⊢ •/01] ⇒ [ ⊢ mult/refl]
  ;

rec mult_ident_0 : Ident [ ⊢ 𝟘] =
  / total /
  Is-Id ident_0_prf
  ;

rec ident_w_prf : {m:[ ⊢ mult]} {m2:[ ⊢ mult]} [ ⊢ • ω m m2]
                → [ ⊢ mult_eq m m2] =
  / total /
  mlam m, m2 ⇒ fn d ⇒ let [ ⊢ •/ωω] = d in [ ⊢ mult/refl]
  ;

rec mult_ident_w : Ident [ ⊢ ω] =
  / total /
  Is-Id ident_w_prf
  ;

rec halident_prf : {α:[ ⊢ mult]} [ ⊢ hal α] → Ident [ ⊢ α] =
  / total /
  mlam α ⇒ fn h ⇒ case h of
  | [ ⊢ hal/0] ⇒ mult_ident_0
  | [ ⊢ hal/ω] ⇒ mult_ident_w
  ;

rec mult_halident : HalIdent =
  / total /
  Hal-Ident halident_prf
  ;

% Every unit element is harmless

rec unithal_prf : {α₁:[ ⊢ mult]} {α:[ ⊢ mult]} [ ⊢ • α₁ α α] → [ ⊢ hal α₁] =
  / total /
  mlam _, _ ⇒ fn d ⇒ case d of
  | [ ⊢ •/00] ⇒ [ ⊢ hal/0]
  | [ ⊢ •/01] ⇒ [ ⊢ hal/0]
  | [ ⊢ •/ωω] ⇒ [ ⊢ hal/ω]
  ;

rec mult_unithal : UnitHal =
  / total /
  Unit-Hal unithal_prf
  ;

% For any α, obtain a harmless identity element β such that β • α = α

rec mult_get_id : {α:[ ⊢ mult]} [ ⊢ get_unit α] =
  / total /
  mlam α ⇒ case [ ⊢ α] of
  | [ ⊢ 𝟘] ⇒ [ ⊢ get-unit hal/0 •/00]
  | [ ⊢ 𝟙] ⇒ [ ⊢ get-unit hal/0 •/01]
  | [ ⊢ ω] ⇒ [ ⊢ get-unit hal/ω •/ωω]
  ;

% Zero-sum-freedom: If α₁ • α₂ = α and α is harmless, then α₁ = α

rec mult_zsfree : [ ⊢ • α₁ α₂ α] → [ ⊢ hal α] → [ ⊢ mult_eq α₁ α] =
  / total /
  fn m, u ⇒ case u of
  | [ ⊢ hal/0] ⇒ let [ ⊢ •/00] = m in [ ⊢ mult/refl]
  | [ ⊢ hal/ω] ⇒ let [ ⊢ •/ωω] = m in [ ⊢ mult/refl]
  ;

rec zsfree_prf : {α₁:[ ⊢ mult]} {α₂:[ ⊢ mult]} {α:[ ⊢ mult]}
                 [ ⊢ • α₁ α₂ α] → [ ⊢ hal α] → [ ⊢ mult_eq α₁ α] =
  / total /
  mlam _, _, _ ⇒ fn m, u ⇒ mult_zsfree m u
  ;

rec mult_zsfree_rec : ZsFree =
  / total /
  Is-ZsFree zsfree_prf
  ;

rec mult_zsfree_cor : [ ⊢ • α₁ α₂ 𝟘] → [ ⊢ mult_eq α₁ 𝟘] =
  / total /
  fn m ⇒ mult_zsfree m [ ⊢ hal/0]
  ;

% Commutativity: If α₁ • α₂ = α, then α₂ • α₁ = α

rec mult_comm : [ ⊢ • α₁ α₂ α] → [ ⊢ • α₂ α₁ α] =
  / total /
  fn m ⇒ case m of
  | [ ⊢ •/00] ⇒ [ ⊢ •/00]
  | [ ⊢ •/01] ⇒ [ ⊢ •/10]
  | [ ⊢ •/10] ⇒ [ ⊢ •/01]
  | [ ⊢ •/ωω] ⇒ [ ⊢ •/ωω]
  ;

% Associativity: If (α₁ • α₂) • α₃ = α, then α₁ • (α₂ • α₃) = α

rec mult_assoc : {M1:[ ⊢ • α₁ α₂ α₁₂]} {M2:[ ⊢ • α₁₂ α₃ α]}
                 [ ⊢ mult_assoc_res M1 M2] =
  / total 2 /
  mlam M1, M2 ⇒ case [ ⊢ M2] of
  | [ ⊢ •/00] ⇒ let [ ⊢ •/00] = [ ⊢ M1] in [ ⊢ mult-assoc •/00 •/00 M1 M2]
  | [ ⊢ •/01] ⇒ let [ ⊢ •/00] = [ ⊢ M1] in [ ⊢ mult-assoc •/01 •/01 M1 M2]
  | [ ⊢ •/10] ⇒
    (case [ ⊢ M1] of
    | [ ⊢ •/10] ⇒ [ ⊢ mult-assoc •/00 •/10 M1 M2]
    | [ ⊢ •/01] ⇒ [ ⊢ mult-assoc •/10 •/01 M1 M2]
    )
  | [ ⊢ •/ωω] ⇒ let [ ⊢ •/ωω] = [ ⊢ M1] in [ ⊢ mult-assoc •/ωω •/ωω M1 M2]
  ;

% Cancellativity: If α₁ • α₂ = α and α₁ • α₂' = α, then α₂ = α₂'

rec mult_canc : [ ⊢ • α₁ α₂ α] → [ ⊢ • α₁ α₂' α] → [ ⊢ mult_eq α₂ α₂'] =
  / total /
  fn m1, m2 ⇒ case m1 of
  | [ ⊢ •/00] ⇒ let [ ⊢ •/00] = m2 in [ ⊢ mult/refl]
  | [ ⊢ •/01] ⇒ let [ ⊢ •/01] = m2 in [ ⊢ mult/refl]
  | [ ⊢ •/10] ⇒ let [ ⊢ •/10] = m2 in [ ⊢ mult/refl]
  | [ ⊢ •/ωω] ⇒ let [ ⊢ •/ωω] = m2 in [ ⊢ mult/refl]
  ;

rec canc_prf : {α₁:[ ⊢ mult]} {α₂:[ ⊢ mult]} {α₂':[ ⊢ mult]} {α:[ ⊢ mult]}
               [ ⊢ • α₁ α₂ α] → [ ⊢ • α₁ α₂' α] → [ ⊢ mult_eq α₂ α₂'] =
  / total /
  mlam _, _, _, _ ⇒ fn m1, m2 ⇒ mult_canc m1 m2
  ;

rec mult_cancl : Cancl =
  / total /
  Is-Cancl canc_prf
  ;

%------------------------------------------------------%
% Properties of harmless elements
%------------------------------------------------------%

% Harmless elements are idempotent

rec halidem_prf : {α:[ ⊢ mult]} [ ⊢ hal α] → [ ⊢ • α α α] =
  / total /
  mlam _ ⇒ fn h ⇒ case h of
  | [ ⊢ hal/0] ⇒ [ ⊢ •/00]
  | [ ⊢ hal/ω] ⇒ [ ⊢ •/ωω]
  ;

rec mult_halidem_rec : HalIdem =
  / total /
  Is-HalIdem halidem_prf
  ;

% If hal(α), then there exist α₁, α₂ with α₁ • α₂ = α, hal(α₁) and hal(α₂)

rec mult_get_hal : [ ⊢ hal α] → [ ⊢ get_hal_split α] =
  / total /
  fn u ⇒ case u of
  | [ ⊢ hal/0] ⇒ [ ⊢ get-hal-split hal/0 hal/0 •/00]
  | [ ⊢ hal/ω] ⇒ [ ⊢ get-hal-split hal/ω hal/ω •/ωω]
  ;
