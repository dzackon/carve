%======================================================%
% Algebraic properties of multiplicities
% (linear systems with exponentials)
%======================================================%

% Remark: cancellativity does not hold since ω • α = ω for any α

% Totality: For any α₁, α₂, there exists an α such that α₁ • α₂ = α

rec mult_total : {α₁:[ ⊢ mult]} {α₂:[ ⊢ mult]} [ ⊢ get_mult α₁ α₂] =
  / total /
  mlam α₁, α₂ ⇒
  case [ ⊢ α₁] of
  | [ ⊢ 𝟘] ⇒ [_ ⊢ get-mult •/0a]
  | [ ⊢ ω] ⇒ [_ ⊢ get-mult •/ωa]
  | [ ⊢ 𝟙] ⇒
    case [ ⊢ α₂] of
    | [ ⊢ 𝟘] ⇒ [ ⊢ get-mult •/a0]
    | [ ⊢ ω] ⇒ [ ⊢ get-mult •/aω]
    | [ ⊢ 𝟙] ⇒ [ ⊢ get-mult •/11]
  ;

rec mult_total_rec : Total =
  / total /
  Is-Total mult_total
  ;

% Functionality: If α₁ • α₂ = α and α₁ • α₂ = α', then α = α'

rec mult_func : [ ⊢ • α₁ α₂ α] → [ ⊢ • α₁ α₂ α'] → [ ⊢ mult_eq α α'] =
  / total /
  fn m1, m2 ⇒ case m1 of
  | [ ⊢ •/0a] ⇒
    (case m2 of
    | [ ⊢ •/0a] ⇒ [ ⊢ mult/refl]
    | [ ⊢ •/a0] ⇒ [ ⊢ mult/refl]
    | [ ⊢ •/aω] ⇒ [ ⊢ mult/refl]
    )
  | [ ⊢ •/a0] ⇒
    (case m2 of
    | [ ⊢ •/0a] ⇒ [ ⊢ mult/refl]
    | [ ⊢ •/a0] ⇒ [ ⊢ mult/refl]
    | [ ⊢ •/ωa] ⇒ [ ⊢ mult/refl]
    )
  | [ ⊢ •/11] ⇒ let [ ⊢ •/11] = m2 in [ ⊢ mult/refl]
  | [ ⊢ •/ωa] ⇒
    (case m2 of
    | [ ⊢ •/a0] ⇒ [ ⊢ mult/refl]
    | [ ⊢ •/ωa] ⇒ [ ⊢ mult/refl]
    | [ ⊢ •/aω] ⇒ [ ⊢ mult/refl]
    )
  | [ ⊢ •/aω] ⇒
    (case m2 of
    | [ ⊢ •/0a] ⇒ [ ⊢ mult/refl]
    | [ ⊢ •/ωa] ⇒ [ ⊢ mult/refl]
    | [ ⊢ •/aω] ⇒ [ ⊢ mult/refl]
    )
  ;

% Identity elements:
% 𝟘 is an identity element.
% Remark: ω is harmless but NOT an identity element (ω • 𝟙 = ω ≠ 𝟙).

rec ident_0_prf : {m:[ ⊢ mult]} {m2:[ ⊢ mult]} [ ⊢ • 𝟘 m m2]
                → [ ⊢ mult_eq m m2] =
  / total /
  mlam m, m2 ⇒ fn d ⇒ case d of
  | [ ⊢ •/0a] ⇒ [ ⊢ mult/refl]
  | [ ⊢ •/a0] ⇒ [ ⊢ mult/refl]
  | [ ⊢ •/aω] ⇒ [ ⊢ mult/refl]
  ;

rec mult_ident_0 : Ident [ ⊢ 𝟘] =
  / total /
  Is-Id ident_0_prf
  ;

% For any α, obtain a harmless identity element β such that β • α = α

rec mult_get_id : {α:[ ⊢ mult]} [ ⊢ get_unit α] =
  / total /
  mlam _ ⇒ [ ⊢ get-unit hal/0 •/0a]
  ;

% Zero-sum-freedom at the identity element 𝟘:
% If α₁ • α₂ = 𝟘, then α₁ = 𝟘.
% Remark: zero-sum-freedom relative to arbitrary harmless elements
% fails (𝟙 • ω = ω with ω harmless but 𝟙 ≠ ω).

rec mult_zsfree_cor : [ ⊢ • α₁ α₂ 𝟘] → [ ⊢ mult_eq α₁ 𝟘] =
  / total /
  fn m ⇒ case m of
  | [ ⊢ •/0a] ⇒ [ ⊢ mult/refl]
  | [ ⊢ •/a0] ⇒ [ ⊢ mult/refl]
  ;

% Commutativity: If α₁ • α₂ = α, then α₂ • α₁ = α

rec mult_comm : [ ⊢ • α₁ α₂ α] → [ ⊢ • α₂ α₁ α] =
  / total /
  fn m ⇒ case m of
  | [ ⊢ •/0a] ⇒ [ ⊢ •/a0]
  | [ ⊢ •/a0] ⇒ [ ⊢ •/0a]
  | [ ⊢ •/11] ⇒ [ ⊢ •/11]
  | [ ⊢ •/ωa] ⇒ [ ⊢ •/aω]
  | [ ⊢ •/aω] ⇒ [ ⊢ •/ωa]
  ;

% Associativity: If (α₁ • α₂) • α₃ = α, then α₁ • (α₂ • α₃) = α

rec mult_assoc : {M1:[ ⊢ • α₁ α₂ α₁₂]} {M2:[ ⊢ • α₁₂ α₃ α]}
                 [ ⊢ mult_assoc_res M1 M2] =
  / total /
  mlam M1, M2 ⇒ case [ ⊢ M1] of
  | [ ⊢ •/0a] ⇒ [ ⊢ mult-assoc M2 •/0a _ _]
  | [ ⊢ •/a0] ⇒ [ ⊢ mult-assoc •/0a M2 _ _]
  | [ ⊢ •/11] ⇒
    (case [ ⊢ M2] of
    | [ ⊢ •/a0] ⇒ [ ⊢ mult-assoc •/a0 •/11 _ _]
    | [ ⊢ •/ωa]:[ ⊢ • _ α₃ _] ⇒
      (case mult_total [ ⊢ 𝟙] [ ⊢ α₃] of
      | [ ⊢ get-mult •/a0] ⇒ [ ⊢ mult-assoc •/a0 •/11 _ _]
      | [ ⊢ get-mult •/11] ⇒ [ ⊢ mult-assoc •/11 •/aω _ _]
      | [ ⊢ get-mult •/aω] ⇒ [ ⊢ mult-assoc •/aω •/aω _ _]
      )
    | [ ⊢ •/aω] ⇒ [ ⊢ mult-assoc •/aω •/aω _ _]
    )
  | [ ⊢ •/ωa]:[ ⊢ • _ α₂ _] ⇒
    (case [ ⊢ M2] of
    | [ ⊢ •/a0] ⇒ [ ⊢ mult-assoc •/a0 •/ωa _ _]
    | [ ⊢ •/ωa]:[ ⊢ • _ α₃ _] ⇒
      let [ ⊢ get-mult M3] = mult_total [ ⊢ α₂] [ ⊢ α₃] in
      [ ⊢ mult-assoc M3 •/ωa _ _]
    | [ ⊢ •/aω] ⇒ [ ⊢ mult-assoc •/aω •/ωa _ _]
    )
  | [ ⊢ •/aω] ⇒
    (case [ ⊢ M2] of
    | [ ⊢ •/a0] ⇒ [ ⊢ mult-assoc •/ωa •/aω _ _]
    | [ ⊢ •/ωa] ⇒ [ ⊢ mult-assoc •/ωa •/aω _ _]
    | [ ⊢ •/aω] ⇒ [ ⊢ mult-assoc •/ωa •/aω _ _]
    )
  ;

%------------------------------------------------------%
% Properties of harmless elements
%------------------------------------------------------%

% Harmless elements are idempotent

rec halidem_prf : {α:[ ⊢ mult]} [ ⊢ hal α] → [ ⊢ • α α α] =
  / total /
  mlam _ ⇒ fn h ⇒ case h of
  | [ ⊢ hal/0] ⇒ [ ⊢ •/0a]
  | [ ⊢ hal/ω] ⇒ [ ⊢ •/ωa]
  ;

rec mult_halidem_rec : HalIdem =
  / total /
  Is-HalIdem halidem_prf
  ;
