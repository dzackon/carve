%======================================================%
% Further properties of objects
%
% These lemmas assume the signature declares no constructors for obj, so
% that every object of type obj under an LF context Ψ is necessarily a
% parameter variable drawn from Ψ
%======================================================%

% Decidable equality of objects: for any M, N drawn from Ψ, either M = N or M ≠ N

rec comp_obj : (Ψ:ctx) {M:[Ψ ⊢ obj]} {N:[Ψ ⊢ obj]} CompareObjs [Ψ ⊢ M] [Ψ ⊢ N] =
  / total p (comp_obj p) /
  mlam M, N ⇒
  let [_ ⊢ #p] = [_ ⊢ M] in
  let [Ψ ⊢ #q] = [_ ⊢ N] in
  case [Ψ] of
  | [ ] ⇒ impossible [ ⊢ M]
  | [_,x:obj] ⇒
    case [_,x:obj ⊢ M] of
    | [_,x:obj ⊢ x] ⇒
      (case [_,x:obj ⊢ N] of
      | [_,x:obj ⊢ x] ⇒ Obj-Eq
      | [_,x:obj ⊢ #q[..]] ⇒ Obj-Neq (fn e ⇒ impossible e)
      )
    | [_,x:obj ⊢ #p[..]] ⇒
      case [_,x:obj ⊢ N] of
      | [_,x:obj ⊢ x] ⇒ Obj-Neq (fn e ⇒ impossible e)
      | [_,x:obj ⊢ #q[..]] ⇒ (case comp_obj [_ ⊢ #p] [_ ⊢ #q] of
        | Obj-Eq ⇒ Obj-Eq
        | Obj-Neq n ⇒ Obj-Neq (obj_neq_weak n))
  ;

% If X is an object under Ψ,x:obj and X ≠ x, then X is a parameter variable in Ψ

rec prune_obj : {#p:#[Ψ,x:obj ⊢ obj]} ([Ψ,x:obj ⊢ obj_eq #p x] → [ ⊢ false])
  → PruneObj [Ψ,x:obj ⊢ #p] =
  / total /
  mlam #p ⇒ fn n ⇒
  case [_,x:obj ⊢ #p] of
  | [_,x:obj ⊢ x] ⇒ impossible n [_,x:obj ⊢ obj/refl]
  | [_,x:obj ⊢ #q[..]] ⇒ Prune-Obj
  ;
