%======================================================%
% Properties of context update and look-up (by-name variants
% requiring a well-formed context)
%======================================================%

%------------------------------------------------------%
% Look-up properties
%------------------------------------------------------%

% Uniqueness of look-up (or left-uniqueness of update):
% If (x :α A) ∈ₙ Δ, (x :α' A') ∈ₘ Δ and Δ is well-formed, then n = m,
% α = α', and A = A'

LF nat_tp_mult_eq : nat → nat → tp → tp → mult → mult → type =
| nat-tp-mult-refl : nat_tp_mult_eq n n A A α α;

rec lookup_unique_obj :
  [Ψ ⊢ upd Δ n[] X Y₁ A₁[] B₁ α₁[] β₁ Δ₁]
  → [Ψ ⊢ upd Δ n'[] X Y₂ A₂[] B₂ α₂[] β₂ Δ₂]
  → Wf [Ψ ⊢ Δ]
  → [ ⊢ nat_tp_mult_eq n n' A₁ A₂ α₁ α₂] =
  / total 1 /
  fn u1, u2, wf ⇒ case wf of
  | Wf-Nil ⇒ impossible u1
  | Wf-Cons wf1 n ⇒
    (case u1 of
    | [_ ⊢ upd/t _] ⇒
      (case u2 of
      | [_ ⊢ upd/t _] ⇒ [ ⊢ nat-tp-mult-refl]
      | [_ ⊢ upd/n U2] ⇒ impossible n [_ ⊢ lookn U2])
    | [_ ⊢ upd/n U1] ⇒
      (case u2 of
      | [_ ⊢ upd/t _] ⇒ impossible n
      | [_ ⊢ upd/n U2] ⇒ lookup_unique_obj [_ ⊢ U1] [_ ⊢ U2] wf1)
    )
  ;

% If (x :α A) ∈ₙ Δ, (y :β B) ∈ₘ Δ, and Δ is well-formed, then n ≠ m iff x ≠ y

rec lookup_neq_nat2var : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ n[] X X' A[] A' α[] α' Δ']
  → [Ψ ⊢ upd Δ m[] Y Y' B[] B' β[] β' Δ'']
  → [ ⊢ neq n m]
  → Wf [Ψ ⊢ Δ]
  → ([Ψ ⊢ obj_eq X Y] → [ ⊢ false]) =
  / total 1 /
  fn u1, u2, n, wf, e ⇒
  let [_ ⊢ obj/refl] = e in
  let [ ⊢ nat-tp-mult-refl] = lookup_unique_obj u1 u2 wf in
  neq_irreflex n
  ;

%------------------------------------------------------%
% Algebraic properties
%------------------------------------------------------%

% Functionality (or right-uniqueness):
% If Δ[x :α A ↦ₙ y :β B] = Δ', Δ[x :α A ↦ₘ y :β B] = Δ'', and Δ is well-formed,
% then Δ' = Δ'' [corollary of upd_func using lookup_unique_obj]

rec upd_func_obj :
  [Ψ ⊢ upd Δ n[] X Y A[] B α[] β Δ']
  → [Ψ ⊢ upd Δ n'[] X Y A[] B α[] β Δ'']
  → Wf [Ψ ⊢ Δ]
  → [Ψ ⊢ ctx_eq Δ' Δ''] =
  / total 1 /
  fn u1, u2, wf ⇒
  let [ ⊢ nat-tp-mult-refl] = lookup_unique_obj u1 u2 wf in
  upd_func u1 u2
  ;

% Transitivity:
% Δ[x₁ :α₁ A₁ ↦ₙ x₂ :α₂ A₂][x₂ :α₂ A₂ ↦ₘ x₃ :α₃ A₃] =
% Δ[x₁ :α₁ A₁ ↦ₙ x₃ :α₃ A₃] if the "intermediate context" is well-formed
% [corollary of upd_trans using lookup_unique_obj]

rec upd_trans_obj :
  [Ψ ⊢ upd Δ₁ n[] X₁ X₂ A₁[] A₂[] α₁[] α₂[] Δ₂]
  → [Ψ ⊢ upd Δ₂ m[] X₂ X₃ A₂'[] A₃[] α₂'[] α₃[] Δ₃]
  → Wf [Ψ ⊢ Δ₂]
  → [Ψ ⊢ upd Δ₁ n[] X₁ X₃ A₁[] A₃[] α₁[] α₃[] Δ₃] =
  / total 1 /
  fn u1, u2, wf ⇒
  let [ ⊢ nat-tp-mult-refl] = lookup_unique_obj (upd_symm u1) u2 wf in
  upd_trans u1 u2
  ;

% Confluence (equality of the endpoints of two supplied update paths):
% With positions omitted, the same conclusion holds given all four update
% derivations and Wf for Δ₁, Δ₂, and Δ₂' (required to recover determinism).

rec upd_conf_obj :
  [Ψ ⊢ upd Δ₁ _ X₁ X₂ A₁[] A₂[] α₁[] α₂[] Δ₂]
  → [Ψ ⊢ upd Δ₂ _ Y₁ Y₂ B₁[] B₂[] β₁[] β₂[] Δ₃]
  → [Ψ ⊢ upd Δ₁ _ Y₁ Y₂ B₁[] B₂[] β₁[] β₂[] Δ₂']
  → [Ψ ⊢ upd Δ₂' _ X₁ X₂ A₁[] A₂[] α₁[] α₂[] Δ₃']
  → Wf [Ψ ⊢ Δ₁]
  → Wf [Ψ ⊢ Δ₂]
  → Wf [Ψ ⊢ Δ₂']
  → [Ψ ⊢ ctx_eq Δ₃ Δ₃'] =
  / total 1 /
  fn u1, u2, u3, u4, wf1, wf2, wf3 ⇒ case u1 of
  | [_ ⊢ upd/t _] ⇒
    let (Wf-Cons wf1' n1, Wf-Cons wf2' n2) = (wf1, wf2) in
    (case u2 of
    | [_ ⊢ upd/t _] ⇒
      (case u3 of
      | [_ ⊢ upd/t _] ⇒
        (case u4 of
        | [_ ⊢ upd/t _] ⇒ [_ ⊢ ctx/refl]
        | [_ ⊢ upd/n U4] ⇒ impossible n1 [_ ⊢ lookn U4]
        )
      | [_ ⊢ upd/n U3] ⇒ impossible n2 [_ ⊢ lookn U3]
      )
    | [_ ⊢ upd/n U2] ⇒
      (case u3 of
      | [_ ⊢ upd/t _] ⇒ impossible n1 [_ ⊢ lookn U2]
      | [_ ⊢ upd/n U3] ⇒
        let [_ ⊢ ctx/refl] = upd_func_obj [_ ⊢ U2] [_ ⊢ U3] wf1' in
        (case u4 of
        | [_ ⊢ upd/t _] ⇒ [_ ⊢ ctx/refl]
        | [_ ⊢ upd/n U4] ⇒
          let Wf-Cons wf3' n3 = wf3 in
          impossible n3 [_ ⊢ lookn U4]
        )
      )
    )
  | [_ ⊢ upd/n U1] ⇒
    let (Wf-Cons wf1' n1, Wf-Cons wf2' n2) = (wf1, wf2) in
    (case u2 of
    | [_ ⊢ upd/t _] ⇒
      (case u3 of
      | [_ ⊢ upd/t _] ⇒
        (case u4 of
        | [_ ⊢ upd/t _] ⇒
          let Wf-Cons wf3' n3 = wf3 in
          impossible n3 [_ ⊢ lookn U1]
        | [_ ⊢ upd/n U4] ⇒
          let [_ ⊢ ctx/refl] = upd_func_obj [_ ⊢ U1] [_ ⊢ U4] wf1' in
          [_ ⊢ ctx/refl]
        )
      | [_ ⊢ upd/n U3] ⇒ impossible n1 [_ ⊢ lookn U3]
      )
    | [_ ⊢ upd/n U2] ⇒
      (case u3 of
      | [_ ⊢ upd/t _] ⇒ impossible n2 [_ ⊢ lookn U2]
      | [_ ⊢ upd/n U3] ⇒
        let Wf-Cons wf3' n3 = wf3 in
        (case u4 of
        | [_ ⊢ upd/t _] ⇒ impossible n1 [_ ⊢ lookn U1]
        | [_ ⊢ upd/n U4] ⇒
          let [_ ⊢ ctx/refl] =
            upd_conf_obj [_ ⊢ U1] [_ ⊢ U2] [_ ⊢ U3] [_ ⊢ U4] wf1' wf2' wf3' in
          [_ ⊢ ctx/refl]
        )
      )
    )
  ;
