%======================================================%
% Properties of context update and look-up
%======================================================%

%------------------------------------------------------%
% Pruning lemmas
%------------------------------------------------------%

% "Prune" LF context to remove dependencies:
% Obtain from [Ψ,x:obj ⊢ upd Δ[..] n[] X X A₁[..] A₂[..] α₁[..] α₂[..] Δ'] that
% neither X nor Δ' depend on x

inductive PruneUpd : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  {U:[Ψ,x:obj ⊢ upd Δ[..] n[] X X' A[..] A'[..] α[..] α'[..] Δ']} ctype =
| Prune-Upd : [Ψ ⊢ upd Δ n[] X X' A A' α α' Δ']
  → {U:[Ψ,x:obj ⊢ upd Δ[..] n[] X[..] X'[..] A[..] A'[..] α[..] α'[..] Δ'[..]]}
    PruneUpd [Ψ,x:obj ⊢ U];

rec prune_upd : {U:[Ψ,x:obj ⊢ upd Δ[..] n[] X X A[..] A'[..] α[..] α'[..] Δ']}
  PruneUpd [Ψ,x:obj ⊢ U] =
  / total 1 /
  mlam U ⇒ case [_,x:obj ⊢ U] of
  | [_,x:obj ⊢ upd/t _] ⇒ Prune-Upd [_ ⊢ upd/t _] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ upd/n U1] ⇒
    let Prune-Upd [_ ⊢ U2] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1] in
    Prune-Upd [_ ⊢ upd/n U2] [_,x:obj ⊢ _]
  ;

%------------------------------------------------------%
% Basic properties
%------------------------------------------------------%

% Obtain the identity update judgment on the top-most element of a given context

rec upd_top : (Ψ:ctx) {Δ:[Ψ ⊢ lctx N[]]} {X:[Ψ ⊢ obj]} {X':[Ψ ⊢ obj]}
  {A:[ ⊢ tp]} {A':[ ⊢ tp]} {α:[ ⊢ mult]} {α':[ ⊢ mult]}
  [Ψ ⊢ upd (cons Δ X A[] α[]) (suc N[]) X X' A[] A'[] α[] α'[]
    (cons Δ X' A'[] α'[])] =
  / total 1 /
  mlam _, _, _, _, _, _, _ ⇒ [_ ⊢ upd/t _]
  ;

rec upd_refl_top : (Ψ:ctx)
  {Δ:[Ψ ⊢ lctx N[]]} {X:[Ψ ⊢ obj]} {A:[ ⊢ tp]} {α:[ ⊢ mult]}
  [Ψ ⊢ upd (cons Δ X A[] α[]) (suc N[]) X X A[] A[] α[] α[] (cons Δ X A[] α[])] =
  / total 1 /
  mlam _, _, _, _ ⇒ [_ ⊢ upd/t _]
  ;

% If (x :α A) ∈ₙ Δ, obtain the result of changing the entry to (y :β B)

LF get_upd : lctx _ → nat → obj → obj → tp → tp → mult → mult → type =
  get-upd : upd Δ n X X' A A' α α' Δ' → get_upd Δ n X X' A A' α α';

rec lookup_getupd : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ n X X' A A' α α' Δ']
  → {Y:[Ψ ⊢ obj]} {B:[ ⊢ tp]} {β:[ ⊢ mult]} [Ψ ⊢ get_upd Δ n X Y A B[] α β[]] =
  / total 1 /
  fn u ⇒ mlam Y, B, β ⇒ case u of
  | [_ ⊢ upd/t _] ⇒ [_ ⊢ get-upd (upd/t _)]
  | [_ ⊢ upd/n U1] ⇒
    let [_ ⊢ get-upd U2] = lookup_getupd [_ ⊢ U1] [_ ⊢ Y] [ ⊢ B] [ ⊢ β] in
    [_ ⊢ get-upd (upd/n U2)]
  ;

%------------------------------------------------------%
% Context size
%------------------------------------------------------%

% If n ∈ Δ then 0 < n < |Δ| + 1

rec lookup_is_suc : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ n[] X X' A A' α α' Δ']
  → [ ⊢ is_suc n] =
  / total 1 /
  fn u ⇒ case u of
  | [_ ⊢ upd/t _] ⇒ [ ⊢ is-suc]
  | [_ ⊢ upd/n U1] ⇒ lookup_is_suc [_ ⊢ U1]
  ;

rec len_upd_lt : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ n[] X X' A A' α α' Δ']
  → [ ⊢ lt n (suc N)] =
  / total 1 /
  fn u ⇒ case u of
  | [_ ⊢ upd/t _] ⇒ lt_suc [ ⊢ _]
  | [_ ⊢ upd/n U1] ⇒ lt_trans (len_upd_lt [_ ⊢ U1]) (lt_suc [ ⊢ _])
  ;

% Practical corollary: A context of length n cannot have an entry at position
% n + 1

rec len_upd_contra : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ (suc N[]) X X' A A' α α' Δ']
  → [ ⊢ false] =
  / total 1 /
  fn u ⇒ impossible lt_irreflex (len_upd_lt u)
  ;

%------------------------------------------------------%
% Look-up properties
%------------------------------------------------------%

% One cannot update a name not bound in the context

rec upd_contra : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ,x:obj ⊢ upd Δ[..] n x X A₁ A₂ α₁ α₂ Δ']
  → [ ⊢ false] =
  / total 1 /
  fn u ⇒ let [_,x:obj ⊢ upd/n U1] = u in upd_contra [_,x:obj ⊢ U1]
  ;

% Corollary: If (Δ, x :α A)[x :α' A' ↦ y :β B] = Δ' and x is not bound in Δ,
% then A' = A, α' = α, and Δ' = (Δ, y :β B)

LF upd_istop : upd _ _ _ _ _ _ _ _ _ → type =
| upd-istop : {U:upd (cons Δ X A α) n X X' A A' α α' (cons Δ X' A' α')}
  upd_istop U;

rec upd_var_istop : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  {U:[Ψ,x:obj ⊢ upd (cons Δ[..] x A[] α[]) n[] x Y A'[] B[] α'[] β[] Δ']}
  [Ψ,x:obj ⊢ upd_istop U] =
  / total 1 /
  mlam U ⇒ case [_ ⊢ U] of
  | [_,x:obj ⊢ upd/t _] ⇒ [_ ⊢ upd-istop _]
  | [_,x:obj ⊢ upd/n U1] ⇒ impossible upd_contra [_ ⊢ U1]
  ;

% Uniqueness of look-up (or left-uniqueness of update):
% If (x :α A), (x' :α' A') ∈ₙ Δ then x = x', α = α', and A = A'

LF obj_tp_mult_eq : obj → obj → tp → tp → mult → mult → type =
| obj-tp-mult-refl : obj_tp_mult_eq X X A A α α;

rec lookup_unique : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ n[] X Y A B α β Δ']
  → [Ψ ⊢ upd Δ n[] X' Y' A' B' α' β' Δ'']
  → [Ψ ⊢ obj_tp_mult_eq X X' A A' α α'] =
  / total 1 /
  fn u1, u2 ⇒ case u1 of
  | [_ ⊢ upd/t _] ⇒
    (case u2 of
    | [_ ⊢ upd/t _] ⇒ [_ ⊢ obj-tp-mult-refl]
    | [_ ⊢ upd/n U2'] ⇒ impossible len_upd_contra [_ ⊢ U2'])
  | [_ ⊢ upd/n U1'] ⇒
    (case u2 of
    | [_ ⊢ upd/t _] ⇒ impossible len_upd_contra [_ ⊢ U1']
    | [_ ⊢ upd/n U2'] ⇒ lookup_unique [_ ⊢ U1'] [_ ⊢ U2'])
  ;

rec lookup_neq_var2nat : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ n[] X X' A A' α α' Δ']
  → [Ψ ⊢ upd Δ m[] Y Y' B B' β β' Δ'']
  → ([Ψ ⊢ obj_eq X Y] → [ ⊢ false])
  → [ ⊢ neq n m] =
  / total 1 /
  fn u1, u2, n ⇒ case u1 of
  | [_ ⊢ upd/t _] ⇒
    (case u2 of
    | [_ ⊢ upd/t _] ⇒ impossible n [_ ⊢ obj/refl]
    | [_ ⊢ upd/n U2] ⇒
      let [ ⊢ LT] = len_upd_lt [_ ⊢ U2] in
      [ ⊢ neq/2 LT]
    )
  | [_ ⊢ upd/n U1] ⇒
    case u2 of
    | [_ ⊢ upd/t _] ⇒
      let [ ⊢ LT] = len_upd_lt [_ ⊢ U1] in
      [ ⊢ neq/1 LT]
    | [_ ⊢ upd/n U2] ⇒ lookup_neq_var2nat [_ ⊢ U1] [_ ⊢ U2] n
  ;

%------------------------------------------------------%
% Algebraic properties
%------------------------------------------------------%

% Functionality (or right-uniqueness):
% If Δ[x :α A ↦ₙ y :β B] = Δ' and Δ[x :α A ↦ₙ y :β B] = Δ'', then Δ' = Δ''

rec upd_func : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ n X Y A B α β Δ']
  → [Ψ ⊢ upd Δ n X Y A B α β Δ'']
  → [Ψ ⊢ ctx_eq Δ' Δ''] =
  / total 1 /
  fn u1, u2 ⇒ case u1 of
  | [_ ⊢ upd/t _] ⇒
    (case u2 of
    | [_ ⊢ upd/t _] ⇒ [_ ⊢ ctx/refl]
    | [_ ⊢ upd/n U2'] ⇒ impossible len_upd_contra [_ ⊢ U2']
    )
  | [_ ⊢ upd/n U1'] ⇒
    (case u2 of
    | [_ ⊢ upd/t _] ⇒ impossible len_upd_contra [_ ⊢ U1']
    | [_ ⊢ upd/n U2'] ⇒
      let [_ ⊢ ctx/refl] = upd_func [_ ⊢ U1'] [_ ⊢ U2'] in
      [_ ⊢ ctx/refl]
    )
  ;

% Reflexivity: Δ[x :α A ↦ x :α A] = Δ

rec upd_refl : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ n X X' A A' α α' Δ']
  → [Ψ ⊢ upd Δ n X X A A α α Δ] =
  / total 1 /
  fn u ⇒ case u of
  | [_ ⊢ upd/t _] ⇒ [_ ⊢ upd/t _]
  | [_ ⊢ upd/n U] ⇒ let [_ ⊢ U1] = upd_refl [_ ⊢ U] in [_ ⊢ upd/n U1]
  ;

rec upd_refl_cor : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ n X X A A α α Δ']
  → [Ψ ⊢ ctx_eq Δ' Δ] =
  / total 1 /
  fn u ⇒ upd_func u (upd_refl u)
  ;

% Symmetry: If Δ[x :α A ↦ₙ y :β B] = Δ', then Δ'[y :β B ↦ₙ x :α A] = Δ

rec upd_symm : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ n X X' A A' α α' Δ']
  → [Ψ ⊢ upd Δ' n X' X A' A α' α Δ] =
  / total 1 /
  fn u ⇒ case u of
  | [_ ⊢ upd/t _] ⇒ [_ ⊢ upd/t _]
  | [_ ⊢ upd/n U1] ⇒ let [_ ⊢ U2] = upd_symm [_ ⊢ U1] in [_ ⊢ upd/n U2]
  ;

% Transitivity:
% Δ[x₁ :α₁ A₁ ↦ₙ x₂ :α₂ A₂][x₂ :α₂ A₂ ↦ₙ x₃ :α₃ A₃] =
% Δ[x₁ :α₁ A₁ ↦ₙ x₃ :α₃ A₃]

rec upd_trans : (Ψ:ctx) (Δ₁:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ₁ n X₁ X₂ A₁ A₂ α₁ α₂ Δ₂]
  → [Ψ ⊢ upd Δ₂ n X₂' X₃ A₂' A₃ α₂' α₃ Δ₃]
  → [Ψ ⊢ upd Δ₁ n X₁ X₃ A₁ A₃ α₁ α₃ Δ₃] =
  / total 1 /
  fn u1, u2 ⇒ case u1 of
  | [_ ⊢ upd/t _] ⇒
    (case u2 of
    | [_ ⊢ upd/t _] ⇒ [_ ⊢ upd/t _]
    | [_ ⊢ upd/n U2'] ⇒ impossible len_upd_contra [_ ⊢ U2'])
  | [_ ⊢ upd/n U1'] ⇒
    case u2 of
    | [_ ⊢ upd/t _] ⇒ impossible len_upd_contra (upd_symm [_ ⊢ U1'])
    | [_ ⊢ upd/n U2'] ⇒ let [_ ⊢ U3] = upd_trans [_ ⊢ U1'] [_ ⊢ U2'] in
      [_ ⊢ upd/n U3]
  ;

% Confluence (equality of the endpoints of two supplied update paths):
% Suppose Δ₁ updates at n to Δ₂ and then at m to Δ₃, while Δ₁ updates at m to
% Δ₂' and then at n to Δ₃', using the same old/new entries at each position.
% Given all four update derivations, Δ₃ = Δ₃'. Since the positions n and m are
% given and updating is deterministic at a position (upd_func), no
% well-formedness premise is needed and n and m need not be distinct.

rec upd_conf : (Ψ:ctx) (Δ₁:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ₁ n[] X₁ X₂ A₁[] A₂[] α₁[] α₂[] Δ₂]
  → [Ψ ⊢ upd Δ₂ m[] Y₁ Y₂ B₁[] B₂[] β₁[] β₂[] Δ₃]
  → [Ψ ⊢ upd Δ₁ m[] Y₁ Y₂ B₁[] B₂[] β₁[] β₂[] Δ₂']
  → [Ψ ⊢ upd Δ₂' n[] X₁ X₂ A₁[] A₂[] α₁[] α₂[] Δ₃']
  → [Ψ ⊢ ctx_eq Δ₃ Δ₃'] =
  / total 1 /
  fn U1, U2, U3, U4 ⇒ case U1 of
  | [_ ⊢ upd/t _] ⇒
    (case U2 of
    | [_ ⊢ upd/t _] ⇒
      (case U3 of
      | [_ ⊢ upd/t _] ⇒
        (case U4 of
        | [_ ⊢ upd/t _] ⇒ [_ ⊢ ctx/refl]
        | [_ ⊢ upd/n U4'] ⇒ impossible len_upd_contra [_ ⊢ U4']
        )
      | [_ ⊢ upd/n U3'] ⇒ impossible len_upd_contra [_ ⊢ U3']
      )
    | [_ ⊢ upd/n U2'] ⇒
      (case U3 of
      | [_ ⊢ upd/t _] ⇒ impossible len_upd_contra [_ ⊢ U2']
      | [_ ⊢ upd/n U3'] ⇒
        (case U4 of
        | [_ ⊢ upd/t _] ⇒
          let [_ ⊢ ctx/refl] = upd_func [_ ⊢ U2'] [_ ⊢ U3'] in
          [_ ⊢ ctx/refl]
        | [_ ⊢ upd/n U4'] ⇒ impossible len_upd_contra [_ ⊢ U4']
        )
      )
    )
  | [_ ⊢ upd/n U1'] ⇒
    (case U2 of
    | [_ ⊢ upd/t _] ⇒
      (case U3 of
      | [_ ⊢ upd/t _] ⇒
        (case U4 of
        | [_ ⊢ upd/t _] ⇒ impossible len_upd_contra [_ ⊢ U1']
        | [_ ⊢ upd/n U4'] ⇒
          let [_ ⊢ ctx/refl] = upd_func [_ ⊢ U1'] [_ ⊢ U4'] in
          [_ ⊢ ctx/refl]
        )
      | [_ ⊢ upd/n U3'] ⇒ impossible len_upd_contra [_ ⊢ U3']
      )
    | [_ ⊢ upd/n U2'] ⇒
      (case U3 of
      | [_ ⊢ upd/t _] ⇒ impossible len_upd_contra [_ ⊢ U2']
      | [_ ⊢ upd/n U3'] ⇒
        (case U4 of
        | [_ ⊢ upd/t _] ⇒ impossible len_upd_contra [_ ⊢ U1']
        | [_ ⊢ upd/n U4'] ⇒
          let [_ ⊢ ctx/refl] =
            upd_conf [_ ⊢ U1'] [_ ⊢ U2'] [_ ⊢ U3'] [_ ⊢ U4'] in
          [_ ⊢ ctx/refl]
        )
      )
    )
  ;

%------------------------------------------------------%
% Look-up properties II
%------------------------------------------------------%

% Preservation of look-up under update:
% If (x :α A) ∈ₙ Δ, (y :β B) ∈ₘ Δ and n ≠ m, then
% (x :α A) ∈ₙ Δ[y :β B ↦ₘ y' :β' B'] for any y',B',β'

rec lookup_upd : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ n[] Y Y' B B' β β' Δ']
  → [Ψ ⊢ upd Δ m[] X X' A A' α α' Δ'']
  → [ ⊢ neq n m]
  → [Ψ ⊢ lookup_intm m[] X A α Δ'] =
  / total 1 /
  fn u1, u2, n ⇒
  case u1 of
  | [_ ⊢ upd/t _] ⇒
    (case u2 of
    | [_ ⊢ upd/t _] ⇒ impossible neq_irreflex n
    | [_ ⊢ upd/n U2'] ⇒ let [_ ⊢ U3] = upd_refl [_ ⊢ U2'] in
      [_ ⊢ lookintm (upd/n U3)])
  | [_ ⊢ upd/n U1']:[_ ⊢ upd _ _ _ _ _ _ _ _ (cons Δ' _ _ _)] ⇒
    case u2 of
    | [_ ⊢ upd/t _]:[_ ⊢ upd _ _ Y _ B[] _ β[] _ _] ⇒
      let [_ ⊢ U3] = upd_refl_top [_ ⊢ Δ'] [_ ⊢ Y] [ ⊢ B] [ ⊢ β] in
      [_ ⊢ lookintm U3]
    | [_ ⊢ upd/n U2'] ⇒
      let [_ ⊢ lookintm U3] = lookup_upd [_ ⊢ U1'] [_ ⊢ U2'] n in
      [_ ⊢ lookintm (upd/n U3)]
  ;

%------------------------------------------------------%
% Corollaries of algebraic properties
%------------------------------------------------------%

% Practical corollaries:
% (1) If Δ[x₁ :α₁ A₁ ↦ₙ x₂ :α₂ A₂][y₁ :β₁ B₁ ↦ₘ y₂ :β₂ B₂] = Δ' and n ≠ m, then
%     Δ[y₁ :β₁ B₁ ↦ₘ y₂ :β₂ B₂] = Δ'' and Δ''[x₁ :α₁ A₁ ↦ₙ x₂ :α₂ A₂] = Δ'
%     for some Δ''
% (2) If Δ[x₁ :α₁ A₁ ↦ₙ x₂ :α₂ A₂] = Δ', Δ[y₁ :β₁ B₁ ↦ₘ y₂ :β₂ B₂] = Δ'', and
%     n ≠ m, then
%     Δ'[y₁ :β₁ B₁ ↦ₘ y₂ :β₂ B₂] = Δ''' and Δ''[x₁ :α₁ A₁ ↦ₙ x₂ :α₂ A₂] = Δ'''
%     for some Δ'''

LF upd_changeorder_res : upd _ _ _ _ _ _ _ _ Δ → upd Δ _ _ _ _ _ _ _ _ → type =
  | upd-changeorder : upd Δ₁ m Y Y' B B' β β' Δ₂' → upd Δ₂' n X X' A A' α α' Δ₃
  → {U1:upd Δ₁ n X X' A A' α α' Δ₂} {U2:upd Δ₂ m Y Y' B B' β β' Δ₃}
      upd_changeorder_res U1 U2;

rec upd_changeorder : (Ψ:ctx) (Δ₁:[Ψ ⊢ lctx N[]])
  {U1:[Ψ ⊢ upd Δ₁ n[] X X' A[] A'[] α[] α'[] Δ₂]}
  {U2:[Ψ ⊢ upd Δ₂ m[] Y Y' B[] B'[] β[] β'[] Δ₃]}
  [ ⊢ neq n m]
  → [Ψ ⊢ upd_changeorder_res U1 U2] =
  / total 1 /
  mlam U1, U2 ⇒ fn n ⇒
  let [_ ⊢ _]:[_ ⊢ upd _ _ _ X' _ A'[] _ α'[] _] = [_ ⊢ U1] in
  let [_ ⊢ _]:[_ ⊢ upd _ _ _ Y' _ B'[] _ β'[] _] = [_ ⊢ U2] in
  let [_ ⊢ lookintm U3'] = lookup_upd (upd_symm [_ ⊢ U1]) [_ ⊢ U2] n in
  let [_ ⊢ get-upd U3] = lookup_getupd [_ ⊢ U3'] [_ ⊢ Y'] [ ⊢ B'] [ ⊢ β'] in
  let [_ ⊢ lookintm U4'] = lookup_upd [_ ⊢ U3] [_ ⊢ U1] (neq_comm n) in
  let [_ ⊢ get-upd U4] = lookup_getupd [_ ⊢ U4'] [_ ⊢ X'] [ ⊢ A'] [ ⊢ α'] in
  let [_ ⊢ ctx/refl] = upd_conf [_ ⊢ U1] [_ ⊢ U2] [_ ⊢ U3] [_ ⊢ U4] in
  [_ ⊢ upd-changeorder U3 U4 _ _]
  ;

LF upd_pushout_res : upd Δ _ _ _ _ _ _ _ _ → upd Δ _ _ _ _ _ _ _ _ → type =
  | upd-pushout : upd Δ₂ m Y Y' B B' β β' Δ₃ → upd Δ₂' n X X' A A' α α' Δ₃
  → {U1:upd Δ₁ n X X' A A' α α' Δ₂} {U2:upd Δ₁ m Y Y' B B' β β' Δ₂'}
      upd_pushout_res U1 U2;

rec upd_pushout : (Ψ:ctx) (Δ₁:[Ψ ⊢ lctx N[]])
  {U1:[Ψ ⊢ upd Δ₁ n[] X X' A[] A'[] α[] α'[] Δ₂]}
  {U2:[Ψ ⊢ upd Δ₁ m[] Y Y' B[] B'[] β[] β'[] Δ₂']}
  [ ⊢ neq n m]
  → [Ψ ⊢ upd_pushout_res U1 U2] =
  / total 1 /
  mlam U1, U2 ⇒ fn n ⇒
  let [_ ⊢ U1_sym] = upd_symm [_ ⊢ U1] in
  let [_ ⊢ upd-changeorder U3 U4_sym _ _] =
    upd_changeorder [_ ⊢ U1_sym] [_ ⊢ U2] n in
  let [_ ⊢ U4] = upd_symm [_ ⊢ U4_sym] in
  [_ ⊢ upd-pushout U3 U4 _ _]
  ;

%------------------------------------------------------%
% Corollaries of look-up properties
%------------------------------------------------------%

% Corollaries:
% (1) If (x :α A) ∈ₙ Δ, then x ∈ₙ Δ[y :β B ↦ₘ y :β' B']
% (2) If (x :α A) ∈ₙ Δ, then (x :α' A) ∈ₙ Δ[y :β B ↦ₘ y :β' B] for some α'

rec lookup_upd_tpmult : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ m Y Y B B' β β' Δ']
  → [Ψ ⊢ upd Δ n X X' A A' α α' Δ'']
  → [Ψ ⊢ lookup_in n X Δ'] =
  / total 1 /
  fn u1, u2 ⇒
  let [_ ⊢ U1_symm]:[_ ⊢ upd _ n _ _ A A' α α' _] = upd_symm u1 in
  let [_ ⊢ _]:[_ ⊢ upd _ m _ _ B B' β β' _] = u2 in
  let [_ ⊢ n[]] = [_ ⊢ n] in let [_ ⊢ m[]] = [_ ⊢ m] in
  let [_ ⊢ A[]] = [_ ⊢ A] in let [_ ⊢ A'[]] = [_ ⊢ A'] in
  let [_ ⊢ α[]] = [_ ⊢ α] in let [_ ⊢ α'[]] = [_ ⊢ α'] in
  case comp_nats [ ⊢ n] [ ⊢ m] of
  | [ ⊢ comp_nats/eq] ⇒
    let [_ ⊢ obj-tp-mult-refl] = lookup_unique u1 u2 in
    let [_ ⊢ U2] = upd_refl [_ ⊢ U1_symm] in
    [_ ⊢ lookin U2]
  | [ ⊢ comp_nats/neq NEQ] ⇒
    let [_ ⊢ lookintm U3] = lookup_upd u1 u2 [ ⊢ NEQ] in
    [_ ⊢ lookin U3]
  ;

rec lookup_upd_mult : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ upd Δ m Y Y B B β β' Δ']
  → [Ψ ⊢ upd Δ n X X' A A' α α' Δ'']
  → [Ψ ⊢ lookup_int n X A Δ'] =
  / total 1 /
  fn u1, u2 ⇒
  let [_ ⊢ U1_symm]:[_ ⊢ upd _ n _ _ A A' α α' _] = upd_symm u1 in
  let [_ ⊢ _]:[_ ⊢ upd _ m _ _ B B' β β' _] = u2 in
  let [_ ⊢ n[]] = [_ ⊢ n] in let [_ ⊢ m[]] = [_ ⊢ m] in
  let [_ ⊢ A[]] = [_ ⊢ A] in let [_ ⊢ A'[]] = [_ ⊢ A'] in
  let [_ ⊢ α[]] = [_ ⊢ α] in let [_ ⊢ α'[]] = [_ ⊢ α'] in
  case comp_nats [ ⊢ n] [ ⊢ m] of
  | [ ⊢ comp_nats/eq] ⇒
    let [_ ⊢ obj-tp-mult-refl] = lookup_unique u1 u2 in
    let [_ ⊢ U2] = upd_refl [_ ⊢ U1_symm] in
    [_ ⊢ lookint U2]
  | [ ⊢ comp_nats/neq NEQ] ⇒
    let [_ ⊢ lookintm U3] = lookup_upd u1 u2 [ ⊢ NEQ] in
    [_ ⊢ lookint U3]
  ;

% Compare two update judgments: either they are updating the same location or
% not

LF comp_look_res : upd _ _ _ _ _ _ _ _ _ → upd _ _ _ _ _ _ _ _ _ → type =
  | look-eq : {U1:upd _ n X _ A _ α _ _} {U2:upd _ n X _ A _ α _ _}
    comp_look_res U1 U2
  | look-neq : neq n m
  → {U1:upd _ n _ _ _ _ _ _ _} {U2:upd _ m _ _ _ _ _ _ _} comp_look_res U1 U2
  ;

rec comp_look : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  {U1:[Ψ ⊢ upd Δ n[] X X' A[] A'[] α[] α'[] Δ']}
  {U2:[Ψ ⊢ upd Δ m[] Y Y' B[] B'[] β[] β'[] Δ'']}
  [Ψ ⊢ comp_look_res U1 U2] =
  / total 1 /
  mlam U1, U2 ⇒
  let [_ ⊢ _]:[_ ⊢ upd _ n[] _ _ _ _ _ _ _] = [_ ⊢ U1] in
  let [_ ⊢ _]:[_ ⊢ upd _ m[] _ _ _ _ _ _ _] = [_ ⊢ U2] in
  case comp_nats [ ⊢ n] [ ⊢ m] of
  | [ ⊢ comp_nats/eq] ⇒
    let [_ ⊢ obj-tp-mult-refl] = lookup_unique [_ ⊢ U1] [_ ⊢ U2] in
    [_ ⊢ look-eq _ _]
  | [ ⊢ comp_nats/neq NEQ] ⇒ [_ ⊢ look-neq NEQ[] _ _]
  ;
