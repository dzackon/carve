%======================================================%
% Generic properties of multiplicities
%======================================================%

% Identity: If α₁ • α₂ = α and α₁ is an identity element, then α₂ = α

rec mult_id_gen : Ident [ ⊢ α₁] → [ ⊢ • α₁ α₂ α] → [ ⊢ mult_eq α₂ α] =
  / total /
  fn i, m ⇒ let Is-Id f = i in f [ ⊢ _] [ ⊢ _] m
  ;

% Corollary for harmless elements:
% If α₁ • α₂ = α and α₁ is harmless, then α₂ = α

rec mult_id_hal : HalIdent → [ ⊢ hal α₁] → [ ⊢ • α₁ α₂ α]
                → [ ⊢ mult_eq α₂ α] =
  / total /
  fn hi, h, m ⇒ let Hal-Ident f = hi in mult_id_gen (f [ ⊢ _] h) m
  ;

% Totality: For any α₁, α₂, there exists an α such that α₁ • α₂ = α

rec mult_total_gen : Total → {α₁:[ ⊢ mult]} {α₂:[ ⊢ mult]}
                     [ ⊢ get_mult α₁ α₂] =
  / total /
  fn t ⇒ mlam α₁, α₂ ⇒ let Is-Total f = t in f [ ⊢ α₁] [ ⊢ α₂]
  ;

% Cancellativity: If α₁ • α₂ = α and α₁ • α₂' = α, then α₂ = α₂'

rec mult_canc_gen : Cancl → [ ⊢ • α₁ α₂ α] → [ ⊢ • α₁ α₂' α]
                  → [ ⊢ mult_eq α₂ α₂'] =
  / total /
  fn c, m1, m2 ⇒
  let Is-Cancl f = c in f [ ⊢ _] [ ⊢ _] [ ⊢ _] [ ⊢ _] m1 m2
  ;

% Zero-sum-freedom: If α₁ • α₂ = α and α is harmless, then α₁ = α

rec mult_zsfree_gen : ZsFree → [ ⊢ • α₁ α₂ α] → [ ⊢ hal α]
                    → [ ⊢ mult_eq α₁ α] =
  / total /
  fn z, m, h ⇒ let Is-ZsFree f = z in f [ ⊢ _] [ ⊢ _] [ ⊢ _] m h
  ;

% Idempotence of harmless elements: If α is harmless, then α • α = α

rec mult_halidem_gen : HalIdem → [ ⊢ hal α] → [ ⊢ • α α α] =
  / total /
  fn hi, h ⇒ let Is-HalIdem f = hi in f [ ⊢ _] h
  ;
