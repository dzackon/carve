%======================================================%
% Multiplicities (strict systems)
%======================================================%

LF mult : type =
| 𝟙 : mult  % must be used at least once
| ω : mult; % available unrestrictedly

% α₁ • α₂ = α

LF • : mult → mult → mult → type =
| •/1ω : • 𝟙 ω 𝟙
| •/ω1 : • ω 𝟙 𝟙
| •/ωω : • ω ω ω;

% α is harmless

LF hal : mult → type =
| hal/ω : hal ω;
