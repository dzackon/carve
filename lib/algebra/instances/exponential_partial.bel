%======================================================%
% Multiplicities
% (linear systems with exponentials)
%======================================================%

LF mult : type =
| 𝟘 : mult  % used
| 𝟙 : mult  % available linearly
| ω : mult; % available unrestrictedly

% α₁ • α₂ = α

LF • : mult → mult → mult → type =
| •/00 : • 𝟘 𝟘 𝟘
| •/01 : • 𝟘 𝟙 𝟙
| •/10 : • 𝟙 𝟘 𝟙
| •/ωω : • ω ω ω;

% α is harmless

LF hal : mult → type =
| hal/0 : hal 𝟘
| hal/ω : hal ω;
