%======================================================%
% Lemmas
%======================================================%

%------------------------------------------------------%
% Structural properties of typing judgment
%------------------------------------------------------%

% Exchange lemma:
% If Δ ⊢ M : A and Δ[(n, x) ↔ (m, y)] = Δ', then Δ' ⊢ M : A

rec oft_exch : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft Δ M C]
  → [Ψ ⊢ exch Δ n X m Y Δ']
  → [Ψ ⊢ oft Δ' M C] =
  / total 1 /
  fn d, ex1 ⇒
  let [_ ⊢ exch/u NEQ[] U1 U2] = ex1 in
  case d of
  | [_ ⊢ oft/var U3 E1] ⇒
    let [_ ⊢ exch-upd EX1' EX2' U4 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ U1] [_ ⊢ U2] [_ ⊢ U3] in
    let [_ ⊢ E2] = exch_exh [_ ⊢ E1] [_ ⊢ exch/u NEQ[] EX1' EX2'] in
    [_ ⊢ oft/var U4 E2]
  | [_ ⊢ oft/vari U3 E1] ⇒
    let [_ ⊢ U3'] = upd_refl [_ ⊢ U3] in
    let [_ ⊢ exch-upd EX1' EX2' U4 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ U1] [_ ⊢ U2] [_ ⊢ U3'] in
    let [_ ⊢ E2] = exch_exh [_ ⊢ E1] [_ ⊢ exch/u NEQ[] EX1' EX2'] in
    let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U4] in
    [_ ⊢ oft/vari U4 E2]
  | [_ ⊢ oft/lam \x.D1] ⇒
    let [_,x:obj ⊢ D2] = oft_exch [_,x:obj ⊢ D1]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n U1[..]) (upd/n U2[..])] in
    [_ ⊢ oft/lam \x.D2]
  | [_ ⊢ oft/app D1 D2 M1] ⇒
    let [_ ⊢ exch-merge U1a U2a U1b U2b _ M2 _ _ _ _ _] =
      exch_merge [_ ⊢ U1] [_ ⊢ U2] [_ ⊢ M1] in
    let [_ ⊢ D1'] = oft_exch [_ ⊢ D1] [_ ⊢ exch/u NEQ[] U1a U2a] in
    let [_ ⊢ D2'] = oft_exch [_ ⊢ D2] [_ ⊢ exch/u NEQ[] U1b U2b] in
    [_ ⊢ oft/app D1' D2' M2]
  | [_ ⊢ oft/bang E1 D1] ⇒
    let [_ ⊢ E2] = exch_exh [_ ⊢ E1] ex1 in
    let [_ ⊢ D2] = oft_exch [_ ⊢ D1] ex1 in
    [_ ⊢ oft/bang E2 D2]
  | [_ ⊢ oft/letbang D1 (\x.D2) M1] ⇒
    let [_ ⊢ exch-merge U1a U2a U1b U2b _ M2 _ _ _ _ _] =
      exch_merge [_ ⊢ U1] [_ ⊢ U2] [_ ⊢ M1] in
    let [_ ⊢ D1'] = oft_exch [_ ⊢ D1] [_ ⊢ exch/u NEQ[] U1a U2a] in
    let [_,x:obj ⊢ D2'] = oft_exch [_,x:obj ⊢ D2]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n U1b[..]) (upd/n U2b[..])] in
    [_ ⊢ oft/letbang D1' (\x.D2') M2]
  ;

rec oft_exch_top : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft (cons (cons Δ X A[] α[]) Y B[] β[]) M C]
  → [Ψ ⊢ oft (cons (cons Δ Y B[] β[]) X A[] α[]) M C] =
  / total /
  fn oft1 ⇒ oft_exch oft1
    (exch_top [_ ⊢ _] [_ ⊢ _] [ ⊢ _] [ ⊢ _] [_ ⊢ _] [ ⊢ _] [ ⊢ _])
  ;

% Intuitionistic strengthening lemmas:
% (1) If Δ, x :⁰ A ⊢ M : C, then (1) M does not depend on x and (2) Δ ⊢ M : C
% (2) If Δ, x :ω A ⊢ M : C and x ∉ fv(M), then Δ ⊢ M : C

inductive StrTop: (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]]) {D:[Ψ ⊢ oft Δ M A[]]} ctype =
  | Str-Top : [Ψ ⊢ oft Δ M A[]]
  → {D:[Ψ,x:obj ⊢ oft (cons Δ[..] x B[] 𝟘) M[..] A[]]} StrTop [Ψ,x:obj ⊢ D]
  ;

rec oft_str_0 : {D:[Ψ,x:obj ⊢ oft (cons Δ[..] x B[] 𝟘) M A[]]}
  StrTop [Ψ,x:obj ⊢ D] =
  / total d (oft_str_0 d) /
  mlam D ⇒ case [_,x:obj ⊢ D] of
  | [_,x:obj ⊢ oft/var (upd/n U1) (exh/c E1 _)] ⇒
    let Prune-Upd [_ ⊢ U2] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1] in
    let [_ ⊢ E2] = prune_exh [_ ⊢ E1] in
    Str-Top [_ ⊢ oft/var U2 E2] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/vari (upd/n U1) (exh/c E1 _)] ⇒
    let [_,x:obj ⊢ U1'] = upd_refl [_,x:obj ⊢ U1] in
    let Prune-Upd [_ ⊢ U2] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1'] in
    let [_ ⊢ E2] = prune_exh [_,x:obj ⊢ E1] in
    Str-Top [_ ⊢ oft/vari U2 E2] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/lam \y.D1] ⇒
    let [_,x:obj,y:obj ⊢ D1'[..,y,x]] = oft_exch_top [_,x:obj,y:obj ⊢ D1] in
    let Str-Top [_,x:obj ⊢ D2] [_,x:obj,y:obj ⊢ _] =
      oft_str_0 [_,x:obj,y:obj ⊢ D1'] in
    Str-Top [_ ⊢ oft/lam \x.D2] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/app D1 D2 (mg/c M1 T[])] ⇒
    let [ ⊢ mult/refl] = mult_zsfree_cor [ ⊢ T] in
    let [ ⊢ mult/refl] = mult_zsfree_cor (mult_comm [ ⊢ T]) in
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1] in
    let Str-Top [_ ⊢ D1'] [_,x:obj ⊢ _] = oft_str_0 [_,x:obj ⊢ D1] in
    let Str-Top [_ ⊢ D2'] [_,x:obj ⊢ _] = oft_str_0 [_,x:obj ⊢ D2] in
    Str-Top [_ ⊢ oft/app D1' D2' M2] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/bang (exh/c E1 _) D1] ⇒
    let [_ ⊢ E2] = prune_exh [_,x:obj ⊢ E1] in
    let Str-Top [_ ⊢ D2] [_,x:obj ⊢ _] = oft_str_0 [_,x:obj ⊢ D1] in
    Str-Top [_ ⊢ oft/bang E2 D2] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/letbang D1 (\y.D2) (mg/c M1 T[])] ⇒
    let [ ⊢ mult/refl] = mult_zsfree_cor [ ⊢ T] in
    let [ ⊢ mult/refl] = mult_zsfree_cor (mult_comm [ ⊢ T]) in
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1] in
    let Str-Top [_ ⊢ D1'] [_,x:obj ⊢ _] = oft_str_0 [_,x:obj ⊢ D1] in
    let [_,x:obj,y:obj ⊢ D2''[..,y,x]] = oft_exch_top [_,x:obj,y:obj ⊢ D2] in
    let Str-Top [_,x:obj ⊢ D2'] [_,x:obj,y:obj ⊢ _] =
      oft_str_0 [_,x:obj,y:obj ⊢ D2''] in
    Str-Top [_ ⊢ oft/letbang D1' (\y.D2') M2] [_,x:obj ⊢ _]
  ;

rec oft_str_w : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ,x:obj ⊢ oft (cons Δ[..] x A[] ω) M[..] C[]]
  → [Ψ ⊢ oft Δ[..] M C[]] =
  / total d (oft_str_w d) /
  fn d ⇒ case d of
  | [_,x:obj ⊢ oft/var (upd/n U1) (exh/c E1 _)] ⇒
    let Prune-Upd [_ ⊢ U2] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1] in
    let [_ ⊢ E2] = prune_exh [_,x:obj ⊢ E1] in
    [_ ⊢ oft/var U2 E2]
  | [_,x:obj ⊢ oft/vari (upd/n U1) (exh/c E1 _)] ⇒
    let [_,x:obj ⊢ U1'] = upd_refl [_,x:obj ⊢ U1] in
    let Prune-Upd [_ ⊢ U2] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1'] in
    let [_ ⊢ E2] = prune_exh [_,x:obj ⊢ E1] in
    [_ ⊢ oft/vari U2 E2]
  | [_,x:obj ⊢ oft/lam \y.D1] ⇒
    let [_,x:obj,y:obj ⊢ D1'[..,y,x]] = oft_exch_top [_,x:obj,y:obj ⊢ D1] in
    let [_,x:obj ⊢ D2] = oft_str_w [_,x:obj,y:obj ⊢ D1'] in
    [_ ⊢ oft/lam \x.D2]
  | [_,x:obj ⊢ oft/app D1 D2 (mg/c M1 •/ωω)] ⇒
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1] in
    let [_ ⊢ D1'] = oft_str_w [_,x:obj ⊢ D1] in
    let [_ ⊢ D2'] = oft_str_w [_,x:obj ⊢ D2] in
    [_ ⊢ oft/app D1' D2' M2]
  | [_,x:obj ⊢ oft/bang (exh/c E1 _) D1] ⇒
    let [_ ⊢ E2] = prune_exh [_,x:obj ⊢ E1] in
    let [_ ⊢ D1'] = oft_str_w [_,x:obj ⊢ D1] in
    [_ ⊢ oft/bang E2 D1']
  | [_,x:obj ⊢ oft/letbang D1 (\y.D2) (mg/c M1 •/ωω)] ⇒
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1] in
    let [_ ⊢ D1'] = oft_str_w [_,x:obj ⊢ D1] in
    let [_,x:obj,y:obj ⊢ D2''[..,y,x]] = oft_exch_top [_,x:obj,y:obj ⊢ D2] in
    let [_,x:obj ⊢ D2'] = oft_str_w [_,x:obj,y:obj ⊢ D2''] in
    [_ ⊢ oft/letbang D1' (\x.D2') M2]
  ;

% Intuitionistic weakening lemmas:
% (1) If Δ ⊢ M : C and hal(α), then Δ, x :α A ⊢ M : C for any A
% (2) If Δ ⊢ M : C and hal(α), then Δ[x :⁰ A ↦ₙ y :α A'] ⊢ M : C for any y,A'

rec oft_weak : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft Δ M C[]]
  → {A:[ ⊢ tp]} [ ⊢ hal α]
  → [Ψ,x:obj ⊢ oft (cons Δ[..] x A[] α[]) M[..] C[]] =
  / total 1 /
  fn d ⇒ mlam A ⇒ fn u ⇒
  let [ ⊢ U] = u in
  let [ ⊢ T] = halidem_prf _ u in
  case d of
  | [_ ⊢ oft/var U1 E1] ⇒ [_ ⊢ oft/var (upd/n U1[..]) (exh/c E1[..] U[])]
  | [_ ⊢ oft/vari U1 E1] ⇒ [_ ⊢ oft/vari (upd/n U1[..]) (exh/c E1[..] U[])]
  | [_ ⊢ oft/lam \x.D1] ⇒
    let [_,x:obj,y:obj ⊢ D1'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ D1] [ ⊢ A] u) in
    [_,x:obj ⊢ oft/lam \y.D1'[..,y,x]]
  | [_ ⊢ oft/app D1 D2 M1] ⇒
    let [_,x:obj ⊢ D1'] = oft_weak [_ ⊢ D1] [ ⊢ A] u in
    let [_,x:obj ⊢ D2'] = oft_weak [_ ⊢ D2] [ ⊢ A] u in
    [_,x:obj ⊢ oft/app D1' D2' (mg/c M1[..] T[])]
  | [_ ⊢ oft/bang E1 D1] ⇒
    let [_,x:obj ⊢ D1'] = oft_weak [_ ⊢ D1] [ ⊢ A] u in
    [_,x:obj ⊢ oft/bang (exh/c E1[..] U[]) D1']
  | [_ ⊢ oft/letbang D1 (\x.D2) M1] ⇒
    let [_,x:obj ⊢ D1'] = oft_weak [_ ⊢ D1] [ ⊢ A] u in
    let [_,x:obj,y:obj ⊢ D2'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ D2] [ ⊢ A] u) in
    [_,x:obj ⊢ oft/letbang D1' (\y.D2'[..,y,x]) (mg/c M1[..] T[])]
  ;

rec oft_weak_upd : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft Δ M C[]]
  → [Ψ ⊢ upd Δ n[] X X' A[] A'[] 𝟘 α[] Δ']
  → [ ⊢ hal α]
  → [Ψ ⊢ oft Δ' M C[]] =
  / total 1 /
  fn d, u, un ⇒
  let [_ ⊢ U] = u in
  let [ ⊢ get-hal-split UN1 UN2 T1] = mult_get_hal un in
  case d of
  | [_ ⊢ oft/var U1 E1] ⇒
    let [_ ⊢ look-neq N[] _ _] = comp_look [_ ⊢ U] [_ ⊢ U1] in
    let [_ ⊢ upd-pushout U2 U3 _ _] = upd_pushout [_ ⊢ U] [_ ⊢ U1] [ ⊢ N] in
    let [_ ⊢ E2] = exh_upd_hal [_ ⊢ E1] un [_ ⊢ U3] in
    [_ ⊢ oft/var U2 E2]
  | [_ ⊢ oft/vari U1 E1] ⇒
    let [_ ⊢ look-neq N[] _ _] = comp_look [_ ⊢ U] [_ ⊢ U1] in
    let [_ ⊢ lookintm U2] = lookup_upd u [_ ⊢ U1] [ ⊢ N] in
    let [_ ⊢ E2] = exh_upd_hal [_ ⊢ E1] un u in
    [_ ⊢ oft/vari U2 E2]
  | [_ ⊢ oft/lam \x.D1] ⇒
    let [_,x:obj ⊢ D2] =
      oft_weak_upd [_,x:obj ⊢ D1] [_,x:obj ⊢ upd/n U[..]] un in
    [_ ⊢ oft/lam \x.D2]
  | [_ ⊢ oft/app D1 D2 M1] ⇒
    let [_ ⊢ merge-upd U1 U2 T2[] M2 _ _ _] =
      merge_upd_cor [_ ⊢ U] [_ ⊢ M1] [ ⊢ T1] in
    let [ ⊢ mult/refl] = mult_zsfree_cor [ ⊢ T2] in
    let [ ⊢ mult/refl] = mult_zsfree_cor (mult_comm [ ⊢ T2]) in
    let [_ ⊢ D1'] = oft_weak_upd [_ ⊢ D1] [_ ⊢ U1] [ ⊢ UN1] in
    let [_ ⊢ D2'] = oft_weak_upd [_ ⊢ D2] [_ ⊢ U2] [ ⊢ UN2] in
    [_ ⊢ oft/app D1' D2' M2]
  | [_ ⊢ oft/bang E1 D1] ⇒
    let [_ ⊢ E2] = exh_upd_hal [_ ⊢ E1] un u in
    let [_ ⊢ D2] = oft_weak_upd [_ ⊢ D1] u un in
    [_ ⊢ oft/bang E2 D2]
  | [_ ⊢ oft/letbang D1 (\x.D2) M1] ⇒
    let [_ ⊢ merge-upd U1 U2 T2[] M2 _ _ _] =
      merge_upd_cor [_ ⊢ U] [_ ⊢ M1] [ ⊢ T1] in
    let [ ⊢ mult/refl] = mult_zsfree_cor [ ⊢ T2] in
    let [ ⊢ mult/refl] = mult_zsfree_cor (mult_comm [ ⊢ T2]) in
    let [_ ⊢ D1'] = oft_weak_upd [_ ⊢ D1] [_ ⊢ U1] [ ⊢ UN1] in
    let [_,x:obj ⊢ D2'] =
      oft_weak_upd [_,x:obj ⊢ D2] [_,x:obj ⊢ upd/n U2[..]] [ ⊢ UN2] in
    [_ ⊢ oft/letbang D1' (\x.D2') M2]
  ;

% Environment weakening lemma (dereliction): If Δ ⊢ M : C, then
% Δ[x :¹ A ↦ x :ω A] ⊢ M : C

rec oft_weak_env : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft Δ M C[]]
  → [Ψ ⊢ upd Δ n[] X X A[] A[] 𝟙 ω Δ']
  → [Ψ ⊢ oft Δ' M C[]] =
  / total 1 /
  fn d, u ⇒
  let [_ ⊢ U] = u in
  case d of
  | [_ ⊢ oft/var U1 E1] ⇒
    (case comp_look [_ ⊢ U1] [_ ⊢ U] of
    | [_ ⊢ look-eq _ _] ⇒
      let [_ ⊢ U'] = upd_symm u in
      let [_ ⊢ E2] =
        exh_upd_hal [_ ⊢ E1] [ ⊢ hal/ω] (upd_trans (upd_symm [_ ⊢ U1]) u) in
      [_ ⊢ oft/vari U' E2]
    | [_ ⊢ look-neq N[] _ _] ⇒
      let [_ ⊢ lookintm U2] = lookup_upd [_ ⊢ U1] [_ ⊢ U] [ ⊢ N] in
      impossible exh_lookup [_ ⊢ E1] [_ ⊢ U2]
    )
  | [_ ⊢ oft/vari U1 E1] ⇒ impossible exh_lookup [_ ⊢ E1] u
  | [_ ⊢ oft/lam \x.D1] ⇒
    let [_,x:obj ⊢ D2] = oft_weak_env [_,x:obj ⊢ D1] [_,x:obj ⊢ upd/n U[..]] in
    [_ ⊢ oft/lam \x.D2]
  | [_ ⊢ oft/app D1 D2 M1] ⇒
    let [_ ⊢ merge-upd U1 U2 T1[] M2 _ _ _] =
      merge_upd_cor [_ ⊢ U] [_ ⊢ M1] [ ⊢ •/ωω] in
    (case [ ⊢ T1] of
    | [ ⊢ •/01] ⇒
      let [_ ⊢ D1'] = oft_weak_upd [_ ⊢ D1] [_ ⊢ U1] [ ⊢ hal/ω] in
      let [_ ⊢ D2'] = oft_weak_env [_ ⊢ D2] [_ ⊢ U2] in
      [_ ⊢ oft/app D1' D2' M2]
    | [ ⊢ •/10] ⇒
      let [_ ⊢ D1'] = oft_weak_env [_ ⊢ D1] [_ ⊢ U1] in
      let [_ ⊢ D2'] = oft_weak_upd [_ ⊢ D2] [_ ⊢ U2] [ ⊢ hal/ω] in
      [_ ⊢ oft/app D1' D2' M2]
    )
  | [_ ⊢ oft/bang E1 D1] ⇒ impossible exh_lookup [_ ⊢ E1] u
  | [_ ⊢ oft/letbang D1 (\x.D2) M1] ⇒
    let [_ ⊢ merge-upd U1 U2 T1[] M2 _ _ _] =
      merge_upd_cor [_ ⊢ U] [_ ⊢ M1] [ ⊢ •/ωω] in
    (case [ ⊢ T1] of
    | [ ⊢ •/01] ⇒
      let [_ ⊢ D1'] = oft_weak_upd [_ ⊢ D1] [_ ⊢ U1] [ ⊢ hal/ω] in
      let [_,x:obj ⊢ D2'] =
        oft_weak_env [_,x:obj ⊢ D2] [_,x:obj ⊢ upd/n U2[..]] in
      [_ ⊢ oft/letbang D1' (\x.D2') M2]
    | [ ⊢ •/10] ⇒
      let [_ ⊢ D1'] = oft_weak_env [_ ⊢ D1] [_ ⊢ U1] in
      let [_,x:obj ⊢ D2'] =
        oft_weak_upd [_,x:obj ⊢ D2] [_,x:obj ⊢ upd/n U2[..]] [ ⊢ hal/ω] in
      [_ ⊢ oft/letbang D1' (\x.D2') M2]
    )
  ;

%------------------------------------------------------%
% Main lemmas
%------------------------------------------------------%

% Substitution lemmas:
% (1) Linear cut: If (a) Δ₁, x :¹ A ⊢ M : C, (b) Δ₂ ⊢ N : A, and (c) Δ₁ ⋈ Δ₂ =
% Δ, then Δ ⊢ [N/x]M : C
% (2) Intuitionistic cut:  If (a) Δ₁, x :ω A ⊢ M : C, (b) Δ₂ ⊢ N : A, (c)
% exh(Δ₂), and (d) Δ₁ ⋈ Δ₂ = Δ, then Δ ⊢ [N/x]M : C

rec sub_lem : (Ψ:ctx) (Δ:[Ψ ⊢ lctx k[]])
  [Ψ,x:obj ⊢ oft (cons Δ₁[..] x A[] 𝟙) M C[]]
  → [Ψ ⊢ oft Δ₂ N A[]]
  → [Ψ ⊢ merge Δ₁ Δ₂ Δ]
  → [Ψ ⊢ oft Δ M[..,N] C[]] =
  / total d (sub_lem d) /
  fn d1, d2, m ⇒
  let [_ ⊢ M] = m in
  case d1 of
  | [_,x:obj ⊢ oft/var U1 E1] ⇒
    (case [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ upd/t _] ⇒
      let [_,x:obj ⊢ exh/c E1' _] = [_,x:obj ⊢ E1] in
      let [_ ⊢ ctx/refl] =
        merge_id mult_halident m (prune_exh [_,x:obj ⊢ E1']) in
      d2
    | [_,x:obj ⊢ upd/n U2] ⇒ let [_,x:obj ⊢ exh/c _ UN[]] = [_,x:obj ⊢ E1] in
      impossible [ ⊢ UN]
    )
  | [_,x:obj ⊢ oft/vari (upd/n _) (exh/c _ UN[])] ⇒ impossible [ ⊢ UN]
  | [_,x:obj ⊢ oft/lam \y.D1] ⇒
    let [_,y:obj,x:obj ⊢ D1'[..,x,y]] = oft_exch_top [_,x:obj,y:obj ⊢ D1] in
    let [_,x:obj ⊢ D2] = sub_lem [_,x:obj,y:obj ⊢ D1']
      (oft_weak d2 [ ⊢ _] [ ⊢ hal/0]) [_,x:obj ⊢ mg/c M[..] •/10] in
    [_ ⊢ oft/lam \x.D2]
  | [_,x:obj ⊢ oft/app D1 D2 (mg/c M1 T[])] ⇒
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1] in
    (case [ ⊢ T] of
    | [ ⊢ •/01] ⇒
      let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2] in
      let Str-Top [_ ⊢ D1'] [_,x:obj ⊢ _] = oft_str_0 [_,x:obj ⊢ D1] in
      let [_ ⊢ D2'] = sub_lem [_,x:obj ⊢ D2] d2 [_ ⊢ M3] in
      [_ ⊢ oft/app D1' D2' M4]
    | [ ⊢ •/10] ⇒
      let [_ ⊢ M2_comm] = merge_comm [_ ⊢ M2] in
      let [_ ⊢ merge-assoc M3 M4_comm _ _] =
        merge_assoc [_ ⊢ M] [_ ⊢ M2_comm] in
      let [_ ⊢ M4] = merge_comm [_ ⊢ M4_comm] in
      let Str-Top [_ ⊢ D2'] [_,x:obj ⊢ _] = oft_str_0 [_,x:obj ⊢ D2] in
      let [_ ⊢ D1'] = sub_lem [_,x:obj ⊢ D1] d2 [_ ⊢ M3] in
      [_ ⊢ oft/app D1' D2' M4]
    )
  | [_,x:obj ⊢ oft/bang (exh/c _ UN[]) _] ⇒ impossible [ ⊢ UN]
  | [_,x:obj ⊢ oft/letbang D1 (\y.D2) (mg/c M1 T[])] ⇒
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1] in
    let [_,y:obj,x:obj ⊢ D2''[..,x,y]] = oft_exch_top [_,x:obj,y:obj ⊢ D2] in
    (case [ ⊢ T] of
    | [ ⊢ •/01] ⇒
      let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2] in
      let Str-Top [_ ⊢ D1'] [_,x:obj ⊢ _] = oft_str_0 [_,x:obj ⊢ D1] in
      let [_,x:obj ⊢ D2'] = sub_lem [_,x:obj,y:obj ⊢ D2'']
        (oft_weak d2 [ ⊢ _] [ ⊢ hal/ω]) [_,x:obj ⊢ mg/c M3[..] •/ωω] in
      [_ ⊢ oft/letbang D1' (\x.D2') M4]
    | [ ⊢ •/10] ⇒
      let [_ ⊢ M2_comm] = merge_comm [_ ⊢ M2] in
      let [_ ⊢ merge-assoc M3 M4_comm _ _] =
        merge_assoc [_ ⊢ M] [_ ⊢ M2_comm] in
      let [_ ⊢ M4] = merge_comm [_ ⊢ M4_comm] in
      let [_ ⊢ D1'] = sub_lem [_,x:obj ⊢ D1] d2 [_ ⊢ M3] in
      let Str-Top [_,x:obj ⊢ D2'] [_,x:obj,y:obj ⊢ _] =
        oft_str_0 [_,x:obj,y:obj ⊢ D2''] in
      [_ ⊢ oft/letbang D1' (\x.D2') M4]
    )
  ;

rec sub_lem_w : (Ψ:ctx) (Δ:[Ψ ⊢ lctx k[]])
  [Ψ,x:obj ⊢ oft (cons Δ₁[..] x A[] ω) M C[]]
  → [Ψ ⊢ oft Δ₂ N A[]]
  → [Ψ ⊢ exh Δ₂]
  → [Ψ ⊢ merge Δ₁ Δ₂ Δ]
  → [Ψ ⊢ oft Δ M[..,N] C[]] =
  / total d (sub_lem_w d) /
  fn d1, d2, e, m ⇒
  let [_ ⊢ M] = m in
  let [_ ⊢ E] = e in
  let [_ ⊢ ctx/refl] = merge_id mult_halident (merge_comm [_ ⊢ M]) e in
  case d1 of
  | [_,x:obj ⊢ oft/var (upd/n U1) (exh/c E1 _)] ⇒
    let Prune-Upd [_ ⊢ U2] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1] in
    let [_ ⊢ merge-upd2 U2a U2b •/10 M2 _ _ _] =
      merge_upd_cor_l [_ ⊢ U2] [_ ⊢ M] [ ⊢ •/00] in
    let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2a] in
    let [_ ⊢ ctx/refl] = merge_id mult_halident [_ ⊢ M2] (prune_exh [_ ⊢ E1]) in
    [_ ⊢ oft/var U2b E]
  | [_,x:obj ⊢ oft/vari U1 (exh/c E1 _)] ⇒
    let [_ ⊢ E2] = prune_exh [_ ⊢ E1] in
    (case [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ upd/t _] ⇒
      let [_ ⊢ ctx/refl] = merge_id mult_halident [_ ⊢ M] [_ ⊢ E2] in d2
    | [_,x:obj ⊢ upd/n U1'] ⇒
      let [_,x:obj ⊢ U1r] = upd_refl [_,x:obj ⊢ U1'] in
      let Prune-Upd [_ ⊢ U2] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1r] in
      [_ ⊢ oft/vari U2 E2]
    )
  | [_,x:obj ⊢ oft/lam \y.D1] ⇒
    let [_,y:obj,x:obj ⊢ D1'[..,x,y]] = oft_exch_top [_,x:obj,y:obj ⊢ D1] in
    let [_,x:obj ⊢ D2] = sub_lem_w [_,x:obj,y:obj ⊢ D1']
      (oft_weak d2 [ ⊢ _] [ ⊢ hal/0]) [_,x:obj ⊢ exh/c E[..] hal/0]
      [_,x:obj ⊢ mg/c M[..] •/10] in
    [_ ⊢ oft/lam \x.D2]
  | [_,x:obj ⊢ oft/app D1 D2 (mg/c M1 •/ωω)] ⇒
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1] in
    let [_ ⊢ M2_comm] = merge_comm [_ ⊢ M2] in
    let [_ ⊢ merge-assoc M3 _ _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2] in
    let [_ ⊢ merge-assoc M5 _ _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2_comm] in
    let [_ ⊢ ctx/refl] = merge_id mult_halident (merge_comm [_ ⊢ M5]) e in
    let [_ ⊢ ctx/refl] = merge_id mult_halident (merge_comm [_ ⊢ M3]) e in
    let [_ ⊢ D1'] = sub_lem_w [_,x:obj ⊢ D1] d2 e [_ ⊢ M5] in
    let [_ ⊢ D2'] = sub_lem_w [_,x:obj ⊢ D2] d2 e [_ ⊢ M3] in
    [_ ⊢ oft/app D1' D2' M2]
  | [_,x:obj ⊢ oft/bang (exh/c E1 _) D1] ⇒
    let [_ ⊢ E2] = prune_exh [_ ⊢ E1] in
    let [_ ⊢ D2] = sub_lem_w [_,x:obj ⊢ D1] d2 e m in
    [_ ⊢ oft/bang E2 D2]
  | [_,x:obj ⊢ oft/letbang D1 (\y.D2) (mg/c M1 •/ωω)] ⇒
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1] in
    let [_ ⊢ M2_comm] = merge_comm [_ ⊢ M2] in
    let [_ ⊢ merge-assoc M3 _ _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2] in
    let [_ ⊢ merge-assoc M5 _ _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2_comm] in
    let [_ ⊢ ctx/refl] = merge_id mult_halident (merge_comm [_ ⊢ M5]) e in
    let [_ ⊢ ctx/refl] = merge_id mult_halident (merge_comm [_ ⊢ M3]) e in
    let [_ ⊢ D1'] = sub_lem_w [_,x:obj ⊢ D1] d2 e [_ ⊢ M5] in
    let [_,y:obj,x:obj ⊢ D2''[..,x,y]] = oft_exch_top [_,x:obj,y:obj ⊢ D2] in
    let [_,x:obj ⊢ D2'] = sub_lem_w [_,x:obj,y:obj ⊢ D2'']
      (oft_weak d2 [ ⊢ _] [ ⊢ hal/ω]) [_,x:obj ⊢ exh/c E[..] hal/ω]
      [_,x:obj ⊢ mg/c M3[..] •/ωω] in
    [_ ⊢ oft/letbang D1' (\x.D2') M2]
  ;
