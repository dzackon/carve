%======================================================%
% Lemmas
%======================================================%

%------------------------------------------------------%
% Structural properties of typing judgment
%------------------------------------------------------%

% Pruning: if the context does not mention x, neither does the term nor the
% type of a typing derivation

inductive PruneOft : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  {D:[Ψ,x:obj ⊢ oft Δ[..] M A[]]} ctype =
| Prune-Oft : [Ψ ⊢ oft Δ M A[]]
  → {D:[Ψ,x:obj ⊢ oft Δ[..] M[..] A[]]} PruneOft [Ψ,x:obj ⊢ D];

rec prune_oft : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]]) {D:[Ψ,x:obj ⊢ oft Δ[..] M A[]]}
  PruneOft [Ψ,x:obj ⊢ D] =
  / total 1 /
  mlam D ⇒ case [_,x:obj ⊢ D] of
  | [_,x:obj ⊢ oft/var U E] ⇒
    let Prune-Upd [_ ⊢ U'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U] in
    let [_ ⊢ E'] = prune_exh [_,x:obj ⊢ E] in
    Prune-Oft [_ ⊢ oft/var U' E'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/vari U E] ⇒
    let [_,x:obj ⊢ U1] = upd_refl [_,x:obj ⊢ U] in
    let Prune-Upd [_ ⊢ U'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1] in
    let [_ ⊢ E'] = prune_exh [_,x:obj ⊢ E] in
    Prune-Oft [_ ⊢ oft/vari U' E'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/lam \y.D1[..,y,x]] ⇒
    let Prune-Oft [_,y:obj ⊢ D1'] [_,y:obj,x:obj ⊢ _] =
      prune_oft [_,y:obj,x:obj ⊢ D1] in
    Prune-Oft [_ ⊢ oft/lam \y.D1'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/app D1 D2 M1] ⇒
    let Prune-Merge [_ ⊢ M1'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1] in
    let Prune-Oft [_ ⊢ D1'] [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ D1] in
    let Prune-Oft [_ ⊢ D2'] [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ D2] in
    Prune-Oft [_ ⊢ oft/app D1' D2' M1'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/bang E D1] ⇒
    let [_ ⊢ E'] = prune_exh [_,x:obj ⊢ E] in
    let Prune-Oft [_ ⊢ D1'] [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ D1] in
    Prune-Oft [_ ⊢ oft/bang E' D1'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/letbang D1 (\y.D2[..,y,x]) M1] ⇒
    let Prune-Merge [_ ⊢ M1'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1] in
    let Prune-Oft [_ ⊢ D1'] [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ D1] in
    let Prune-Oft [_,y:obj ⊢ D2'] [_,y:obj,x:obj ⊢ _] =
      prune_oft [_,y:obj,x:obj ⊢ D2] in
    Prune-Oft [_ ⊢ oft/letbang D1' (\y.D2') M1'] [_,x:obj ⊢ _]
  ;

% Exchange lemma:
% If Δ ⊢ M : A and Δ[(n, x) ↔ (m, y)] = Δ', then Δ' ⊢ M : A

rec oft_exch : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft Δ M C]
  → [Ψ ⊢ exch Δ n X m Y Δ']
  → [Ψ ⊢ oft Δ' M C] =
  / total 1 /
  fn d, ex1 ⇒
  let [_ ⊢ exch/u NEQ[] U1 U2] = ex1 in
  case d of
  | [_ ⊢ oft/var U3 E1] ⇒
    let [_ ⊢ exch-upd EX1' EX2' U4 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ U1] [_ ⊢ U2] [_ ⊢ U3] in
    let [_ ⊢ E2] = exch_exh [_ ⊢ E1] [_ ⊢ exch/u NEQ[] EX1' EX2'] in
    [_ ⊢ oft/var U4 E2]
  | [_ ⊢ oft/vari U3 E1] ⇒
    let [_ ⊢ U3'] = upd_refl [_ ⊢ U3] in
    let [_ ⊢ exch-upd EX1' EX2' U4 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ U1] [_ ⊢ U2] [_ ⊢ U3'] in
    let [_ ⊢ E2] = exch_exh [_ ⊢ E1] [_ ⊢ exch/u NEQ[] EX1' EX2'] in
    let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U4] in
    [_ ⊢ oft/vari U4 E2]
  | [_ ⊢ oft/lam \x.D1] ⇒
    let [_,x:obj ⊢ D2] = oft_exch [_,x:obj ⊢ D1]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n U1[..]) (upd/n U2[..])] in
    [_ ⊢ oft/lam \x.D2]
  | [_ ⊢ oft/app D1 D2 M1] ⇒
    let [_ ⊢ exch-merge U1a U2a U1b U2b _ M2 _ _ _ _ _] =
      exch_merge [_ ⊢ U1] [_ ⊢ U2] [_ ⊢ M1] in
    let [_ ⊢ D1'] = oft_exch [_ ⊢ D1] [_ ⊢ exch/u NEQ[] U1a U2a] in
    let [_ ⊢ D2'] = oft_exch [_ ⊢ D2] [_ ⊢ exch/u NEQ[] U1b U2b] in
    [_ ⊢ oft/app D1' D2' M2]
  | [_ ⊢ oft/bang E1 D1] ⇒
    let [_ ⊢ E2] = exch_exh [_ ⊢ E1] ex1 in
    let [_ ⊢ D2] = oft_exch [_ ⊢ D1] ex1 in
    [_ ⊢ oft/bang E2 D2]
  | [_ ⊢ oft/letbang D1 (\x.D2) M1] ⇒
    let [_ ⊢ exch-merge U1a U2a U1b U2b _ M2 _ _ _ _ _] =
      exch_merge [_ ⊢ U1] [_ ⊢ U2] [_ ⊢ M1] in
    let [_ ⊢ D1'] = oft_exch [_ ⊢ D1] [_ ⊢ exch/u NEQ[] U1a U2a] in
    let [_,x:obj ⊢ D2'] = oft_exch [_,x:obj ⊢ D2]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n U1b[..]) (upd/n U2b[..])] in
    [_ ⊢ oft/letbang D1' (\x.D2') M2]
  ;

rec oft_exch_top : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft (cons (cons Δ X A[] α[]) Y B[] β[]) M C]
  → [Ψ ⊢ oft (cons (cons Δ Y B[] β[]) X A[] α[]) M C] =
  / total 1 /
  fn d ⇒ oft_exch d
    (exch_top [_ ⊢ _] [_ ⊢ _] [ ⊢ _] [ ⊢ _] [_ ⊢ _] [ ⊢ _] [ ⊢ _])
  ;

% Deletion lemma: an entry with multiplicity 𝟘 can be removed from the context

rec oft_del : (Ψ:ctx) (Δ:[Ψ ⊢ lctx (suc N[])])
  [Ψ ⊢ oft Δ M A[]] → [Ψ ⊢ del Δ n[] Δ'] → [Ψ ⊢ oft Δ' M A[]] =
  / total 1 /
  fn d, dl ⇒
  let [_ ⊢ DL] = dl in
  case d of
  | [_ ⊢ oft/var U1 E1] ⇒
    let [_ ⊢ del-upd U2 DL1 _ _ _] =
      del_upd [_ ⊢ DL] [_ ⊢ U1] (fn e ⇒ impossible e) in
    let [_ ⊢ E2] = del_exh [_ ⊢ DL1] [_ ⊢ E1] in
    [_ ⊢ oft/var U2 E2]
  | [_ ⊢ oft/vari U1 E1] ⇒
    let [_ ⊢ del-upd U2 DL1 _ _ _] =
      del_upd [_ ⊢ DL] [_ ⊢ U1] (fn e ⇒ impossible e) in
    let [_ ⊢ E2] = del_exh [_ ⊢ DL] [_ ⊢ E1] in
    [_ ⊢ oft/vari U2 E2]
  | [_ ⊢ oft/lam \x.D1] ⇒
    let [_,x:obj ⊢ D2] = oft_del [_,x:obj ⊢ D1] [_,x:obj ⊢ del/n DL[..]] in
    [_ ⊢ oft/lam \x.D2]
  | [_ ⊢ oft/app D1 D2 M1] ⇒
    let [_ ⊢ del-merge M2 DL1 DL2 _ _] = del_merge [_ ⊢ DL] [_ ⊢ M1] in
    let [_ ⊢ D1'] = oft_del [_ ⊢ D1] [_ ⊢ DL1] in
    let [_ ⊢ D2'] = oft_del [_ ⊢ D2] [_ ⊢ DL2] in
    [_ ⊢ oft/app D1' D2' M2]
  | [_ ⊢ oft/bang E1 D1] ⇒
    let [_ ⊢ E2] = del_exh [_ ⊢ DL] [_ ⊢ E1] in
    let [_ ⊢ D2] = oft_del [_ ⊢ D1] [_ ⊢ DL] in
    [_ ⊢ oft/bang E2 D2]
  | [_ ⊢ oft/letbang D1 (\x.D2) M1] ⇒
    let [_ ⊢ del-merge M2 DL1 DL2 _ _] = del_merge [_ ⊢ DL] [_ ⊢ M1] in
    let [_ ⊢ D1'] = oft_del [_ ⊢ D1] [_ ⊢ DL1] in
    let [_,x:obj ⊢ D2'] = oft_del [_,x:obj ⊢ D2] [_,x:obj ⊢ del/n DL2[..]] in
    [_ ⊢ oft/letbang D1' (\x.D2') M2]
  ;

% Strengthening of used assumptions: If Δ, x :⁰ A ⊢ M : C, then (a) M does not
% depend on x and (b) Δ ⊢ M : C

inductive StrTop : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]]) {D:[Ψ ⊢ oft Δ M A[]]} ctype =
| Str-Top : [Ψ ⊢ oft Δ M A[]]
  → {D:[Ψ,x:obj ⊢ oft (cons Δ[..] x B[] 𝟘) M[..] A[]]} StrTop [Ψ,x:obj ⊢ D];

rec oft_str_0 : {D:[Ψ,x:obj ⊢ oft (cons Δ[..] x B[] 𝟘) M A[]]}
  StrTop [Ψ,x:obj ⊢ D] =
  / total 1 /
  mlam D ⇒
  let [_,x:obj ⊢ D1] = oft_del [_,x:obj ⊢ D] [_,x:obj ⊢ del/t _] in
  let Prune-Oft [_ ⊢ D2] [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ D1] in
  Str-Top [_ ⊢ D2] [_,x:obj ⊢ _]
  ;
 
% If x :ω A ∈ Δ and M does not mention x, then M is still typable when that
% entry is changed to x :⁰ A.

rec oft_drop_w : (Ψ:ctx) (Δ:[Ψ,x:obj ⊢ lctx K[]])
  [Ψ,x:obj ⊢ oft Δ M[..] C[]]
  → [Ψ,x:obj ⊢ upd Δ n[] x x A[] A[] ω 𝟘 Δ']
  → [Ψ,x:obj ⊢ oft Δ' M[..] C[]] =
  / total 1 /
  fn d, u ⇒
  let [_,x:obj ⊢ U] = u in
  case d of
  | [_,x:obj ⊢ oft/var U1 E1] ⇒
    let [_,x:obj ⊢ look-neq NEQ[] _ _] =
      comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] in
    let [_,x:obj ⊢ upd-pushout U2 U3 _ _] =
      upd_pushout [_,x:obj ⊢ U] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
    let [_,x:obj ⊢ E2] =
      exh_upd_hal [_,x:obj ⊢ E1] [ ⊢ hal/0] [_,x:obj ⊢ U3] in
    [_,x:obj ⊢ oft/var U2 E2]
  | [_,x:obj ⊢ oft/vari U1 E1] ⇒
    let [_,x:obj ⊢ look-neq NEQ[] _ _] =
      comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] in
    let [_,x:obj ⊢ lookintm U2] =
      lookup_upd [_,x:obj ⊢ U] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
    let [_,x:obj ⊢ E2] = exh_upd_hal [_,x:obj ⊢ E1] [ ⊢ hal/0] u in
    [_,x:obj ⊢ oft/vari U2 E2]
  | [_,x:obj ⊢ oft/lam \y.D1[..,y,x]] ⇒
    let [_,y:obj,x:obj ⊢ D2] =
      oft_drop_w [_,y:obj,x:obj ⊢ D1] [_,y:obj,x:obj ⊢ upd/n U[..,x]] in
    [_,x:obj ⊢ oft/lam \y.D2[..,y,x]]
  | [_,x:obj ⊢ oft/app D1 D2 M1] ⇒
    let [_,x:obj ⊢ merge-upd U1 U2 •/ωω M2 _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M1] [ ⊢ •/00] in
    let [_,x:obj ⊢ D1'] = oft_drop_w [_,x:obj ⊢ D1] [_,x:obj ⊢ U1] in
    let [_,x:obj ⊢ D2'] = oft_drop_w [_,x:obj ⊢ D2] [_,x:obj ⊢ U2] in
    [_,x:obj ⊢ oft/app D1' D2' M2]
  | [_,x:obj ⊢ oft/bang E1 D1] ⇒
    let [_,x:obj ⊢ E2] = exh_upd_hal [_,x:obj ⊢ E1] [ ⊢ hal/0] u in
    let [_,x:obj ⊢ D1'] = oft_drop_w [_,x:obj ⊢ D1] u in
    [_,x:obj ⊢ oft/bang E2 D1']
  | [_,x:obj ⊢ oft/letbang D1 (\y.D2[..,y,x]) M1] ⇒
    let [_,x:obj ⊢ merge-upd U1 U2 •/ωω M2 _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M1] [ ⊢ •/00] in
    let [_,x:obj ⊢ D1'] = oft_drop_w [_,x:obj ⊢ D1] [_,x:obj ⊢ U1] in
    let [_,y:obj,x:obj ⊢ D2'] =
      oft_drop_w [_,y:obj,x:obj ⊢ D2] [_,y:obj,x:obj ⊢ upd/n U2[..,x]] in
    [_,x:obj ⊢ oft/letbang D1' (\y.D2'[..,y,x]) M2]
  ;

% Intuitionistic strengthening: if Δ, x :ω A ⊢ M : C and x ∉ fv(M), then
% Δ ⊢ M : C

rec oft_str_w : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ,x:obj ⊢ oft (cons Δ[..] x A[] ω) M[..] C[]]
  → [Ψ ⊢ oft Δ[..] M C[]] =
  / total 1 /
  fn d ⇒
  let [_,x:obj ⊢ D1] = oft_drop_w d [_,x:obj ⊢ upd/t _] in
  let Str-Top [_ ⊢ D2] [_,x:obj ⊢ _] = oft_str_0 [_,x:obj ⊢ D1] in
  [_ ⊢ D2]
   ;

% Intuitionistic weakening lemmas:
% (1) If Δ ⊢ M : C and hal(α), then Δ, x :α A ⊢ M : C for any A
% (2) If Δ ⊢ M : C and hal(α), then Δ[x :⁰ A ↦ₙ y :α A'] ⊢ M : C for any y,A'

rec oft_weak : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft Δ M C[]]
  → {A:[ ⊢ tp]} [ ⊢ hal α]
  → [Ψ,x:obj ⊢ oft (cons Δ[..] x A[] α[]) M[..] C[]] =
  / total 1 /
  fn d ⇒ mlam A ⇒ fn h ⇒
  let [ ⊢ H] = h in
  let [ ⊢ T] = halidem_prf _ h in
  case d of
  | [_ ⊢ oft/var U1 E1] ⇒ [_ ⊢ oft/var (upd/n U1[..]) (exh/c E1[..] H[])]
  | [_ ⊢ oft/vari U1 E1] ⇒ [_ ⊢ oft/vari (upd/n U1[..]) (exh/c E1[..] H[])]
  | [_ ⊢ oft/lam \x.D1] ⇒
    let [_,x:obj,y:obj ⊢ D1'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ D1] [ ⊢ A] h) in
    [_,x:obj ⊢ oft/lam \y.D1'[..,y,x]]
  | [_ ⊢ oft/app D1 D2 M1] ⇒
    let [_,x:obj ⊢ D1'] = oft_weak [_ ⊢ D1] [ ⊢ A] h in
    let [_,x:obj ⊢ D2'] = oft_weak [_ ⊢ D2] [ ⊢ A] h in
    [_,x:obj ⊢ oft/app D1' D2' (mg/c M1[..] T[])]
  | [_ ⊢ oft/bang E1 D1] ⇒
    let [_,x:obj ⊢ D1'] = oft_weak [_ ⊢ D1] [ ⊢ A] h in
    [_,x:obj ⊢ oft/bang (exh/c E1[..] H[]) D1']
  | [_ ⊢ oft/letbang D1 (\x.D2) M1] ⇒
    let [_,x:obj ⊢ D1'] = oft_weak [_ ⊢ D1] [ ⊢ A] h in
    let [_,x:obj,y:obj ⊢ D2'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ D2] [ ⊢ A] h) in
    [_,x:obj ⊢ oft/letbang D1' (\y.D2'[..,y,x]) (mg/c M1[..] T[])]
  ;

rec oft_weak_upd : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft Δ M C[]]
  → [Ψ ⊢ upd Δ n[] X X' A[] A'[] 𝟘 α[] Δ']
  → [ ⊢ hal α]
  → [Ψ ⊢ oft Δ' M C[]] =
  / total 1 /
  fn d, u, h ⇒
  let [_ ⊢ U] = u in
  let [ ⊢ get-hal-split H1 H2 T1] = mult_get_hal h in
  case d of
  | [_ ⊢ oft/var U1 E1] ⇒
    let [_ ⊢ look-neq N[] _ _] = comp_look [_ ⊢ U] [_ ⊢ U1] in
    let [_ ⊢ upd-pushout U2 U3 _ _] = upd_pushout [_ ⊢ U] [_ ⊢ U1] [ ⊢ N] in
    let [_ ⊢ E2] = exh_upd_hal [_ ⊢ E1] h [_ ⊢ U3] in
    [_ ⊢ oft/var U2 E2]
  | [_ ⊢ oft/vari U1 E1] ⇒
    let [_ ⊢ look-neq N[] _ _] = comp_look [_ ⊢ U] [_ ⊢ U1] in
    let [_ ⊢ lookintm U2] = lookup_upd u [_ ⊢ U1] [ ⊢ N] in
    let [_ ⊢ E2] = exh_upd_hal [_ ⊢ E1] h u in
    [_ ⊢ oft/vari U2 E2]
  | [_ ⊢ oft/lam \x.D1] ⇒
    let [_,x:obj ⊢ D2] =
      oft_weak_upd [_,x:obj ⊢ D1] [_,x:obj ⊢ upd/n U[..]] h in
    [_ ⊢ oft/lam \x.D2]
  | [_ ⊢ oft/app D1 D2 M1] ⇒
    let [_ ⊢ merge-upd U1 U2 T2[] M2 _ _ _] =
      merge_upd_cor [_ ⊢ U] [_ ⊢ M1] [ ⊢ T1] in
    let [ ⊢ mult/refl] = mult_zsfree_cor [ ⊢ T2] in
    let [ ⊢ mult/refl] = mult_zsfree_cor (mult_comm [ ⊢ T2]) in
    let [_ ⊢ D1'] = oft_weak_upd [_ ⊢ D1] [_ ⊢ U1] [ ⊢ H1] in
    let [_ ⊢ D2'] = oft_weak_upd [_ ⊢ D2] [_ ⊢ U2] [ ⊢ H2] in
    [_ ⊢ oft/app D1' D2' M2]
  | [_ ⊢ oft/bang E1 D1] ⇒
    let [_ ⊢ E2] = exh_upd_hal [_ ⊢ E1] h u in
    let [_ ⊢ D2] = oft_weak_upd [_ ⊢ D1] u h in
    [_ ⊢ oft/bang E2 D2]
  | [_ ⊢ oft/letbang D1 (\x.D2) M1] ⇒
    let [_ ⊢ merge-upd U1 U2 T2[] M2 _ _ _] =
      merge_upd_cor [_ ⊢ U] [_ ⊢ M1] [ ⊢ T1] in
    let [ ⊢ mult/refl] = mult_zsfree_cor [ ⊢ T2] in
    let [ ⊢ mult/refl] = mult_zsfree_cor (mult_comm [ ⊢ T2]) in
    let [_ ⊢ D1'] = oft_weak_upd [_ ⊢ D1] [_ ⊢ U1] [ ⊢ H1] in
    let [_,x:obj ⊢ D2'] =
      oft_weak_upd [_,x:obj ⊢ D2] [_,x:obj ⊢ upd/n U2[..]] [ ⊢ H2] in
    [_ ⊢ oft/letbang D1' (\x.D2') M2]
  ;

% Environment weakening lemma (dereliction): If Δ ⊢ M : C, then
% Δ[x :¹ A ↦ x :ω A] ⊢ M : C

rec oft_weak_env : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft Δ M C[]]
  → [Ψ ⊢ upd Δ n[] X X A[] A[] 𝟙 ω Δ']
  → [Ψ ⊢ oft Δ' M C[]] =
  / total 1 /
  fn d, u ⇒
  let [_ ⊢ U] = u in
  case d of
  | [_ ⊢ oft/var U1 E1] ⇒
    (case comp_look [_ ⊢ U1] [_ ⊢ U] of
    | [_ ⊢ look-eq _ _] ⇒
      let [_ ⊢ U'] = upd_symm u in
      let [_ ⊢ E2] =
        exh_upd_hal [_ ⊢ E1] [ ⊢ hal/ω] (upd_trans (upd_symm [_ ⊢ U1]) u) in
      [_ ⊢ oft/vari U' E2]
    | [_ ⊢ look-neq N[] _ _] ⇒
      let [_ ⊢ lookintm U2] = lookup_upd [_ ⊢ U1] [_ ⊢ U] [ ⊢ N] in
      impossible exh_lookup [_ ⊢ E1] [_ ⊢ U2]
    )
  | [_ ⊢ oft/vari U1 E1] ⇒ impossible exh_lookup [_ ⊢ E1] u
  | [_ ⊢ oft/lam \x.D1] ⇒
    let [_,x:obj ⊢ D2] = oft_weak_env [_,x:obj ⊢ D1] [_,x:obj ⊢ upd/n U[..]] in
    [_ ⊢ oft/lam \x.D2]
  | [_ ⊢ oft/app D1 D2 M1] ⇒
    let [_ ⊢ merge-upd U1 U2 T1[] M2 _ _ _] =
      merge_upd_cor [_ ⊢ U] [_ ⊢ M1] [ ⊢ •/ωω] in
    (case [ ⊢ T1] of
    | [ ⊢ •/01] ⇒
      let [_ ⊢ D1'] = oft_weak_upd [_ ⊢ D1] [_ ⊢ U1] [ ⊢ hal/ω] in
      let [_ ⊢ D2'] = oft_weak_env [_ ⊢ D2] [_ ⊢ U2] in
      [_ ⊢ oft/app D1' D2' M2]
    | [ ⊢ •/10] ⇒
      let [_ ⊢ D1'] = oft_weak_env [_ ⊢ D1] [_ ⊢ U1] in
      let [_ ⊢ D2'] = oft_weak_upd [_ ⊢ D2] [_ ⊢ U2] [ ⊢ hal/ω] in
      [_ ⊢ oft/app D1' D2' M2]
    )
  | [_ ⊢ oft/bang E1 D1] ⇒ impossible exh_lookup [_ ⊢ E1] u
  | [_ ⊢ oft/letbang D1 (\x.D2) M1] ⇒
    let [_ ⊢ merge-upd U1 U2 T1[] M2 _ _ _] =
      merge_upd_cor [_ ⊢ U] [_ ⊢ M1] [ ⊢ •/ωω] in
    (case [ ⊢ T1] of
    | [ ⊢ •/01] ⇒
      let [_ ⊢ D1'] = oft_weak_upd [_ ⊢ D1] [_ ⊢ U1] [ ⊢ hal/ω] in
      let [_,x:obj ⊢ D2'] =
        oft_weak_env [_,x:obj ⊢ D2] [_,x:obj ⊢ upd/n U2[..]] in
      [_ ⊢ oft/letbang D1' (\x.D2') M2]
    | [ ⊢ •/10] ⇒
      let [_ ⊢ D1'] = oft_weak_env [_ ⊢ D1] [_ ⊢ U1] in
      let [_,x:obj ⊢ D2'] =
        oft_weak_upd [_,x:obj ⊢ D2] [_,x:obj ⊢ upd/n U2[..]] [ ⊢ hal/ω] in
      [_ ⊢ oft/letbang D1' (\x.D2') M2]
    )
  ;

%------------------------------------------------------%
% Linear cut lemma
%------------------------------------------------------%

% Linear cut with the substituted variable x anywhere in the context: 
% If (a) Δ₁ ⊢ M : C, (b) x :¹ A is the k-th entry of Δ₁, and the rest of Δ₁,
% written Δ₁', does not mention x, (c) Δ₂ ⊢ N : A, and (d) Δ₁' ⋈ Δ₂ = Δ, then
% Δ ⊢ [N/x]M : C

rec substitution_gen : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ,x:obj ⊢ oft Δ₁ M C[]]
  → [Ψ,x:obj ⊢ upd Δ₁ k[] x x A[] A[] 𝟙 𝟘 Δ₁⁰]
  → [Ψ,x:obj ⊢ del Δ₁⁰ k[] Δ₁'[..]]
  → [Ψ ⊢ oft Δ₂ N A[]]
  → [Ψ ⊢ merge Δ₁' Δ₂ Δ]
  → [Ψ ⊢ oft Δ M[..,N] C[]] =
  / total 1 /
  fn d1, u, dl, d2, mg ⇒
  let [_ ⊢ M] = mg in
  let [_,x:obj ⊢ U] = u in
  let [_,x:obj ⊢ DL] = dl in
  case d1 of
  | [_,x:obj ⊢ oft/var U1 E1] ⇒
    (case comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ U] [_,x:obj ⊢ U1] in
      let [_,x:obj ⊢ E2] = del_exh [_,x:obj ⊢ DL] [_,x:obj ⊢ E1] in
      let [_ ⊢ ctx/refl] =
        merge_id mult_halident mg (prune_exh [_,x:obj ⊢ E2]) in
      d2
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ lookintm U2] =
        lookup_upd [_,x:obj ⊢ U1] [_,x:obj ⊢ U] (neq_comm [ ⊢ NEQ]) in
      impossible exh_lookup [_,x:obj ⊢ E1] [_,x:obj ⊢ U2]
    )
  | [_,x:obj ⊢ oft/vari U1 E1] ⇒ impossible exh_lookup [_,x:obj ⊢ E1] u
  | [_,x:obj ⊢ oft/lam \y.D1[..,y,x]] ⇒
    let [_,y:obj ⊢ D2] =
      substitution_gen [_,y:obj,x:obj ⊢ D1] [_,y:obj,x:obj ⊢ upd/n U[..,x]]
        [_,y:obj,x:obj ⊢ del/n DL[..,x]] (oft_weak d2 [ ⊢ _] [ ⊢ hal/0])
        [_,y:obj ⊢ mg/c M[..] •/10] in
    [_ ⊢ oft/lam \y.D2]
  | [_,x:obj ⊢ oft/app D1 D2 M2] ⇒
    let [_,x:obj ⊢ merge-upd Ua Ub T[] M2⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M2] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M2' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M2⁰] in
    let Prune-Merge [_ ⊢ M2''] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M2'] in
    (case [ ⊢ T] of
    | [ ⊢ •/01] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ua] in
      let [_,x:obj ⊢ D1s] = oft_del [_,x:obj ⊢ D1] [_,x:obj ⊢ DLa] in
      let Prune-Oft [_ ⊢ D1'] [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ D1s] in
      let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2''] in
      let [_ ⊢ D2'] = substitution_gen [_,x:obj ⊢ D2] [_,x:obj ⊢ Ub]
        [_,x:obj ⊢ DLb] d2 [_ ⊢ M3] in
      [_ ⊢ oft/app D1' D2' M4]
    | [ ⊢ •/10] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ub] in
      let [_,x:obj ⊢ D2s] = oft_del [_,x:obj ⊢ D2] [_,x:obj ⊢ DLb] in
      let Prune-Oft [_ ⊢ D2'] [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ D2s] in
      let [_ ⊢ M2_comm] = merge_comm [_ ⊢ M2''] in
      let [_ ⊢ merge-assoc M3 M4_comm _ _] =
        merge_assoc [_ ⊢ M] [_ ⊢ M2_comm] in
      let [_ ⊢ M4] = merge_comm [_ ⊢ M4_comm] in
      let [_ ⊢ D1'] = substitution_gen [_,x:obj ⊢ D1] [_,x:obj ⊢ Ua]
        [_,x:obj ⊢ DLa] d2 [_ ⊢ M3] in
      [_ ⊢ oft/app D1' D2' M4]
    )
  | [_,x:obj ⊢ oft/bang E1 D1] ⇒ impossible exh_lookup [_,x:obj ⊢ E1] u
  | [_,x:obj ⊢ oft/letbang D1 (\y.D2[..,y,x]) M2] ⇒
    let [_,x:obj ⊢ merge-upd Ua Ub T[] M2⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M2] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M2' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M2⁰] in
    let Prune-Merge [_ ⊢ M2''] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M2'] in
    (case [ ⊢ T] of
    | [ ⊢ •/01] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ua] in
      let [_,x:obj ⊢ D1s] = oft_del [_,x:obj ⊢ D1] [_,x:obj ⊢ DLa] in
      let Prune-Oft [_ ⊢ D1'] [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ D1s] in
      let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2''] in
      let [_,y:obj ⊢ D2'] =
        substitution_gen [_,y:obj,x:obj ⊢ D2] [_,y:obj,x:obj ⊢ upd/n Ub[..,x]]
          [_,y:obj,x:obj ⊢ del/n DLb[..,x]] (oft_weak d2 [ ⊢ _] [ ⊢ hal/ω])
          [_,y:obj ⊢ mg/c M3[..] •/ωω] in
      [_ ⊢ oft/letbang D1' (\y.D2') M4]
    | [ ⊢ •/10] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ub] in
      let [_,y:obj,x:obj ⊢ D2s] =
        oft_del [_,y:obj,x:obj ⊢ D2] [_,y:obj,x:obj ⊢ del/n DLb[..,x]] in
      let Prune-Oft [_,y:obj ⊢ D2'] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ D2s] in
      let [_ ⊢ M2_comm] = merge_comm [_ ⊢ M2''] in
      let [_ ⊢ merge-assoc M3 M4_comm _ _] =
        merge_assoc [_ ⊢ M] [_ ⊢ M2_comm] in
      let [_ ⊢ M4] = merge_comm [_ ⊢ M4_comm] in
      let [_ ⊢ D1'] = substitution_gen [_,x:obj ⊢ D1] [_,x:obj ⊢ Ua]
        [_,x:obj ⊢ DLa] d2 [_ ⊢ M3] in
      [_ ⊢ oft/letbang D1' (\y.D2') M4]
    )
  ;

% Corollary (linear cut): If (a) Δ₁, x :¹ A ⊢ M : C, (b) Δ₂ ⊢ N : A, and (c) Δ₁ ⋈ Δ₂ =
% Δ, then Δ ⊢ [N/x]M : C

rec substitution : (Ψ:ctx) (Δ:[Ψ ⊢ lctx k[]])
  [Ψ,x:obj ⊢ oft (cons Δ₁[..] x A[] 𝟙) M C[]]
  → [Ψ ⊢ oft Δ₂ N A[]]
  → [Ψ ⊢ merge Δ₁ Δ₂ Δ]
  → [Ψ ⊢ oft Δ M[..,N] C[]] =
  / total 1 /
  fn d1, d2, m ⇒
  substitution_gen d1 [_,x:obj ⊢ upd/t _] [_,x:obj ⊢ del/t _] d2 m
  ;

%------------------------------------------------------%
% Intuitionistic cut lemma
%------------------------------------------------------%

% Intuitionistic cut with the substituted variable x anywhere in the context:
% If (a) Δ₁ ⊢ M : C, (b) x :ω A is the k-th entry of Δ₁, and the rest of Δ₁,
% written Δ₁', does not mention x, (c) Δ₂ ⊢ N : A, (d) exh(Δ₂), and (e)
% Δ₁' ⋈ Δ₂ = Δ, then Δ ⊢ [N/x]M : C

rec substitution_w_gen : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ,x:obj ⊢ oft Δ₁ M C[]]
  → [Ψ,x:obj ⊢ upd Δ₁ k[] x x A[] A[] ω 𝟘 Δ₁⁰]
  → [Ψ,x:obj ⊢ del Δ₁⁰ k[] Δ₁'[..]]
  → [Ψ ⊢ oft Δ₂ N A[]]
  → [Ψ ⊢ exh Δ₂]
  → [Ψ ⊢ merge Δ₁' Δ₂ Δ]
  → [Ψ ⊢ oft Δ M[..,N] C[]] =
  / total 1 /
  fn d1, u, dl, d2, e, mg ⇒
  let [_ ⊢ M] = mg in
  let [_ ⊢ E] = e in
  let [_,x:obj ⊢ U] = u in
  let [_,x:obj ⊢ DL] = dl in
  let [_ ⊢ ctx/refl] = merge_id mult_halident (merge_comm [_ ⊢ M]) e in
  case d1 of
  | [_,x:obj ⊢ oft/var U1 E1] ⇒
    let [_,x:obj ⊢ look-neq NEQ[] _ _] =
      comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] in
  let [_,x:obj ⊢ pushout-delete U2 U3 DL' U4 _ _ _] =
    pushout_delete [_,x:obj ⊢ U] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
    let Prune-Upd [_ ⊢ U5] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U4] in
    let [_ ⊢ E2] = prune_exh (del_exh [_,x:obj ⊢ DL']
        (exh_upd_hal [_,x:obj ⊢ E1] [ ⊢ hal/0] [_,x:obj ⊢ U3])) in
    [_ ⊢ oft/var U5 E2]
  | [_,x:obj ⊢ oft/vari U1 E1] ⇒
    let [_ ⊢ E2] =
      prune_exh (del_exh dl (exh_upd_hal [_,x:obj ⊢ E1] [ ⊢ hal/0] u)) in
    (case comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_ ⊢ ctx/refl] = merge_id mult_halident [_ ⊢ M] [_ ⊢ E2] in
      d2
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ lookintm U2] =
        lookup_upd [_,x:obj ⊢ U] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let [_,x:obj ⊢ del-upd U3 _ _ _ _] =
        del_upd [_,x:obj ⊢ DL] [_,x:obj ⊢ U2] (fn e ⇒ impossible e) in
      let Prune-Upd [_ ⊢ U4] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U3] in
      [_ ⊢ oft/vari U4 E2]
    )
  | [_,x:obj ⊢ oft/lam \y.D1[..,y,x]] ⇒
    let [_,y:obj ⊢ D2] =
      substitution_w_gen [_,y:obj,x:obj ⊢ D1]
        [_,y:obj,x:obj ⊢ upd/n U[..,x]] [_,y:obj,x:obj ⊢ del/n DL[..,x]]
        (oft_weak d2 [ ⊢ _] [ ⊢ hal/0]) [_,y:obj ⊢ exh/c E[..] hal/0]
        [_,y:obj ⊢ mg/c M[..] •/10] in
    [_ ⊢ oft/lam \y.D2]
  | [_,x:obj ⊢ oft/app D1 D2 M1] ⇒
    let [_,x:obj ⊢ merge-upd Ua Ub •/ωω M1⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M1] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M1' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M1⁰] in
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1'] in
    let [_ ⊢ M2_comm] = merge_comm [_ ⊢ M2] in
    let [_ ⊢ merge-assoc M3 _ _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2] in
    let [_ ⊢ merge-assoc M5 _ _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2_comm] in
    let [_ ⊢ ctx/refl] = merge_id mult_halident (merge_comm [_ ⊢ M5]) e in
    let [_ ⊢ ctx/refl] = merge_id mult_halident (merge_comm [_ ⊢ M3]) e in
    let [_ ⊢ D1'] = substitution_w_gen [_,x:obj ⊢ D1] [_,x:obj ⊢ Ua]
      [_,x:obj ⊢ DLa] d2 e [_ ⊢ M5] in
    let [_ ⊢ D2'] = substitution_w_gen [_,x:obj ⊢ D2] [_,x:obj ⊢ Ub]
      [_,x:obj ⊢ DLb] d2 e [_ ⊢ M3] in
    [_ ⊢ oft/app D1' D2' M2]
  | [_,x:obj ⊢ oft/bang E1 D1] ⇒
    let [_ ⊢ E2] =
      prune_exh (del_exh dl (exh_upd_hal [_,x:obj ⊢ E1] [ ⊢ hal/0] u)) in
    let [_ ⊢ D2] = substitution_w_gen [_,x:obj ⊢ D1] u dl d2 e mg in
    [_ ⊢ oft/bang E2 D2]
  | [_,x:obj ⊢ oft/letbang D1 (\y.D2[..,y,x]) M1] ⇒
    let [_,x:obj ⊢ merge-upd Ua Ub •/ωω M1⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M1] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M1' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M1⁰] in
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1'] in
    let [_ ⊢ M2_comm] = merge_comm [_ ⊢ M2] in
    let [_ ⊢ merge-assoc M3 _ _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2] in
    let [_ ⊢ merge-assoc M5 _ _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2_comm] in
    let [_ ⊢ ctx/refl] = merge_id mult_halident (merge_comm [_ ⊢ M5]) e in
    let [_ ⊢ ctx/refl] = merge_id mult_halident (merge_comm [_ ⊢ M3]) e in
    let [_ ⊢ D1'] = substitution_w_gen [_,x:obj ⊢ D1] [_,x:obj ⊢ Ua]
      [_,x:obj ⊢ DLa] d2 e [_ ⊢ M5] in
    let [_,y:obj ⊢ D2'] =
      substitution_w_gen [_,y:obj,x:obj ⊢ D2]
        [_,y:obj,x:obj ⊢ upd/n Ub[..,x]] [_,y:obj,x:obj ⊢ del/n DLb[..,x]]
        (oft_weak d2 [ ⊢ _] [ ⊢ hal/ω]) [_,y:obj ⊢ exh/c E[..] hal/ω]
        [_,y:obj ⊢ mg/c M3[..] •/ωω] in
    [_ ⊢ oft/letbang D1' (\y.D2') M2]
  ;

% Intuitionistic cut: If (a) Δ₁, x :ω A ⊢ M : C, (b) Δ₂ ⊢ N : A, (c)
% exh(Δ₂), and (d) Δ₁ ⋈ Δ₂ = Δ, then Δ ⊢ [N/x]M : C

rec substitution_w : (Ψ:ctx) (Δ:[Ψ ⊢ lctx k[]])
  [Ψ,x:obj ⊢ oft (cons Δ₁[..] x A[] ω) M C[]]
  → [Ψ ⊢ oft Δ₂ N A[]]
  → [Ψ ⊢ exh Δ₂]
  → [Ψ ⊢ merge Δ₁ Δ₂ Δ]
  → [Ψ ⊢ oft Δ M[..,N] C[]] =
  / total 1 /
  fn d1, d2, e, m ⇒
  substitution_w_gen d1 [_,x:obj ⊢ upd/t _] [_,x:obj ⊢ del/t _] d2 e m
  ;
