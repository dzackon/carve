%======================================================%
% Lemmas (linear natural deduction calculus)
%======================================================%

%------------------------------------------------------%
% Structural properties of typing judgment
%------------------------------------------------------%

% Pruning: if the context does not mention x, neither does the term nor the
% derivation

inductive PruneChk : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  {CH:[Ψ,x:obj ⊢ chk Δ[..] M C[]]} ctype =
  Prune-Chk : [Ψ ⊢ chk Δ M C[]]
  → {CH:[Ψ,x:obj ⊢ chk Δ[..] M[..] C[]]} PruneChk [Ψ,x:obj ⊢ CH];

inductive PruneSyn : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  {SY:[Ψ,x:obj ⊢ syn Δ[..] M C[]]} ctype =
  Prune-Syn : [Ψ ⊢ syn Δ M C[]]
  → {SY:[Ψ,x:obj ⊢ syn Δ[..] M[..] C[]]} PruneSyn [Ψ,x:obj ⊢ SY];

rec prune_chk : {CH:[Ψ,x:obj ⊢ chk Δ[..] M C[]]} PruneChk [Ψ,x:obj ⊢ CH] =
  / total 1 /
  mlam CH ⇒ case [_,x:obj ⊢ CH] of
  | [_,x:obj ⊢ conv SY] ⇒
    let Prune-Syn [_ ⊢ SY'] [_,x:obj ⊢ _] = prune_syn [_,x:obj ⊢ SY] in
    Prune-Chk [_ ⊢ conv SY'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ I① E] ⇒
    let [_ ⊢ E'] = prune_exh [_,x:obj ⊢ E] in
    Prune-Chk [_ ⊢ I① E'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ E① SY CH1 M] ⇒
    let Prune-Merge [_ ⊢ M'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M] in
    let Prune-Syn [_ ⊢ SY'] [_,x:obj ⊢ _] = prune_syn [_,x:obj ⊢ SY] in
    let Prune-Chk [_ ⊢ CH1'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH1] in
    Prune-Chk [_ ⊢ E① SY' CH1' M'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ I⊗ CH1 CH2 M] ⇒
    let Prune-Merge [_ ⊢ M'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M] in
    let Prune-Chk [_ ⊢ CH1'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH1] in
    let Prune-Chk [_ ⊢ CH2'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH2] in
    Prune-Chk [_ ⊢ I⊗ CH1' CH2' M'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ E⊗ SY (\y.\z.CH1[..,y,z,x]) M] ⇒
    let Prune-Merge [_ ⊢ M'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M] in
    let Prune-Syn [_ ⊢ SY'] [_,x:obj ⊢ _] = prune_syn [_,x:obj ⊢ SY] in
    let Prune-Chk [_,y:obj,z:obj ⊢ CH1'] [_,y:obj,z:obj,x:obj ⊢ _] =
      prune_chk [_,y:obj,z:obj,x:obj ⊢ CH1] in
    Prune-Chk [_ ⊢ E⊗ SY' (\y.\z.CH1') M'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ I-o (\y.CH1[..,y,x])] ⇒
    let Prune-Chk [_,y:obj ⊢ CH1'] [_,y:obj,x:obj ⊢ _] =
      prune_chk [_,y:obj,x:obj ⊢ CH1] in
    Prune-Chk [_ ⊢ I-o (\y.CH1')] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ I& CH1 CH2] ⇒
    let Prune-Chk [_ ⊢ CH1'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH1] in
    let Prune-Chk [_ ⊢ CH2'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH2] in
    Prune-Chk [_ ⊢ I& CH1' CH2'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ I⊕1 CH1] ⇒
    let Prune-Chk [_ ⊢ CH1'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH1] in
    Prune-Chk [_ ⊢ I⊕1 CH1'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ I⊕2 CH1] ⇒
    let Prune-Chk [_ ⊢ CH1'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH1] in
    Prune-Chk [_ ⊢ I⊕2 CH1'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ E⊕ SY (\y.CH1[..,y,x]) (\y.CH2[..,y,x]) M] ⇒
    let Prune-Merge [_ ⊢ M'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M] in
    let Prune-Syn [_ ⊢ SY'] [_,x:obj ⊢ _] = prune_syn [_,x:obj ⊢ SY] in
    let Prune-Chk [_,y:obj ⊢ CH1'] [_,y:obj,x:obj ⊢ _] =
      prune_chk [_,y:obj,x:obj ⊢ CH1] in
    let Prune-Chk [_,y:obj ⊢ CH2'] [_,y:obj,x:obj ⊢ _] =
      prune_chk [_,y:obj,x:obj ⊢ CH2] in
    Prune-Chk [_ ⊢ E⊕ SY' (\y.CH1') (\y.CH2') M'] [_,x:obj ⊢ _]

and rec prune_syn : {SY:[Ψ,x:obj ⊢ syn Δ[..] M C[]]} PruneSyn [Ψ,x:obj ⊢ SY] =
  / total 1 /
  mlam SY ⇒ case [_,x:obj ⊢ SY] of
  | [_,x:obj ⊢ coe CH1] ⇒
    let Prune-Chk [_ ⊢ CH1'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH1] in
    Prune-Syn [_ ⊢ coe CH1'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ init U E] ⇒
    let Prune-Upd [_ ⊢ U'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U] in
    let [_ ⊢ E'] = prune_exh [_,x:obj ⊢ E] in
    Prune-Syn [_ ⊢ init U' E'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ E-o SY1 CH1 M] ⇒
    let Prune-Merge [_ ⊢ M'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M] in
    let Prune-Syn [_ ⊢ SY1'] [_,x:obj ⊢ _] = prune_syn [_,x:obj ⊢ SY1] in
    let Prune-Chk [_ ⊢ CH1'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH1] in
    Prune-Syn [_ ⊢ E-o SY1' CH1' M'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ E&1 SY1] ⇒
    let Prune-Syn [_ ⊢ SY1'] [_,x:obj ⊢ _] = prune_syn [_,x:obj ⊢ SY1] in
    Prune-Syn [_ ⊢ E&1 SY1'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ E&2 SY1] ⇒
    let Prune-Syn [_ ⊢ SY1'] [_,x:obj ⊢ _] = prune_syn [_,x:obj ⊢ SY1] in
    Prune-Syn [_ ⊢ E&2 SY1'] [_,x:obj ⊢ _]
  ;

% Exchange lemmas:
% (1) If Δ ⊢ e ⟸ A and Δ[(n, x) ↔ (m, y)] = Δ', then Δ' ⊢ e ⟸ A
% (2) If Δ ⊢ e ⟹ A and Δ[(n, x) ↔ (m, y)] = Δ', then Δ' ⊢ e ⟹ A
% (Plus two corollaries as helper lemmas for permuting the topmost elements of a
% context)

rec chk_exch : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ chk Δ M C]
  → [Ψ ⊢ exch Δ n X m Y Δ']
  → [Ψ ⊢ chk Δ' M C] =
  / total 1 /
  fn ch1, ex1 ⇒
  let [_ ⊢ exch/u NEQ[] EX1 EX2] = ex1 in
  case ch1 of
  | [_ ⊢ conv SY1] ⇒ let [_ ⊢ SY2] = syn_exch [_ ⊢ SY1] ex1 in [_ ⊢ conv SY2]
  | [_ ⊢ I① E1] ⇒ let [_ ⊢ E2] = exch_exh [_ ⊢ E1] ex1 in [_ ⊢ I① E2]
  | [_ ⊢ E① SY1 CH1 M1] ⇒
    let [_ ⊢ exch-merge EX1a EX2a EX1b EX2b _ M2 _ _ _ _ _] =
      exch_merge [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ M1] in
    let [_ ⊢ SY2] = syn_exch [_ ⊢ SY1] [_ ⊢ exch/u NEQ[] EX1a EX2a] in
    let [_ ⊢ CH2] = chk_exch [_ ⊢ CH1] [_ ⊢ exch/u NEQ[] EX1b EX2b] in
    [_ ⊢ E① SY2 CH2 M2]
  | [_ ⊢ I⊗ CH1a CH1b M1] ⇒
    let [_ ⊢ exch-merge EX1a EX2a EX1b EX2b _ M2 _ _ _ _ _] =
      exch_merge [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ M1] in
    let [_ ⊢ CH2a] = chk_exch [_ ⊢ CH1a] [_ ⊢ exch/u NEQ[] EX1a EX2a] in
    let [_ ⊢ CH2b] = chk_exch [_ ⊢ CH1b] [_ ⊢ exch/u NEQ[] EX1b EX2b] in
    [_ ⊢ I⊗ CH2a CH2b M2]
  | [_ ⊢ E⊗ SY1 (\x.\y.CH1) M1] ⇒
    let [_ ⊢ exch-merge EX1a EX2a EX1b EX2b _ M2 _ _ _ _ _] =
      exch_merge [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ M1] in
    let [_ ⊢ SY2] = syn_exch [_ ⊢ SY1] [_ ⊢ exch/u NEQ[] EX1a EX2a] in
    let [_,x:obj,y:obj ⊢ CH2] = chk_exch [_,x:obj,y:obj ⊢ CH1]
      [_,x:obj,y:obj ⊢ exch/u NEQ[] (upd/n (upd/n EX1b[..]))
        (upd/n (upd/n EX2b[..]))] in
    [_ ⊢ E⊗ SY2 (\x.\y.CH2) M2]
  | [_ ⊢ I-o \x.CH1] ⇒
    let [_,x:obj ⊢ CH2] = chk_exch [_,x:obj ⊢ CH1]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n EX1[..]) (upd/n EX2[..])] in
    [_ ⊢ I-o \x.CH2]
  | [_ ⊢ I& CH1a CH1b] ⇒
    let [_ ⊢ CH2a] = chk_exch [_ ⊢ CH1a] ex1 in
    let [_ ⊢ CH2b] = chk_exch [_ ⊢ CH1b] ex1 in
    [_ ⊢ I& CH2a CH2b]
  | [_ ⊢ I⊕1 CH1] ⇒ let [_ ⊢ CH2] = chk_exch [_ ⊢ CH1] ex1 in [_ ⊢ I⊕1 CH2]
  | [_ ⊢ I⊕2 CH1] ⇒ let [_ ⊢ CH2] = chk_exch [_ ⊢ CH1] ex1 in [_ ⊢ I⊕2 CH2]
  | [_ ⊢ E⊕ SY1 (\x.CH1a) (\x.CH1b) M1] ⇒
    let [_ ⊢ exch-merge EX1a EX2a EX1b EX2b _ M2 _ _ _ _ _] =
      exch_merge [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ M1] in
    let [_ ⊢ SY2] = syn_exch [_ ⊢ SY1] [_ ⊢ exch/u NEQ[] EX1a EX2a] in
    let [_,x:obj ⊢ CH2a] = chk_exch [_,x:obj ⊢ CH1a]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n EX1b[..]) (upd/n EX2b[..])] in
    let [_,x:obj ⊢ CH2b] = chk_exch [_,x:obj ⊢ CH1b]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n EX1b[..]) (upd/n EX2b[..])] in
    [_ ⊢ E⊕ SY2 (\x.CH2a) (\x.CH2b) M2]

and rec syn_exch : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ syn Δ M C]
  → [Ψ ⊢ exch Δ n X m Y Δ']
  → [Ψ ⊢ syn Δ' M C] =
  / total 1 /
  fn sy1, ex1 ⇒
  let [_ ⊢ exch/u NEQ[] EX1 EX2] = ex1 in
  case sy1 of
  | [_ ⊢ coe CH1] ⇒ let [_ ⊢ CH2] = chk_exch [_ ⊢ CH1] ex1 in [_ ⊢ coe CH2]
  | [_ ⊢ init U1 E1] ⇒
    let [_ ⊢ exch-upd EX1' EX2' U2 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ U1] in
    let [_ ⊢ E2] = exch_exh [_ ⊢ E1] [_ ⊢ exch/u NEQ[] EX1' EX2'] in
    [_ ⊢ init U2 E2]
  | [_ ⊢ E-o SY1 CH1 M1] ⇒
    let [_ ⊢ exch-merge EX1a EX2a EX1b EX2b _ M2 _ _ _ _ _] =
      exch_merge [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ M1] in
    let [_ ⊢ SY2] = syn_exch [_ ⊢ SY1] [_ ⊢ exch/u NEQ[] EX1a EX2a] in
    let [_ ⊢ CH2] = chk_exch [_ ⊢ CH1] [_ ⊢ exch/u NEQ[] EX1b EX2b] in
    [_ ⊢ E-o SY2 CH2 M2]
  | [_ ⊢ E&1 SY1] ⇒ let [_ ⊢ SY2] = syn_exch [_ ⊢ SY1] ex1 in [_ ⊢ E&1 SY2]
  | [_ ⊢ E&2 SY1] ⇒ let [_ ⊢ SY2] = syn_exch [_ ⊢ SY1] ex1 in [_ ⊢ E&2 SY2]
  ;

rec chk_exch_top : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ chk (cons (cons Δ X A[] α[]) Y B[] β[]) M C]
  → [Ψ ⊢ chk (cons (cons Δ Y B[] β[]) X A[] α[]) M C] =
  / total 1 /
  fn ch1 ⇒ chk_exch ch1
    (exch_top [_ ⊢ _] [_ ⊢ _] [ ⊢ _] [ ⊢ _] [_ ⊢ _] [ ⊢ _] [ ⊢ _])
  ;

rec chk_exch_top2 : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ chk (cons (cons (cons Δ X A[] α[]) Y B[] β[]) Z C[] γ[]) M D]
  → [Ψ ⊢ chk (cons (cons (cons Δ Y B[] β[]) Z C[] γ[]) X A[] α[]) M D] =
  / total 1 /
  fn ch1 ⇒
  let [_ ⊢ _]:[_ ⊢ chk (cons (cons (cons Δ X A[] α[]) Y B[] β[]) Z C γ) M D] =
    ch1 in
  let [_ ⊢ exch/u NEQ[] EX1 EX2] =
    exch_top [_ ⊢ Δ] [_ ⊢ X] [ ⊢ A] [ ⊢ α] [_ ⊢ Y] [ ⊢ B] [ ⊢ β] in
  chk_exch_top (chk_exch ch1 [_ ⊢ exch/u NEQ[] (upd/n EX1) (upd/n EX2)])
  ;

% Deletion lemmas: an entry with multiplicity 𝟘 can be removed from the context.

rec chk_del : (Ψ:ctx) (Δ:[Ψ ⊢ lctx (suc N[])])
  [Ψ ⊢ chk Δ M C] → [Ψ ⊢ del Δ n[] Δ'] → [Ψ ⊢ chk Δ' M C] =
  / total 1 /
  fn ch1, dl ⇒
  let [_ ⊢ DL] = dl in
  case ch1 of
  | [_ ⊢ conv SY1] ⇒
    let [_ ⊢ SY2] = syn_del [_ ⊢ SY1] [_ ⊢ DL] in [_ ⊢ conv SY2]
  | [_ ⊢ I① E1] ⇒ let [_ ⊢ E2] = del_exh [_ ⊢ DL] [_ ⊢ E1] in [_ ⊢ I① E2]
  | [_ ⊢ E① SY1 CH1 M1] ⇒
    let [_ ⊢ del-merge M2 DL1 DL2 _ _] = del_merge [_ ⊢ DL] [_ ⊢ M1] in
    let [_ ⊢ SY2] = syn_del [_ ⊢ SY1] [_ ⊢ DL1] in
    let [_ ⊢ CH2] = chk_del [_ ⊢ CH1] [_ ⊢ DL2] in
    [_ ⊢ E① SY2 CH2 M2]
  | [_ ⊢ I⊗ CH1a CH1b M1] ⇒
    let [_ ⊢ del-merge M2 DL1 DL2 _ _] = del_merge [_ ⊢ DL] [_ ⊢ M1] in
    let [_ ⊢ CH2a] = chk_del [_ ⊢ CH1a] [_ ⊢ DL1] in
    let [_ ⊢ CH2b] = chk_del [_ ⊢ CH1b] [_ ⊢ DL2] in
    [_ ⊢ I⊗ CH2a CH2b M2]
  | [_ ⊢ E⊗ SY1 (\x.\y.CH1) M1] ⇒
    let [_ ⊢ del-merge M2 DL1 DL2 _ _] = del_merge [_ ⊢ DL] [_ ⊢ M1] in
    let [_ ⊢ SY2] = syn_del [_ ⊢ SY1] [_ ⊢ DL1] in
    let [_,x:obj,y:obj ⊢ CH2] =
      chk_del [_,x:obj,y:obj ⊢ CH1] [_,x:obj,y:obj ⊢ del/n (del/n DL2[..])] in
    [_ ⊢ E⊗ SY2 (\x.\y.CH2) M2]
  | [_ ⊢ I-o \x.CH1] ⇒
    let [_,x:obj ⊢ CH2] = chk_del [_,x:obj ⊢ CH1] [_,x:obj ⊢ del/n DL[..]] in
    [_ ⊢ I-o \x.CH2]
  | [_ ⊢ I& CH1a CH1b] ⇒
    let [_ ⊢ CH2a] = chk_del [_ ⊢ CH1a] [_ ⊢ DL] in
    let [_ ⊢ CH2b] = chk_del [_ ⊢ CH1b] [_ ⊢ DL] in
    [_ ⊢ I& CH2a CH2b]
  | [_ ⊢ I⊕1 CH1] ⇒
    let [_ ⊢ CH2] = chk_del [_ ⊢ CH1] [_ ⊢ DL] in [_ ⊢ I⊕1 CH2]
  | [_ ⊢ I⊕2 CH1] ⇒
    let [_ ⊢ CH2] = chk_del [_ ⊢ CH1] [_ ⊢ DL] in [_ ⊢ I⊕2 CH2]
  | [_ ⊢ E⊕ SY1 (\x.CH1a) (\x.CH1b) M1] ⇒
    let [_ ⊢ del-merge M2 DL1 DL2 _ _] = del_merge [_ ⊢ DL] [_ ⊢ M1] in
    let [_ ⊢ SY2] = syn_del [_ ⊢ SY1] [_ ⊢ DL1] in
    let [_,x:obj ⊢ CH2a] = chk_del [_,x:obj ⊢ CH1a] [_,x:obj ⊢ del/n DL2[..]] in
    let [_,x:obj ⊢ CH2b] = chk_del [_,x:obj ⊢ CH1b] [_,x:obj ⊢ del/n DL2[..]] in
    [_ ⊢ E⊕ SY2 (\x.CH2a) (\x.CH2b) M2]

and rec syn_del : (Ψ:ctx) (Δ:[Ψ ⊢ lctx (suc N[])])
  [Ψ ⊢ syn Δ M C] → [Ψ ⊢ del Δ n[] Δ'] → [Ψ ⊢ syn Δ' M C] =
  / total 1 /
  fn sy1, dl ⇒
  let [_ ⊢ DL] = dl in
  case sy1 of
  | [_ ⊢ coe CH1] ⇒
    let [_ ⊢ CH2] =
      chk_del [_ ⊢ CH1] [_ ⊢ DL] in [_ ⊢ coe CH2] | [_ ⊢ init U1 E1] ⇒ let
        [_ ⊢ del-upd U2 DL1 _ _ _] = del_upd [_ ⊢ DL] [_ ⊢ U1]
        (fn e ⇒ impossible e) in
    let [_ ⊢ E2] = del_exh [_ ⊢ DL1] [_ ⊢ E1] in
    [_ ⊢ init U2 E2]
  | [_ ⊢ E-o SY1 CH1 M1] ⇒
    let [_ ⊢ del-merge M2 DL1 DL2 _ _] = del_merge [_ ⊢ DL] [_ ⊢ M1] in
    let [_ ⊢ SY2] = syn_del [_ ⊢ SY1] [_ ⊢ DL1] in
    let [_ ⊢ CH2] = chk_del [_ ⊢ CH1] [_ ⊢ DL2] in
    [_ ⊢ E-o SY2 CH2 M2]
  | [_ ⊢ E&1 SY1] ⇒
    let [_ ⊢ SY2] = syn_del [_ ⊢ SY1] [_ ⊢ DL] in [_ ⊢ E&1 SY2]
  | [_ ⊢ E&2 SY1] ⇒
    let [_ ⊢ SY2] = syn_del [_ ⊢ SY1] [_ ⊢ DL] in [_ ⊢ E&2 SY2]
  ;

% Strengthening lemmas:
% (1) If (Δ, x :⁰ B) ⊢ e ⟸ A, then Δ ⊢ e ⟸ A
% (2) If (Δ, x :⁰ B) ⊢ e ⟹ A, then Δ ⊢ e ⟹ A

rec chk_str : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ chk (cons Δ X A[] 𝟘) M C]
  → [Ψ ⊢ chk Δ M C] =
  / total 1 /
  fn ch ⇒ chk_del ch [_ ⊢ del/t _]
  ;

rec syn_str : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ syn (cons Δ X A[] 𝟘) M C]
  → [Ψ ⊢ syn Δ M C] =
  / total 1 /
  fn sy ⇒ syn_del sy [_ ⊢ del/t _]
  ;

% Weakening lemmas:
% (1) If Δ ⊢ e ⟸ A, then (Δ, x :⁰ B) ⊢ e ⟸ A for any x, B
% (2) If Δ ⊢ e ⟹ A, then (Δ, x :⁰ B) ⊢ e ⟹ A for any x, B

rec chk_weak : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ chk Δ M C]
  → {X:[Ψ ⊢ obj]} {A:[ ⊢ tp]} [Ψ ⊢ chk (cons Δ X A[] 𝟘) M C] =
  / total 1 /
  fn ch1 ⇒ mlam X, A ⇒
  case ch1 of
  | [_ ⊢ conv SY1] ⇒ let [_ ⊢ SY2] = syn_weak [_ ⊢ SY1] [_ ⊢ X] [ ⊢ A] in
    [_ ⊢ conv SY2]
  | [_ ⊢ I① E1] ⇒ [_ ⊢ I① (exh/c E1 hal/0)]
  | [_ ⊢ E① SY1 CH1 M1] ⇒
    let [_ ⊢ SY2] = syn_weak [_ ⊢ SY1] [_ ⊢ X] [ ⊢ A] in
    let [_ ⊢ CH2] = chk_weak [_ ⊢ CH1] [_ ⊢ X] [ ⊢ A] in
    [_ ⊢ E① SY2 CH2 (mg/c M1 •/00)]
  | [_ ⊢ I⊗ CH1 CH2 M1] ⇒
    let [_ ⊢ CH3] = chk_weak [_ ⊢ CH1] [_ ⊢ X] [ ⊢ A] in
    let [_ ⊢ CH4] = chk_weak [_ ⊢ CH2] [_ ⊢ X] [ ⊢ A] in
    [_ ⊢ I⊗ CH3 CH4 (mg/c M1 •/00)]
  | [_ ⊢ E⊗ SY1 (\x.\y.CH1) M1] ⇒
    let [_ ⊢ SY2] = syn_weak [_ ⊢ SY1] [_ ⊢ X] [ ⊢ A] in
    let [_,x:obj,y:obj ⊢ CH1'] =
      chk_exch_top2 (chk_exch_top2
        (chk_weak [_,x:obj,y:obj ⊢ CH1] [_,x:obj,y:obj ⊢ X[..]] [ ⊢ A])) in
    [_ ⊢ E⊗ SY2 (\x.\y.CH1') (mg/c M1 •/00)]
  | [_ ⊢ I-o \x.CH1] ⇒
    let [_,x:obj ⊢ CH2] =
      chk_exch_top (chk_weak [_,x:obj ⊢ CH1] [_,x:obj ⊢ X[..]] [ ⊢ A]) in
    [_ ⊢ I-o \x.CH2]
  | [_ ⊢ I& CH1 CH2] ⇒
    let [_ ⊢ CH3] = chk_weak [_ ⊢ CH1] [_ ⊢ X] [ ⊢ A] in
    let [_ ⊢ CH4] = chk_weak [_ ⊢ CH2] [_ ⊢ X] [ ⊢ A] in
    [_ ⊢ I& CH3 CH4]
  | [_ ⊢ I⊕1 CH1] ⇒ let [_ ⊢ CH2] = chk_weak [_ ⊢ CH1] [_ ⊢ X] [ ⊢ A] in
    [_ ⊢ I⊕1 CH2]
  | [_ ⊢ I⊕2 CH1] ⇒ let [_ ⊢ CH2] = chk_weak [_ ⊢ CH1] [_ ⊢ X] [ ⊢ A] in
    [_ ⊢ I⊕2 CH2]
  | [_ ⊢ E⊕ SY1 (\x.CH1) (\x.CH2) M1] ⇒
    let [_ ⊢ SY2] = syn_weak [_ ⊢ SY1] [_ ⊢ X] [ ⊢ A] in
    let [_,x:obj ⊢ CH1'] =
      chk_exch_top (chk_weak [_,x:obj ⊢ CH1] [_,x:obj ⊢ X[..]] [ ⊢ A]) in
    let [_,x:obj ⊢ CH2'] =
      chk_exch_top (chk_weak [_,x:obj ⊢ CH2] [_,x:obj ⊢ X[..]] [ ⊢ A]) in
    [_ ⊢ E⊕ SY2 (\x.CH1') (\x.CH2') (mg/c M1 •/00)]

and rec syn_weak : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ syn Δ M C]
  → {X:[Ψ ⊢ obj]} {A:[ ⊢ tp]} [Ψ ⊢ syn (cons Δ X A[] 𝟘) M C] =
  / total 1 /
  fn sy ⇒ mlam X, A ⇒
  case sy of
  | [_ ⊢ coe CH1] ⇒ let [_ ⊢ CH2] = chk_weak [_ ⊢ CH1] [_ ⊢ X] [ ⊢ A] in
    [_ ⊢ coe CH2]
  | [_ ⊢ init U1 E1] ⇒ [_ ⊢ init (upd/n U1) (exh/c E1 hal/0)]
  | [_ ⊢ E-o SY1 CH1 M1] ⇒
    let [_ ⊢ SY2] = syn_weak [_ ⊢ SY1] [_ ⊢ X] [ ⊢ A] in
    let [_ ⊢ CH2] = chk_weak [_ ⊢ CH1] [_ ⊢ X] [ ⊢ A] in
    [_ ⊢ E-o SY2 CH2 (mg/c M1 •/00)]
  | [_ ⊢ E&1 SY1] ⇒ let [_ ⊢ SY2] = syn_weak [_ ⊢ SY1] [_ ⊢ X] [ ⊢ A] in
    [_ ⊢ E&1 SY2]
  | [_ ⊢ E&2 SY1] ⇒ let [_ ⊢ SY2] = syn_weak [_ ⊢ SY1] [_ ⊢ X] [ ⊢ A] in
    [_ ⊢ E&2 SY2]
  ;

%------------------------------------------------------%
% Substitution lemmas
%------------------------------------------------------%

% Substitution lemma:
% (1) If (a) Δ₁ ⊢ e ⟸ C, (b) x :¹ A is the k-th entry of Δ₁, and the rest of
%     Δ₁, written Δ₁', does not mention x, (c) Δ₂ ⊢ s ⟹ A, and (d)
%     Δ₁' ⋈ Δ₂ = Δ, then Δ ⊢ e[s/x] ⟸ C
% (2) As above, for ⟹.

rec subst_chk_gen : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ,x:obj ⊢ chk Δ₁ e C[]]
  → [Ψ,x:obj ⊢ upd Δ₁ k[] x x A[] A[] 𝟙 𝟘 Δ₁⁰]
  → [Ψ,x:obj ⊢ del Δ₁⁰ k[] Δ₁'[..]]
  → [Ψ ⊢ syn Δ₂ s A[]]
  → [Ψ ⊢ merge Δ₁' Δ₂ Δ]
  → [Ψ ⊢ chk Δ e[..,s] C[]] =
  / total 1 /
  fn ch1, u, dl, sy2, mg ⇒
  let [_ ⊢ SY] = sy2 in
  let [_ ⊢ M] = mg in
  let [_,x:obj ⊢ U] = u in
  let [_,x:obj ⊢ DL] = dl in
  case ch1 of
  | [_,x:obj ⊢ conv SY1] ⇒
    let [_ ⊢ SY2] = subst_syn_gen [_,x:obj ⊢ SY1] u dl sy2 mg in
    [_ ⊢ conv SY2]
  | [_,x:obj ⊢ I① E] ⇒ impossible exh_lookup [_,x:obj ⊢ E] u
  | [_,x:obj ⊢ E① SY1 CH1 M1] ⇒
    let [_,x:obj ⊢ merge-upd Ua Ub T[] M1⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M1] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M1' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M1⁰] in
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1'] in
    (case [ ⊢ T] of
    | [ ⊢ •/10] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ub] in
      let [_,x:obj ⊢ CH1s] = chk_del [_,x:obj ⊢ CH1] [_,x:obj ⊢ DLb] in
      let Prune-Chk [_ ⊢ CH1'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH1s] in
      let [_ ⊢ merge-assoc2 M3 M4 _ _] = merge_assoc_swap [_ ⊢ M] [_ ⊢ M2] in
      let [_ ⊢ SY1'] = subst_syn_gen [_,x:obj ⊢ SY1] [_,x:obj ⊢ Ua]
        [_,x:obj ⊢ DLa] sy2 [_ ⊢ M3] in
      [_ ⊢ E① SY1' CH1' M4]
    | [ ⊢ •/01] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ua] in
      let [_,x:obj ⊢ SY1s] = syn_del [_,x:obj ⊢ SY1] [_,x:obj ⊢ DLa] in
      let Prune-Syn [_ ⊢ SY1'] [_,x:obj ⊢ _] = prune_syn [_,x:obj ⊢ SY1s] in
      let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2] in
      let [_ ⊢ CH1'] = subst_chk_gen [_,x:obj ⊢ CH1] [_,x:obj ⊢ Ub]
        [_,x:obj ⊢ DLb] sy2 [_ ⊢ M3] in
      [_ ⊢ E① SY1' CH1' M4]
    )
  | [_,x:obj ⊢ I⊗ CH1a CH1b M1] ⇒
    let [_,x:obj ⊢ merge-upd Ua Ub T[] M1⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M1] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M1' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M1⁰] in
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1'] in
    (case [ ⊢ T] of
    | [ ⊢ •/10] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ub] in
      let [_,x:obj ⊢ CH1bs] = chk_del [_,x:obj ⊢ CH1b] [_,x:obj ⊢ DLb] in
      let Prune-Chk [_ ⊢ CH1b'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH1bs] in
      let [_ ⊢ merge-assoc2 M3 M4 _ _] = merge_assoc_swap [_ ⊢ M] [_ ⊢ M2] in
      let [_ ⊢ CH1a'] = subst_chk_gen [_,x:obj ⊢ CH1a] [_,x:obj ⊢ Ua]
        [_,x:obj ⊢ DLa] sy2 [_ ⊢ M3] in
      [_ ⊢ I⊗ CH1a' CH1b' M4]
    | [ ⊢ •/01] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ua] in
      let [_,x:obj ⊢ CH1as] = chk_del [_,x:obj ⊢ CH1a] [_,x:obj ⊢ DLa] in
      let Prune-Chk [_ ⊢ CH1a'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH1as] in
      let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2] in
      let [_ ⊢ CH1b'] = subst_chk_gen [_,x:obj ⊢ CH1b] [_,x:obj ⊢ Ub]
        [_,x:obj ⊢ DLb] sy2 [_ ⊢ M3] in
      [_ ⊢ I⊗ CH1a' CH1b' M4]
    )
  | [_,x:obj ⊢ E⊗ SY1 (\y.\z.CH1[..,y,z,x]) M1] ⇒
    let [_,x:obj ⊢ merge-upd Ua Ub T[] M1⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M1] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M1' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M1⁰] in
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1'] in
    (case [ ⊢ T] of
    | [ ⊢ •/10] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ub] in
      let [_,y:obj,z:obj,x:obj ⊢ CH1s] =
        chk_del [_,y:obj,z:obj,x:obj ⊢ CH1]
          [_,y:obj,z:obj,x:obj ⊢ del/n (del/n DLb[..,x])] in
      let Prune-Chk [_,y:obj,z:obj ⊢ CH1'] [_,y:obj,z:obj,x:obj ⊢ _] =
        prune_chk [_,y:obj,z:obj,x:obj ⊢ CH1s] in
      let [_ ⊢ merge-assoc2 M3 M4 _ _] = merge_assoc_swap [_ ⊢ M] [_ ⊢ M2] in
      let [_ ⊢ SY1'] = subst_syn_gen [_,x:obj ⊢ SY1] [_,x:obj ⊢ Ua]
        [_,x:obj ⊢ DLa] sy2 [_ ⊢ M3] in
      [_ ⊢ E⊗ SY1' (\y.\z.CH1') M4]
    | [ ⊢ •/01] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ua] in
      let [_,x:obj ⊢ SY1s] = syn_del [_,x:obj ⊢ SY1] [_,x:obj ⊢ DLa] in
      let Prune-Syn [_ ⊢ SY1'] [_,x:obj ⊢ _] = prune_syn [_,x:obj ⊢ SY1s] in
      let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2] in
      let [_,y:obj,z:obj ⊢ CH1'] =
        subst_chk_gen [_,y:obj,z:obj,x:obj ⊢ CH1]
          [_,y:obj,z:obj,x:obj ⊢ upd/n (upd/n Ub[..,x])]
          [_,y:obj,z:obj,x:obj ⊢ del/n (del/n DLb[..,x])]
          (syn_weak (syn_weak [_,y:obj,z:obj ⊢ SY[..]] [_,y:obj,z:obj ⊢ y]
            [ ⊢ _]) [_,y:obj,z:obj ⊢ z] [ ⊢ _])
          [_,y:obj,z:obj ⊢ mg/c (mg/c M3[..] •/10) •/10] in
      [_ ⊢ E⊗ SY1' (\y.\z.CH1') M4]
    )
  | [_,x:obj ⊢ I-o \y.CH1[..,y,x]] ⇒
    let [_,y:obj ⊢ CH1'] =
      subst_chk_gen [_,y:obj,x:obj ⊢ CH1] [_,y:obj,x:obj ⊢ upd/n U[..,x]]
        [_,y:obj,x:obj ⊢ del/n DL[..,x]]
        (syn_weak [_,y:obj ⊢ SY[..]] [_,y:obj ⊢ y] [ ⊢ _])
        [_,y:obj ⊢ mg/c M[..] •/10] in
    [_ ⊢ I-o \y.CH1']
  | [_,x:obj ⊢ I& CH1a CH1b] ⇒
    let [_ ⊢ CH3] = subst_chk_gen [_,x:obj ⊢ CH1a] u dl sy2 mg in
    let [_ ⊢ CH4] = subst_chk_gen [_,x:obj ⊢ CH1b] u dl sy2 mg in
    [_ ⊢ I& CH3 CH4]
  | [_,x:obj ⊢ I⊕1 CH1] ⇒
    let [_ ⊢ CH3] = subst_chk_gen [_,x:obj ⊢ CH1] u dl sy2 mg in
    [_ ⊢ I⊕1 CH3]
  | [_,x:obj ⊢ I⊕2 CH1] ⇒
    let [_ ⊢ CH3] = subst_chk_gen [_,x:obj ⊢ CH1] u dl sy2 mg in
    [_ ⊢ I⊕2 CH3]
  | [_,x:obj ⊢ E⊕ SY1 (\y.CH1a[..,y,x]) (\y.CH1b[..,y,x]) M1] ⇒
    let [_,x:obj ⊢ merge-upd Ua Ub T[] M1⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M1] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M1' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M1⁰] in
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1'] in
    (case [ ⊢ T] of
    | [ ⊢ •/10] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ub] in
      let [_,y:obj,x:obj ⊢ CH1as] =
        chk_del [_,y:obj,x:obj ⊢ CH1a] [_,y:obj,x:obj ⊢ del/n DLb[..,x]] in
      let Prune-Chk [_,y:obj ⊢ CH1a'] [_,y:obj,x:obj ⊢ _] =
        prune_chk [_,y:obj,x:obj ⊢ CH1as] in
      let [_,y:obj,x:obj ⊢ CH1bs] =
        chk_del [_,y:obj,x:obj ⊢ CH1b] [_,y:obj,x:obj ⊢ del/n DLb[..,x]] in
      let Prune-Chk [_,y:obj ⊢ CH1b'] [_,y:obj,x:obj ⊢ _] =
        prune_chk [_,y:obj,x:obj ⊢ CH1bs] in
      let [_ ⊢ merge-assoc2 M3 M4 _ _] = merge_assoc_swap [_ ⊢ M] [_ ⊢ M2] in
      let [_ ⊢ SY1'] = subst_syn_gen [_,x:obj ⊢ SY1] [_,x:obj ⊢ Ua]
        [_,x:obj ⊢ DLa] sy2 [_ ⊢ M3] in
      [_ ⊢ E⊕ SY1' (\y.CH1a') (\y.CH1b') M4]
    | [ ⊢ •/01] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ua] in
      let [_,x:obj ⊢ SY1s] = syn_del [_,x:obj ⊢ SY1] [_,x:obj ⊢ DLa] in
      let Prune-Syn [_ ⊢ SY1'] [_,x:obj ⊢ _] = prune_syn [_,x:obj ⊢ SY1s] in
      let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2] in
      let [_,y:obj ⊢ CH1a'] =
        subst_chk_gen [_,y:obj,x:obj ⊢ CH1a]
          [_,y:obj,x:obj ⊢ upd/n Ub[..,x]] [_,y:obj,x:obj ⊢ del/n DLb[..,x]]
          (syn_weak [_,y:obj ⊢ SY[..]] [_,y:obj ⊢ y] [ ⊢ _])
          [_,y:obj ⊢ mg/c M3[..] •/10] in
      let [_,y:obj ⊢ CH1b'] =
        subst_chk_gen [_,y:obj,x:obj ⊢ CH1b]
          [_,y:obj,x:obj ⊢ upd/n Ub[..,x]] [_,y:obj,x:obj ⊢ del/n DLb[..,x]]
          (syn_weak [_,y:obj ⊢ SY[..]] [_,y:obj ⊢ y] [ ⊢ _])
          [_,y:obj ⊢ mg/c M3[..] •/10] in
      [_ ⊢ E⊕ SY1' (\y.CH1a') (\y.CH1b') M4]
    )

and rec subst_syn_gen : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ,x:obj ⊢ syn Δ₁ e C[]]
  → [Ψ,x:obj ⊢ upd Δ₁ k[] x x A[] A[] 𝟙 𝟘 Δ₁⁰]
  → [Ψ,x:obj ⊢ del Δ₁⁰ k[] Δ₁'[..]]
  → [Ψ ⊢ syn Δ₂ s A[]]
  → [Ψ ⊢ merge Δ₁' Δ₂ Δ]
  → [Ψ ⊢ syn Δ e[..,s] C[]] =
  / total 1 /
  fn sy1, u, dl, sy2, mg ⇒
  let [_ ⊢ M] = mg in
  let [_,x:obj ⊢ U] = u in
  let [_,x:obj ⊢ DL] = dl in
  case sy1 of
  | [_,x:obj ⊢ coe CH1] ⇒
    let [_ ⊢ CH2] = subst_chk_gen [_,x:obj ⊢ CH1] u dl sy2 mg in
    [_ ⊢ coe CH2]
  | [_,x:obj ⊢ init U1 E1] ⇒
    (case comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ U] [_,x:obj ⊢ U1] in
      let [_,x:obj ⊢ E2] = del_exh [_,x:obj ⊢ DL] [_,x:obj ⊢ E1] in
      let [_ ⊢ ctx/refl] =
        merge_id mult_halident mg (prune_exh [_,x:obj ⊢ E2]) in
      sy2
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ lookintm U2] =
        lookup_upd [_,x:obj ⊢ U1] [_,x:obj ⊢ U] (neq_comm [ ⊢ NEQ]) in
      impossible exh_lookup [_,x:obj ⊢ E1] [_,x:obj ⊢ U2]
    )
  | [_,x:obj ⊢ E-o SY1 CH1 M1] ⇒
    let [_,x:obj ⊢ merge-upd Ua Ub T[] M1⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M1] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M1' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M1⁰] in
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1'] in
    (case [ ⊢ T] of
    | [ ⊢ •/10] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ub] in
      let [_,x:obj ⊢ CH1s] = chk_del [_,x:obj ⊢ CH1] [_,x:obj ⊢ DLb] in
      let Prune-Chk [_ ⊢ CH1'] [_,x:obj ⊢ _] = prune_chk [_,x:obj ⊢ CH1s] in
      let [_ ⊢ merge-assoc2 M3 M4 _ _] = merge_assoc_swap [_ ⊢ M] [_ ⊢ M2] in
      let [_ ⊢ SY1'] = subst_syn_gen [_,x:obj ⊢ SY1] [_,x:obj ⊢ Ua]
        [_,x:obj ⊢ DLa] sy2 [_ ⊢ M3] in
      [_ ⊢ E-o SY1' CH1' M4]
    | [ ⊢ •/01] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ua] in
      let [_,x:obj ⊢ SY1s] = syn_del [_,x:obj ⊢ SY1] [_,x:obj ⊢ DLa] in
      let Prune-Syn [_ ⊢ SY1'] [_,x:obj ⊢ _] = prune_syn [_,x:obj ⊢ SY1s] in
      let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M] [_ ⊢ M2] in
      let [_ ⊢ CH1'] = subst_chk_gen [_,x:obj ⊢ CH1] [_,x:obj ⊢ Ub]
        [_,x:obj ⊢ DLb] sy2 [_ ⊢ M3] in
      [_ ⊢ E-o SY1' CH1' M4]
    )
  | [_,x:obj ⊢ E&1 SY1] ⇒
    let [_ ⊢ SY2] = subst_syn_gen [_,x:obj ⊢ SY1] u dl sy2 mg in
    [_ ⊢ E&1 SY2]
  | [_,x:obj ⊢ E&2 SY1] ⇒
    let [_ ⊢ SY2] = subst_syn_gen [_,x:obj ⊢ SY1] u dl sy2 mg in
    [_ ⊢ E&2 SY2]
  ;

% Substitution lemma:
% (1) If (Δ₁, x :¹ A) ⊢ e ⟸ C, Δ₂ ⊢ s ⟹ A, and Δ₁ ⋈ Δ₂ = Δ, then
%     Δ ⊢ e[s/x] ⟸ C
% (2) As above, for ⟹

rec subst_chk : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ,x:obj ⊢ chk (cons Δ₁[..] x A[] 𝟙) e C[]]
  → [Ψ ⊢ syn Δ₂ s A[]]
  → [Ψ ⊢ merge Δ₁ Δ₂ Δ]
  → [Ψ ⊢ chk Δ e[..,s] C[]] =
  / total 1 /
  fn ch1, sy2, mg ⇒
  subst_chk_gen ch1 [_,x:obj ⊢ upd/t _] [_,x:obj ⊢ del/t _] sy2 mg
  ;

rec subst_syn : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ,x:obj ⊢ syn (cons Δ₁[..] x A[] 𝟙) e C[]]
  → [Ψ ⊢ syn Δ₂ s A[]]
  → [Ψ ⊢ merge Δ₁ Δ₂ Δ]
  → [Ψ ⊢ syn Δ e[..,s] C[]] =
  / total 1 /
  fn sy1, sy2, mg ⇒
  subst_syn_gen sy1 [_,x:obj ⊢ upd/t _] [_,x:obj ⊢ del/t _] sy2 mg
  ;
