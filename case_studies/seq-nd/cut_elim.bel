%======================================================%
% Cut elimination for the linear sequent calculus
%======================================================%

% Admissibility of cut in the cut-free sequent calculus:
% If Δ₁ ⊢ A, (Δ₂, x :¹ A) ⊢ C, and Δ₁ ⋈ Δ₂ = Δ, then Δ ⊢ C

rec cut_admis : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ seq_cf Δ₁ A[]]
  → [Ψ,x:obj ⊢ seq_cf (cons Δ₂[..] x A[] 𝟙) C[]]
  → [Ψ ⊢ merge Δ₁ Δ₂ Δ]
  → [Ψ ⊢ seq_cf Δ C[]] =
  % Remark: Beluga's totality checker cannot check termination in this case because
  % the cut formula is implicit and the helpers (seqcf_weak, seqcf_exch_top, etc.)
  % preserve inference height without recording it in their types.
  / trust /
  fn s1, s2, mg ⇒
  let ([_ ⊢ M1],[_ ⊢ M1_comm]) = (mg,merge_comm mg) in
  let ([_ ⊢ S1],[_,x:obj ⊢ S2]) = (s1,s2) in
  case (s1,s2) of
  % Axiom cases
  | ([_ ⊢ hyp_cf U1 E1],[_,x:obj ⊢ _]) ⇒
    %{
    Sketch of case:
          exh(Δ₁[Y :¹ A ↦ Y :⁰ A])
    s1 = --------------------------, s2 arbitrary
             Δ₁ ⇒ A

    - Δ₁[Y :¹ A ↦ Y :⁰ A] ⋈ Δ₂ = Δ[Y :¹ A ↦ Y :⁰ A] by merge_upd_cor_l
      (using upd_func, upd_symm to show that Δ₂[Y :⁰ A ↦ Y :⁰ A] ≡ Δ₂)
    - Δ[Y :¹ A ↦ Y :⁰ A] = Δ₂ by merge_id, since exh(Δ₁[Y :¹ A ↦ Y :⁰ A])
    - Δ ⇒ C by seqcf_rename
    }%
    let [_ ⊢ merge-upd2 U2 U3 •/10 M2 _ _ _] =
      merge_upd_cor_l [_ ⊢ U1] [_ ⊢ M1] [ ⊢ •/00] in
    let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
    let [_ ⊢ ctx/refl] = merge_id mult_halident [_ ⊢ M2] [_ ⊢ E1] in
    seqcf_rename s2 (upd_symm [_ ⊢ U3])
  | ([_ ⊢ _],[_,x:obj ⊢ hyp_cf U1 E1]) ⇒
    %{
    Sketch of case:
          exh((Δ₂, x :¹ A)[Y :¹ C ↦ Y :⁰ C])
    s2 = ------------------------------------, s1 arbitrary
             Δ₂ ⇒ C

    Subcase: x = Y
    - exh(Δ₂) by definition, so Δ₁ = Δ by merge_id_r
    - Δ ⇒ A by assumption

    Subcase: x ≠ Y
    - (x :¹ A) ∈ Δ₂[Y :¹ A ↦ Y :⁰ A]
    - ↯ by definition of exh
    }%
    (case [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ upd/t _] ⇒
      let [_,x:obj ⊢ exh/c E2 _] = [_,x:obj ⊢ E1] in
      let [_ ⊢ ctx/refl] = merge_id_r mult_halident mg (prune_exh [_ ⊢ E2]) in
      s1
    | [_,x:obj ⊢ upd/n _] ⇒
      let [_,x:obj ⊢ exh/c _ H[]] = [_,x:obj ⊢ E1] in
      impossible [ ⊢ H]
    )
  % Commutative cases
  | ([_ ⊢ L①_cf U1 SQ1],[_,x:obj ⊢ _]) ⇒
    let [_ ⊢ merge-upd2 U2 U3 •/10 M2 _ _ _] =
      merge_upd_cor_l [_ ⊢ U1] [_ ⊢ M1] [ ⊢ •/00] in
    let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
    let [_ ⊢ SQ3] = cut_admis [_ ⊢ SQ1] s2 [_ ⊢ M2] in
    [_ ⊢ L①_cf U3 SQ3]
  | ([_ ⊢ L⊗_cf U1 \x.\y.SQ1],[_,x:obj ⊢ _]) ⇒
    let [_ ⊢ merge-upd2 U2 U3 •/10 M2 _ _ _] =
      merge_upd_cor_l [_ ⊢ U1] [_ ⊢ M1] [ ⊢ •/00] in
    let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
    let [_,x:obj,y:obj ⊢ SQ3] = cut_admis [_,x:obj,y:obj ⊢ SQ1]
      (seqcf_weak_cor (seqcf_weak_cor s2 [ ⊢ _]) [ ⊢ _])
      [_,x:obj,y:obj ⊢ mg/c (mg/c M2[..] •/10) •/10] in
    [_ ⊢ L⊗_cf U3 \x.\y.SQ3]
  | ([_ ⊢ L-o_cf U1 M2 SQ1 \x.SQ2],[_,x:obj ⊢ _]) ⇒
    let [_ ⊢ merge-upd2 U2 U3 •/10 M1' _ _ _] =
      merge_upd_cor_l [_ ⊢ U1] [_ ⊢ M1] [ ⊢ •/00] in
    let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
    let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M1'] [_ ⊢ M2] in
    let [_,x:obj ⊢ SQ3] = cut_admis [_,x:obj ⊢ SQ2]
      (seqcf_weak_cor s2 [ ⊢ _])
      [_,x:obj ⊢ mg/c M3[..] •/10] in
    [_ ⊢ L-o_cf U3 M4 SQ1 \x.SQ3]
  | ([_ ⊢ L&1_cf U1 \x.SQ1],[_,x:obj ⊢ _]) ⇒
    let [_ ⊢ merge-upd2 U2 U3 •/10 M2 _ _ _] =
      merge_upd_cor_l [_ ⊢ U1] [_ ⊢ M1] [ ⊢ •/00] in
    let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
    let [_,x:obj ⊢ SQ2] = cut_admis [_,x:obj ⊢ SQ1]
      (seqcf_weak_cor s2 [ ⊢ _])
      [_,x:obj ⊢ mg/c M2[..] •/10] in
    [_ ⊢ L&1_cf U3 \x.SQ2]
  | ([_ ⊢ L&2_cf U1 \x.SQ1],[_,x:obj ⊢ _]) ⇒
    let [_ ⊢ merge-upd2 U2 U3 •/10 M2 _ _ _] =
      merge_upd_cor_l [_ ⊢ U1] [_ ⊢ M1] [ ⊢ •/00] in
    let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
    let [_,x:obj ⊢ SQ2] = cut_admis [_,x:obj ⊢ SQ1]
      (seqcf_weak_cor s2 [ ⊢ _])
      [_,x:obj ⊢ mg/c M2[..] •/10] in
    [_ ⊢ L&2_cf U3 \x.SQ2]
  | ([_ ⊢ L⊕_cf U1 (\x.SQ1) (\x.SQ2)],[_,x:obj ⊢ _]) ⇒
    let [_ ⊢ merge-upd2 U2 U3 •/10 M2 _ _ _] =
      merge_upd_cor_l [_ ⊢ U1] [_ ⊢ M1] [ ⊢ •/00] in
    let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
    let [_,x:obj ⊢ SQ1'] = cut_admis [_,x:obj ⊢ SQ1]
      (seqcf_weak_cor s2 [ ⊢ _])
      [_,x:obj ⊢ mg/c M2[..] •/10] in
    let [_,x:obj ⊢ SQ2'] = cut_admis [_,x:obj ⊢ SQ2]
      (seqcf_weak_cor s2 [ ⊢ _])
      [_,x:obj ⊢ mg/c M2[..] •/10] in
    [_ ⊢ L⊕_cf U3 (\x.SQ1') (\x.SQ2')]
  | ([_ ⊢ _],[_,x:obj ⊢ R①_cf E]) ⇒
      let [_,x:obj ⊢ exh/c _ H[]] = [_,x:obj ⊢ E] in
      impossible [ ⊢ H]
  | ([_ ⊢ _],[_,x:obj ⊢ R⊗_cf SQ1 SQ2 (mg/c M2' T[])]) ⇒
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M2'] in
    (case [ ⊢ T] of
    | [ ⊢ •/10] ⇒
      let [_ ⊢ merge-assoc2 M3 M4 _ _] =
        merge_assoc_swap [_ ⊢ M1_comm] [_ ⊢ M2] in
      let [_ ⊢ SQ3] = prune_seq_cf (seqcf_str [_,x:obj ⊢ SQ2]) in
      let [_ ⊢ SQ4] = cut_admis s1 [_,x:obj ⊢ SQ1] (merge_comm [_ ⊢ M3]) in
      [_ ⊢ R⊗_cf SQ4 SQ3 M4]
    | [ ⊢ •/01] ⇒
      let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M1_comm] [_ ⊢ M2] in
      let [_ ⊢ SQ3] = prune_seq_cf (seqcf_str [_,x:obj ⊢ SQ1]) in
      let [_ ⊢ SQ4] = cut_admis s1 [_,x:obj ⊢ SQ2] (merge_comm [_ ⊢ M3]) in
      [_ ⊢ R⊗_cf SQ3 SQ4 M4]
    )
  | ([_ ⊢ _],[_,x:obj ⊢ R-o_cf \y.SQ1]) ⇒
    let [_,x:obj ⊢ SQ2] = cut_admis
      (seqcf_weak [_,x:obj ⊢ S1[..]] [_ ⊢ _] [ ⊢ _])
      (seqcf_exch_top [_,y:obj,x:obj ⊢ SQ1[..,x,y]])
        [_,x:obj ⊢ mg/c M1[..] •/01] in
    [_ ⊢ R-o_cf \x.SQ2]
  | ([_ ⊢ _],[_,x:obj ⊢ R&_cf SQ1 SQ2]) ⇒
    let [_ ⊢ SQ3] = cut_admis s1 [_,x:obj ⊢ SQ1] mg in
    let [_ ⊢ SQ4] = cut_admis s1 [_,x:obj ⊢ SQ2] mg in
    [_ ⊢ R&_cf SQ3 SQ4]
  | ([_ ⊢ _],[_,x:obj ⊢ R⊕1_cf SQ1]) ⇒
    let [_ ⊢ SQ1'] = cut_admis s1 [_,x:obj ⊢ SQ1] mg in
    [_ ⊢ R⊕1_cf SQ1']
  | ([_ ⊢ _],[_,x:obj ⊢ R⊕2_cf SQ1]) ⇒
    let [_ ⊢ SQ1'] = cut_admis s1 [_,x:obj ⊢ SQ1] mg in
    [_ ⊢ R⊕2_cf SQ1']
  % Principal cases
  | ([_ ⊢ _],[_,x:obj ⊢ L①_cf U1 SQ1]) ⇒
    (case [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ upd/t _] ⇒ unit_lemma_cf s1
      (prune_seq_cf (seqcf_str [_,x:obj ⊢ SQ1])) mg
    | [_,x:obj ⊢ upd/n U1'] ⇒
      let Prune-Upd [_ ⊢ U1''] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1'] in
      let [_ ⊢ merge-upd2 U2 U3 •/10 M2 _ _ _] =
        merge_upd_cor_l [_ ⊢ U1''] [_ ⊢ M1_comm] [ ⊢ •/00] in
      let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
      let [_ ⊢ SQ2] = cut_admis s1 [_,x:obj ⊢ SQ1] (merge_comm [_ ⊢ M2]) in
      [_ ⊢ L①_cf U3 SQ2]
    )
  | ([_ ⊢ _],[_,x:obj ⊢ L⊗_cf U1 \y.\z.SQ1]) ⇒
    (case [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ upd/t _] ⇒
      let [_ ⊢ R⊗_cf SQ2 SQ3 M2] = s1 in
      % left and hyp rules already covered, others impossible
      let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M1] [_ ⊢ M2] in
      let SQ4' = cut_admis (seqcf_weak [_,x:obj ⊢ SQ3[..]] [_ ⊢ _] [ ⊢ _])
        (prune_seq_cf (seqcf_str (seqcf_exch_top2 [_,x:obj,y:obj,z:obj ⊢
          SQ1[..,z,x,y]]))) [_,x:obj ⊢ mg/c M3[..] •/01] in
      cut_admis [_ ⊢ SQ2] SQ4' [_ ⊢ M4]
    | [_,x:obj ⊢ upd/n U1'] ⇒
      let Prune-Upd [_ ⊢ U1''] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1'] in
      let [_ ⊢ merge-upd2 U2 U3 •/10 M2_comm _ _ _] =
        merge_upd_cor_l [_ ⊢ U1''] [_ ⊢ M1_comm] [ ⊢ •/00] in
      let [_ ⊢ M2] = merge_comm [_ ⊢ M2_comm] in
      let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
      let [_,x:obj,y:obj ⊢ SQ2[..,y,x]] = cut_admis
        (seqcf_weak (seqcf_weak
          [_,x:obj,y:obj ⊢ S1[..]] [_ ⊢ _] [ ⊢ _]) [_ ⊢ _] [ ⊢ _])
        (seqcf_exch_top2 [_,x:obj,y:obj,z:obj ⊢ SQ1[..,z,y,x]])
          [_ ⊢ mg/c (mg/c M2[..] •/01) •/01] in
      [_ ⊢ L⊗_cf U3 \x.\y.SQ2]
    )
  | ([_ ⊢ _],[_,x:obj ⊢ L-o_cf U1 M2 SQ1 \y.SQ2]) ⇒
    (case [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ upd/t _] ⇒
      let [_,x:obj ⊢ mg/c M2'' •/00] = [_,x:obj ⊢ M2] in
      let Prune-Merge [_ ⊢ M2'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M2''] in
      let [_ ⊢ merge-assoc2 M3 M4 _ _] =
        merge_assoc_swap [_ ⊢ M1_comm] [_ ⊢ M2'] in
      let [_ ⊢ R-o_cf \x.SQ3] = s1 in
        % left and hyp rules already covered, others impossible
      let SQ4 = cut_admis (prune_seq_cf (seqcf_str [_,x:obj ⊢ SQ1]))
        [_,x:obj ⊢ SQ3] [_ ⊢ M3] in
      cut_admis SQ4
        (seqcf_str_cor [_,x:obj,y:obj ⊢ SQ2]) [_ ⊢ M4]
    | [_,x:obj ⊢ upd/n U1'] ⇒
      let Prune-Upd [_ ⊢ U1''] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1'] in
      let [_ ⊢ merge-upd2 U2 U3 •/10 M3 _ _ _] =
        merge_upd_cor_l [_ ⊢ U1''] [_ ⊢ M1_comm] [ ⊢ •/00] in
      let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
      let [_,x:obj ⊢ mg/c M2'' T[]] = [_,x:obj ⊢ M2] in
      let Prune-Merge [_ ⊢ M2'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M2''] in
      (case [ ⊢ T] of
      | [ ⊢ •/10] ⇒
        let [_ ⊢ merge-assoc2 M4 M5 _ _] =
          merge_assoc_swap [_ ⊢ M3] [_ ⊢ M2'] in
        let [_,x:obj ⊢ SQ2'] = seqcf_str_cor [_,x:obj,y:obj ⊢ SQ2] in
        let [_ ⊢ SQ3] = cut_admis s1 [_,x:obj ⊢ SQ1] (merge_comm [_ ⊢ M4]) in
        [_ ⊢ L-o_cf U3 M5 SQ3 \x.SQ2']
      | [ ⊢ •/01] ⇒
        let [_ ⊢ merge-assoc M4_comm M5 _ _] = merge_assoc [_ ⊢ M3] [_ ⊢ M2'] in
        let [_ ⊢ M4] = merge_comm [_ ⊢ M4_comm] in
        let [_ ⊢ SQ1'] = prune_seq_cf (seqcf_str [_,x:obj ⊢ SQ1]) in
        let [_,x:obj ⊢ SQ3] = cut_admis
          (seqcf_weak [_,x:obj ⊢ S1[..]] [_ ⊢ _] [ ⊢ _])
          (seqcf_exch_top [_,x:obj,y:obj ⊢ SQ2[..,y,x]])
            [_,x:obj ⊢ mg/c M4[..] •/01] in
        [_ ⊢ L-o_cf U3 M5 SQ1' \x.SQ3]
      )
    )
  | ([_ ⊢ _],[_,x:obj ⊢ L&1_cf U1 \y.SQ1]) ⇒
    (case [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ upd/t _] ⇒
      let [_ ⊢ R&_cf SQ2 _] = s1 in
      % left and hyp rules already covered, others impossible
      cut_admis [_ ⊢ SQ2]
        (seqcf_str_cor [_,x:obj,y:obj ⊢ SQ1]) mg
    | [_,x:obj ⊢ upd/n U1'] ⇒
      let Prune-Upd [_ ⊢ U1''] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1'] in
      let [_ ⊢ merge-upd2 U2 U3 •/10 M2_comm _ _ _] =
        merge_upd_cor_l [_ ⊢ U1''] [_ ⊢ M1_comm] [ ⊢ •/00] in
      let [_ ⊢ M2] = merge_comm [_ ⊢ M2_comm] in
      let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
      let [_,x:obj ⊢ SQ3] = cut_admis
        (seqcf_weak [_,x:obj ⊢ S1[..]] [_ ⊢ _] [ ⊢ _])
        (seqcf_exch_top [_,x:obj,y:obj ⊢ SQ1[..,y,x]])
          [_,x:obj ⊢ mg/c M2[..] •/01] in
      [_ ⊢ L&1_cf U3 \x.SQ3]
    )
  | ([_ ⊢ _],[_,x:obj ⊢ L&2_cf U1 \y.SQ1]) ⇒
    (case [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ upd/t _] ⇒
      let [_ ⊢ R&_cf _ SQ3] = s1 in
      % left and hyp rules already covered, others impossible
      cut_admis [_ ⊢ SQ3]
        (seqcf_str_cor [_,x:obj,y:obj ⊢ SQ1]) mg
    | [_,x:obj ⊢ upd/n U1'] ⇒
      let Prune-Upd [_ ⊢ U1''] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1'] in
      let [_ ⊢ merge-upd2 U2 U3 •/10 M2_comm _ _ _] =
        merge_upd_cor_l [_ ⊢ U1''] [_ ⊢ M1_comm] [ ⊢ •/00] in
      let [_ ⊢ M2] = merge_comm [_ ⊢ M2_comm] in
      let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
      let [_,x:obj ⊢ SQ3] = cut_admis
        (seqcf_weak [_,x:obj ⊢ S1[..]] [_ ⊢ _] [ ⊢ _])
        (seqcf_exch_top [_,x:obj,y:obj ⊢ SQ1[..,y,x]])
          [_,x:obj ⊢ mg/c M2[..] •/01] in
      [_ ⊢ L&2_cf U3 \x.SQ3]
    )
  | ([_ ⊢ _],[_,x:obj ⊢ L⊕_cf U1 (\y.SQ1) (\y.SQ2)]) ⇒
    (case [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ upd/t _] ⇒
      (case s1 of
      | [_ ⊢ R⊕1_cf SQ3] ⇒
        cut_admis [_ ⊢ SQ3] (seqcf_str_cor [_,x:obj,y:obj ⊢ SQ1]) mg
      | [_ ⊢ R⊕2_cf SQ3] ⇒
        cut_admis [_ ⊢ SQ3] (seqcf_str_cor [_,x:obj,y:obj ⊢ SQ2]) mg
      )
    | [_,x:obj ⊢ upd/n U1'] ⇒
      let Prune-Upd [_ ⊢ U1''] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1'] in
      let [_ ⊢ merge-upd2 U2 U3 •/10 M2_comm _ _ _] =
        merge_upd_cor_l [_ ⊢ U1''] [_ ⊢ M1_comm] [ ⊢ •/00] in
      let [_ ⊢ M2] = merge_comm [_ ⊢ M2_comm] in
      let [_ ⊢ ctx/refl] = upd_refl_cor [_ ⊢ U2] in
      let [_,x:obj ⊢ SQ3] = cut_admis
        (seqcf_weak [_,x:obj ⊢ S1[..]] [_ ⊢ _] [ ⊢ _])
        (seqcf_exch_top [_,x:obj,y:obj ⊢ SQ1[..,y,x]])
          [_,x:obj ⊢ mg/c M2[..] •/01] in
      let [_,x:obj ⊢ SQ4] = cut_admis
        (seqcf_weak [_,x:obj ⊢ S1[..]] [_ ⊢ _] [ ⊢ _])
        (seqcf_exch_top [_,x:obj,y:obj ⊢ SQ2[..,y,x]])
          [_,x:obj ⊢ mg/c M2[..] •/01] in
      [_ ⊢ L⊕_cf U3 (\x.SQ3) (\x.SQ4)]
    )
  ;

% Cut elimination for the linear sequent calculus:
% every derivation can be turned into a cut-free one

rec cut_elim : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]]) [Ψ ⊢ seq Δ C] → [Ψ ⊢ seq_cf Δ C] =
  / total 1 /
  fn sq ⇒ case sq of
  | [_ ⊢ hyp U1 E] ⇒ [_ ⊢ hyp_cf U1 E]
  | [_ ⊢ R① E] ⇒ [_ ⊢ R①_cf E]
  | [_ ⊢ L① U1 SQ1] ⇒ let [_ ⊢ SQ1'] = cut_elim [_ ⊢ SQ1] in [_ ⊢ L①_cf U1 SQ1']
  | [_ ⊢ R⊗ SQ1 SQ2 M1] ⇒
    let [_ ⊢ SQ1'] = cut_elim [_ ⊢ SQ1] in
    let [_ ⊢ SQ2'] = cut_elim [_ ⊢ SQ2] in
    [_ ⊢ R⊗_cf SQ1' SQ2' M1]
  | [_ ⊢ L⊗ U1 \x.\y.SQ1] ⇒
    let [_,x:obj,y:obj ⊢ SQ1'] = cut_elim [_,x:obj,y:obj ⊢ SQ1] in
    [_ ⊢ L⊗_cf U1 \x.\y.SQ1']
  | [_ ⊢ R-o \x.SQ1] ⇒
    let [_,x:obj ⊢ SQ1'] = cut_elim [_,x:obj ⊢ SQ1] in
    [_ ⊢ R-o_cf \x.SQ1']
  | [_ ⊢ L-o U1 M1 SQ1 \x.SQ2] ⇒
    let [_ ⊢ SQ1'] = cut_elim [_ ⊢ SQ1] in
    let [_,x:obj ⊢ SQ2'] = cut_elim [_,x:obj ⊢ SQ2] in
    [_ ⊢ L-o_cf U1 M1 SQ1' \x.SQ2']
  | [_ ⊢ R& SQ1 SQ2] ⇒
    let [_ ⊢ SQ1'] = cut_elim [_ ⊢ SQ1] in
    let [_ ⊢ SQ2'] = cut_elim [_ ⊢ SQ2] in
    [_ ⊢ R&_cf SQ1' SQ2']
  | [_ ⊢ L&1 U1 \x.SQ1] ⇒
    let [_,x:obj ⊢ SQ1'] = cut_elim [_,x:obj ⊢ SQ1] in
    [_ ⊢ L&1_cf U1 \x.SQ1']
  | [_ ⊢ L&2 U1 \x.SQ1] ⇒
    let [_,x:obj ⊢ SQ1'] = cut_elim [_,x:obj ⊢ SQ1] in
    [_ ⊢ L&2_cf U1 \x.SQ1']
  | [_ ⊢ R⊕1 SQ1] ⇒ let [_ ⊢ SQ1'] = cut_elim [_ ⊢ SQ1] in [_ ⊢ R⊕1_cf SQ1']
  | [_ ⊢ R⊕2 SQ1] ⇒ let [_ ⊢ SQ1'] = cut_elim [_ ⊢ SQ1] in [_ ⊢ R⊕2_cf SQ1']
  | [_ ⊢ L⊕ U1 (\x.SQ1) (\x.SQ2)] ⇒
    let [_,x:obj ⊢ SQ1'] = cut_elim [_,x:obj ⊢ SQ1] in
    let [_,x:obj ⊢ SQ2'] = cut_elim [_,x:obj ⊢ SQ2] in
    [_ ⊢ L⊕_cf U1 (\x.SQ1') (\x.SQ2')]
  | [_ ⊢ cut M1 SQ1 \x.SQ2] ⇒ cut_admis (cut_elim [_ ⊢ SQ1])
    (cut_elim [_,x:obj ⊢ SQ2]) [_ ⊢ M1]
  ;
