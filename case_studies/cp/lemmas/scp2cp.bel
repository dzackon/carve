%======================================================%
% Lemmas about translation from SCP to CP
%======================================================%

%------------------------------------------------------%
% Properties of RelUsed, RelName, and Dec
%------------------------------------------------------%

% If RelUsed [Ψ ⊢ Δ] [Φ ⊢ σ], then exh(Δ).

rec relus_exh : RelUsed [Ψ ⊢ Δ] $[Φ ⊢ $σ] → [Ψ ⊢ exh Δ] =
  / total 1 /
  fn ru ⇒ case ru of
  | relUsed/n ⇒ [ ⊢ exh/n]
  | relUsed/c ru1 ⇒
    let [_ ⊢ E] = relus_exh ru1 in
    [_,x:obj ⊢ exh/c E[..] hal/0]
  ;

% If RelName [Ψ ⊢ x] [Ψ ⊢ Δ] [Φ ⊢ σ] and (x : A) ∈ Φ, then x is the unique
% linear element of Δ.

LF unqlin : obj → tp → lctx _ → type =
| unql : upd Δ _ X X A A 𝟙 𝟘 Δ' → exh Δ' → unqlin X A Δ;

rec relnm_unqlin :
  RelName [Ψ ⊢ X] [Ψ ⊢ Δ] $[Φ ⊢ $σ]
  → [Φ ⊢ hyp X[$σ[..]] A[]]
  → [Ψ ⊢ unqlin X A[] Δ] =
  / total 1 /
  fn rn, hp ⇒ case rn of
  | relName/t ru ⇒
    let [_ ⊢ E] = relus_exh ru in
    let [_,b:block x:obj,h:hyp _ _ ⊢ b.2] = hp in
    [_,x:obj ⊢ unql (upd/t _) (exh/c E[..] hal/0)]
  | relName/n rn ⇒
    let [_ ⊢ unql U1 E] = relnm_unqlin rn (prune_hyp hp) in
    [_,x:obj ⊢ unql (upd/n U1[..]) (exh/c E[..] hal/0)]
  ;

% A Dec relation yields an Enc relation.

rec dec2enc : Dec [Ψ ⊢ P] [Ψ ⊢ Δ] $[Φ ⊢ $σ] → Enc [Ψ ⊢ Δ] $[Φ ⊢ $σ] =
  / total 1 /
  fn dc ⇒ case dc of
  | Dec/fwd u1 rn ⇒ encctx_upd (relnm_to_encctx rn) (upd_symm u1)
  | Dec/close rn ⇒ relnm_to_encctx rn
  | Dec/wait u1 dc1 ⇒ encctx_upd (dec2enc dc1) (upd_symm u1)
  | Dec/out _ m dc1 _ ⇒ encctx_merge_l (enc_tail (dec2enc dc1)) m
  | Dec/inp u1 dc1 ⇒
    encctx_upd (enc_tail (enc_tail (dec2enc dc1))) (upd_symm u1)
  | Dec/pcomp m _ dc1 _ ⇒ encctx_merge_l (enc_tail (dec2enc dc1)) m
  | Dec/inl u1 dc1 ⇒ encctx_upd (enc_tail (dec2enc dc1)) (upd_symm u1)
  | Dec/inr u1 dc1 ⇒ encctx_upd (enc_tail (dec2enc dc1)) (upd_symm u1)
  | Dec/choice u1 dc1 _ ⇒ encctx_upd (enc_tail (dec2enc dc1)) (upd_symm u1)
  ;


% Obtain a hyp judgment from a look-up in the explicit context, given
% (1) a RelUsed, (2) a RelName, or (3) a Dec relation.

rec relus_lookup_hyp :
  RelUsed [Ψ ⊢ Δ] $[Φ ⊢ $σ]
  → [Ψ ⊢ upd Δ _ X _ A[] _ _ _ _]
  → [Φ ⊢ hyp X[$σ[..]] A[]] =
  / total 1 /
  fn ru, u ⇒ lookup_to_hyp (relus_to_encctx ru) u
  ;

rec relnm_lookup_hyp :
  RelName [Ψ ⊢ _] [Ψ ⊢ Δ] $[Φ ⊢ $σ]
  → [Ψ ⊢ upd Δ _ X _ A[] _ _ _ _]
  → [Φ ⊢ hyp X[$σ[..]] A[]] =
  / total 1 /
  fn rn, u ⇒ lookup_to_hyp (relnm_to_encctx rn) u
  ;

rec dec_lookup_hyp :
  Dec [Ψ ⊢ P] [Ψ ⊢ Δ] $[Φ ⊢ $σ[..]]
  → [Ψ ⊢ upd Δ _ X _ A[] _ _ _ _]
  → [Φ ⊢ hyp X[$σ[..]] A[]] =
  / total 1 /
  fn dc, u ⇒ lookup_to_hyp (dec2enc dc) u
  ;
