%======================================================%
% Lemmas about translation from CP to SCP
%======================================================%

%------------------------------------------------------%
% Properties of Enc judgment
%------------------------------------------------------%

% Obtain Enc judgment from RelUsed and RelName judgments

rec relus_to_encctx : RelUsed [Ψ ⊢ Δ] $[Φ ⊢ $σ] → Enc [Ψ ⊢ Δ] $[Φ ⊢ $σ] =
  / total 1 /
  fn ru ⇒ case ru of
  | relUsed/n ⇒ Enc/n
  | relUsed/c ru1 ⇒ Enc/c (relus_to_encctx ru1) [ ⊢ _] [ ⊢ _]
  ;

rec relnm_to_encctx :
  RelName [Ψ ⊢ _] [Ψ ⊢ Δ] $[Φ ⊢ $σ]
  → Enc [Ψ ⊢ Δ] $[Φ ⊢ $σ] =
  / total 1 /
  fn rn ⇒ case rn of
  | relName/t ru ⇒ Enc/c (relus_to_encctx ru) [ ⊢ _] [ ⊢ _]
  | relName/n rn ⇒ Enc/c (relnm_to_encctx rn) [ ⊢ _] [ ⊢ _]
  ;

% If Δ₁ ⋈ Δ₂ = Δ, then Enc [Ψ ⊢ Δ] [Φ ⊢ σ] iff Enc [Ψ ⊢ Δ₁] [Φ ⊢ σ]

rec encctx_merge :
  Enc [Ψ ⊢ Δ] $[Φ ⊢ $σ]
  → [Ψ ⊢ merge Δ₁ Δ₂ Δ]
  → Enc [Ψ ⊢ Δ₁] $[Φ ⊢ $σ] =
  / total 1 /
  fn ec, m ⇒ case m of
  | [_ ⊢ mg/n] ⇒ ec
  | [_ ⊢ mg/c M1 _] ⇒
    let Enc/c ec1 [ ⊢ _] [ ⊢ _] = ec in
    let Prune-Merge [_ ⊢ M1'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1] in
    Enc/c (encctx_merge ec1 [_ ⊢ M1']) [ ⊢ _] [ ⊢ _]
  ;

rec encctx_merge_l :
  Enc [Ψ ⊢ Δ₁] $[Φ ⊢ $σ]
  → [Ψ ⊢ merge Δ₁ Δ₂ Δ]
  → Enc [Ψ ⊢ Δ] $[Φ ⊢ $σ] =
  / total 1 /
  fn ec, m ⇒ case m of
  | [_ ⊢ mg/n] ⇒ ec
  | [_ ⊢ mg/c M1 _] ⇒
    let Enc/c ec1 [ ⊢ _] [ ⊢ _] = ec in
    let Prune-Merge [_ ⊢ M1'] [_,x:obj ⊢ _] = prune_merge_l [_,x:obj ⊢ M1] in
    Enc/c (encctx_merge_l ec1 [_ ⊢ M1']) [ ⊢ _] [ ⊢ _]
  ;

% Updating multiplicities in the explicit context preserves the Enc relation

rec encctx_upd :
  Enc [Ψ ⊢ Δ] $[Φ ⊢ $σ]
  → [Ψ ⊢ upd Δ _ X X A[] A[] _ _ Δ']
  → Enc [Ψ ⊢ Δ'] $[Φ ⊢ $σ] =
  / total 1 /
  fn ec, u ⇒ case u of
  | [_ ⊢ upd/t _] ⇒
    let Enc/c ec1 [ ⊢ _] [ ⊢ _] = ec in
    Enc/c ec1 [ ⊢ _] [ ⊢ _]
  | [_ ⊢ upd/n U1] ⇒
    let Enc/c ec1 [ ⊢ _] [ ⊢ _] = ec in
    let Prune-Upd [_ ⊢ U1'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1] in
    Enc/c (encctx_upd ec1 [_ ⊢ U1']) [ ⊢ _] [ ⊢ _]
  ;

% Obtain SCP hyp judgment from CP look-up judgment:
% If Enc [Ψ ⊢ Δ] [Φ ⊢ σ] and (X : A) ∈ Δ, then (X[σ] : A) ∈ Φ

rec lookup_to_hyp :
  Enc [Ψ ⊢ Δ] $[Φ ⊢ $σ]
  → [Ψ ⊢ upd Δ _ X X' A[] A' α α' Δ']
  → [Φ ⊢ hyp X[$σ] A[]] =
  / total 1 /
  fn ec, u ⇒ case u of
  | [_ ⊢ upd/t _] ⇒
    let Enc/c ec1 [ ⊢ _] [ ⊢ _] = ec in
    [_,b:block x:obj,h:hyp _ _ ⊢ b.2]
  | [_ ⊢ upd/n U1] ⇒
    let Enc/c ec1 [ ⊢ _] [ ⊢ _] = ec in
    let [_,x:obj ⊢ U1'] = upd_refl [_,x:obj ⊢ U1] in
    let Prune-Upd [_ ⊢ U1''] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1'] in
    let [_ ⊢ H] = lookup_to_hyp ec1 [_ ⊢ U1''] in
    [_,b:block x:obj,h:hyp _ _ ⊢ H[..]]
  ;

% If Enc [Ψ ⊢ Δ] [Φ ⊢ σ] and exh(Δ), then RelUsed [Ψ ⊢ Δ] [Φ ⊢ σ]

rec exh_to_relus :
  Enc [Ψ ⊢ Δ] $[Φ ⊢ $σ]
  → [Ψ ⊢ exh Δ]
  → RelUsed [Ψ ⊢ Δ] $[Φ ⊢ $σ] =
  / total 1 /
  fn ec, e ⇒ case e of
  | [_ ⊢ exh/n] ⇒ let Enc/n = ec in relUsed/n
  | [_ ⊢ exh/c E1 hal/0] ⇒
    let Enc/c ec1 [ ⊢ _] [ ⊢ _] = ec in
    relUsed/c (exh_to_relus ec1 (prune_exh [_,x:obj ⊢ E1]))
  ;

% If Enc [Ψ ⊢ Δ] [Φ ⊢ σ] and X:A is the unique linear element of Δ, then RelName
% [Ψ ⊢ X] [Ψ ⊢ Δ] [Φ ⊢ σ]

rec unqlin_to_relnm :
  Enc [Ψ ⊢ Δ] $[Φ ⊢ $σ]
  → [Ψ ⊢ upd Δ _ X X A[] A[] 𝟙 𝟘 Δ']
  → [Ψ ⊢ exh Δ']
  → RelName [Ψ ⊢ X] [Ψ ⊢ Δ] $[Φ ⊢ $σ] =
  / total 1 /
  fn ec, u, e ⇒ case u of
  | [_ ⊢ upd/t _] ⇒
    let Enc/c ec1 [ ⊢ _] [ ⊢ _] = ec in
    let [_,x:obj ⊢ exh/c E1 hal/0] = e in
    relName/t (exh_to_relus ec1 (prune_exh [_,x:obj ⊢ E1]))
  | [_ ⊢ upd/n U1] ⇒
    let Enc/c ec1 [ ⊢ _] [ ⊢ _] = ec in
    let [_,x:obj ⊢ exh/c E1 hal/0] = e in
    let Prune-Upd [_ ⊢ U1'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1] in
    relName/n (unqlin_to_relnm ec1 [_ ⊢ U1'] (prune_exh [_,x:obj ⊢ E1]))
  ;

% Enc for a context yields Enc for its tail

rec enc_tail :
  Enc [Ψ,x:obj ⊢ cons Δ[..] x A[] α[]]
    $[Φ,b:block x:obj,h:hyp x A[] ⊢ $σ[..],b.1]
  → Enc [Ψ ⊢ Δ] $[Φ ⊢ $σ] =
  / total 1 /
  fn ec ⇒ let Enc/c ec1 [ ⊢ _] [ ⊢ _] = ec in ec1
  ;

%------------------------------------------------------%
% Extract linearity judgment from CP typing judgment
%------------------------------------------------------%

% If P ⊢ Δ where x :¹ A is the k-th entry of Δ and the rest of Δ, written
% Δ', does not mention x, then P is linear with respect to x

rec oft_linear_gen : (Ψ:ctx) (Δ:[Ψ,x:obj ⊢ lctx (suc N[])])
  [Ψ,x:obj ⊢ oft P Δ]
  → [Ψ,x:obj ⊢ upd Δ k[] x x A[] A[] 𝟙 𝟘 Δ⁰]
  → [Ψ,x:obj ⊢ del Δ⁰ k[] Δ'[..]]
  → [Ψ ⊢ linear \x.P] =
  / total 1 /
  fn d, u, dl ⇒
  let [_,x:obj ⊢ U] = u in
  let [_,x:obj ⊢ DL] = dl in
  case d of
  | [_,x:obj ⊢ oft/fwd DU[] U1 U2 E] ⇒
    (case comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ U] [_,x:obj ⊢ U1] in
      let [_,x:obj ⊢ del-upd U2ᵣ _ _ _ _] =
        del_upd [_,x:obj ⊢ DL] [_,x:obj ⊢ U2] (fn e ⇒ impossible e) in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U2ᵣ] in
      [_ ⊢ l_fwd2]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ U' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ U] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      (case comp_look [_,x:obj ⊢ U'] [_,x:obj ⊢ U2] of
      | [_,x:obj ⊢ look-eq _ _] ⇒ [_ ⊢ l_fwd1]
      | [_,x:obj ⊢ look-neq NEQ'[] _ _] ⇒
        let [_,x:obj ⊢ lookintm U7] =
          lookup_upd [_,x:obj ⊢ U2] [_,x:obj ⊢ U'] (neq_comm [ ⊢ NEQ']) in
        impossible exh_lookup [_,x:obj ⊢ E] [_,x:obj ⊢ U7]
      )
    )
  | [_,x:obj ⊢ oft/close U1 E] ⇒
    (case comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒ [_ ⊢ l_close]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ lookintm U2] =
        lookup_upd [_,x:obj ⊢ U1] [_,x:obj ⊢ U] (neq_comm [ ⊢ NEQ]) in
      impossible exh_lookup [_,x:obj ⊢ E] [_,x:obj ⊢ U2]
    )
  | [_,x:obj ⊢ oft/wait U1 O1] ⇒
    (case comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ U] [_,x:obj ⊢ U1] in
      let [_,x:obj ⊢ O1s] = oft_del [_,x:obj ⊢ O1] [_,x:obj ⊢ DL] in
      let Prune-Oft [_ ⊢ _] [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ O1s] in
      [_ ⊢ l_wait]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ U' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ U] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_ ⊢ LN] =
        oft_linear_gen [_,x:obj ⊢ O1] [_,x:obj ⊢ U']
          [_,x:obj ⊢ DL'] in
      [_ ⊢ l_wait2 LN]
    )
  | [_,x:obj ⊢ oft/out U1 M (\y.O1[..,y,x]) (\y.O2[..,y,x])] ⇒
    let [_,x:obj ⊢ merge-upd Ua Ub T[] M⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M⁰] in
    let Prune-Merge [_ ⊢ _] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M'] in
    (case [ ⊢ T] of
    | [ ⊢ •/10] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ub] in
      let [_,x:obj ⊢ del-upd U1ᵣ DL' _ _ _] =
        del_upd [_,x:obj ⊢ DLb] [_,x:obj ⊢ U1] (fn e ⇒ impossible e) in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,y:obj,x:obj ⊢ O2s] =
        oft_del [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ del/n DL'[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O2s] in
      let [_,y:obj ⊢ LN] =
        oft_linear_gen [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ upd/n Ua[..,x]]
          [_,y:obj,x:obj ⊢ del/n DLa[..,x]] in
      [_ ⊢ l_out2 \y.LN]
    | [ ⊢ •/01] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ua] in
      let [_,y:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ del/n DLa[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O1s] in
      (case comp_look [_,x:obj ⊢ Ub] [_,x:obj ⊢ U1] of
      | [_,x:obj ⊢ look-eq _ _] ⇒
        let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ Ub] [_,x:obj ⊢ U1] in
        let [_,y:obj,x:obj ⊢ O2s] =
          oft_del [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ del/n DLb[..,x]] in
        let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
          prune_oft [_,y:obj,x:obj ⊢ O2s] in
        let [_,x:obj ⊢ oft/out _ _ (\y._) (\y.O2e)] = d in
        let [_,x:obj ⊢ LNx] = oft_linear_gen [_,x:obj,y:obj ⊢ O2e]
          [_,x:obj,y:obj ⊢ upd/t _] [_,x:obj,y:obj ⊢ del/t _] in
        let [_ ⊢ LN] = linear_str [_,x:obj ⊢ LNx] in
        [_ ⊢ l_out LN]
      | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
        let [_,x:obj ⊢ pushout-delete U1⁰ U' DL' U1ᵣ _ _ _] =
          pushout_delete [_,x:obj ⊢ Ub] [_,x:obj ⊢ DLb] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
        let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
        let [_,y:obj ⊢ LN] =
          oft_linear_gen [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ upd/n U'[..,x]]
            [_,y:obj,x:obj ⊢ del/n DL'[..,x]] in
        [_ ⊢ l_out3 \y.LN]
      )
    )
  | [_,x:obj ⊢ oft/inp U1 (\y.\z.O1[..,y,z,x])] ⇒
    (case comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ U] [_,x:obj ⊢ U1] in
      let [_,y:obj,z:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,z:obj,x:obj ⊢ O1]
          [_,y:obj,z:obj,x:obj ⊢ del/n (del/n DL[..,x])] in
      let Prune-Oft [_,y:obj,z:obj ⊢ _] [_,y:obj,z:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,z:obj,x:obj ⊢ O1s] in
      let [_,x:obj ⊢ oft/inp _ (\y.\z.O1e[..,x,z,y])] = d in
      let [_,x:obj,z:obj ⊢ LNx] =
        oft_linear_gen [_,x:obj,z:obj,y:obj ⊢ O1e]
          [_,x:obj,z:obj,y:obj ⊢ upd/n (upd/t _)]
          [_,x:obj,z:obj,y:obj ⊢ del/n (del/t _)] in
      let [_,z:obj ⊢ LN] = linear_str [_,z:obj,x:obj ⊢ LNx[..,x,z]] in
      [_ ⊢ l_inp \z.LN]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ U' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ U] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,y:obj,z:obj ⊢ LN] =
        oft_linear_gen [_,y:obj,z:obj,x:obj ⊢ O1]
          [_,y:obj,z:obj,x:obj ⊢ upd/n (upd/n U'[..,x])]
          [_,y:obj,z:obj,x:obj ⊢ del/n (del/n DL'[..,x])] in
      [_ ⊢ l_inp2 \y.\z.LN]
    )
  | [_,x:obj ⊢ oft/pcomp DU[] M (\y.O1[..,y,x]) (\y.O2[..,y,x])] ⇒
    let [_,x:obj ⊢ merge-upd Ua Ub T[] M⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ U] [_,x:obj ⊢ M] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M⁰] in
    let Prune-Merge [_ ⊢ _] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M'] in
    (case [ ⊢ T] of
    | [ ⊢ •/10] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ub] in
      let [_,y:obj,x:obj ⊢ O2s] =
        oft_del [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ del/n DLb[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O2s] in
      let [_,y:obj ⊢ LN] =
        oft_linear_gen [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ upd/n Ua[..,x]]
          [_,y:obj,x:obj ⊢ del/n DLa[..,x]] in
      [_ ⊢ l_pcomp1 \y.LN]
    | [ ⊢ •/01] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ Ua] in
      let [_,y:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ del/n DLa[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O1s] in
      let [_,y:obj ⊢ LN] =
        oft_linear_gen [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ upd/n Ub[..,x]]
          [_,y:obj,x:obj ⊢ del/n DLb[..,x]] in
      [_ ⊢ l_pcomp2 \y.LN]
    )
  | [_,x:obj ⊢ oft/inl U1 (\y.O1[..,y,x])] ⇒
    (case comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ U] [_,x:obj ⊢ U1] in
      let [_,y:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ del/n DL[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O1s] in
      let [_,x:obj ⊢ oft/inl _ (\y.O1e)] = d in
      let [_,x:obj ⊢ LN1x] = oft_linear_gen [_,x:obj,y:obj ⊢ O1e]
        [_,x:obj,y:obj ⊢ upd/t _] [_,x:obj,y:obj ⊢ del/t _] in
      let [_ ⊢ LN1] = linear_str [_,x:obj ⊢ LN1x] in
      [_ ⊢ l_inl LN1]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ U' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ U] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,y:obj ⊢ LN1] =
        oft_linear_gen [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ upd/n U'[..,x]]
          [_,y:obj,x:obj ⊢ del/n DL'[..,x]] in
      [_ ⊢ l_inl2 (\y.LN1)]
    )
  | [_,x:obj ⊢ oft/inr U1 (\y.O1[..,y,x])] ⇒
    (case comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ U] [_,x:obj ⊢ U1] in
      let [_,y:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ del/n DL[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O1s] in
      let [_,x:obj ⊢ oft/inr _ (\y.O1e)] = d in
      let [_,x:obj ⊢ LN1x] = oft_linear_gen [_,x:obj,y:obj ⊢ O1e]
        [_,x:obj,y:obj ⊢ upd/t _] [_,x:obj,y:obj ⊢ del/t _] in
      let [_ ⊢ LN1] = linear_str [_,x:obj ⊢ LN1x] in
      [_ ⊢ l_inr LN1]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ U' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ U] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,y:obj ⊢ LN1] =
        oft_linear_gen [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ upd/n U'[..,x]]
          [_,y:obj,x:obj ⊢ del/n DL'[..,x]] in
      [_ ⊢ l_inr2 (\y.LN1)]
    )
  | [_,x:obj ⊢ oft/choice U1 (\y.O1[..,y,x]) (\y.O2[..,y,x])] ⇒
    (case comp_look [_,x:obj ⊢ U] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ U] [_,x:obj ⊢ U1] in
      let [_,y:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ del/n DL[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O1s] in
      let [_,y:obj,x:obj ⊢ O2s] =
        oft_del [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ del/n DL[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O2s] in
      let [_,x:obj ⊢ oft/choice _ (\y.O1e) (\y.O2e)] = d in
      let [_,x:obj ⊢ LN1x] = oft_linear_gen [_,x:obj,y:obj ⊢ O1e]
        [_,x:obj,y:obj ⊢ upd/t _] [_,x:obj,y:obj ⊢ del/t _] in
      let [_ ⊢ LN1] = linear_str [_,x:obj ⊢ LN1x] in
      let [_,x:obj ⊢ LN2x] = oft_linear_gen [_,x:obj,y:obj ⊢ O2e]
        [_,x:obj,y:obj ⊢ upd/t _] [_,x:obj,y:obj ⊢ del/t _] in
      let [_ ⊢ LN2] = linear_str [_,x:obj ⊢ LN2x] in
      [_ ⊢ l_choice LN1 LN2]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ U' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ U] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,y:obj ⊢ LN1] =
        oft_linear_gen [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ upd/n U'[..,x]]
          [_,y:obj,x:obj ⊢ del/n DL'[..,x]] in
      let [_,y:obj ⊢ LN2] =
        oft_linear_gen [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ upd/n U'[..,x]]
          [_,y:obj,x:obj ⊢ del/n DL'[..,x]] in
      [_ ⊢ l_choice2 (\y.LN1) (\y.LN2)]
    )
  ;

% If P ⊢ (Δ, x :¹ A), then P is linear with respect to x

rec oft_linear : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ,x:obj ⊢ oft P (cons Δ[..] x A[] 𝟙)]
  → [Ψ ⊢ linear \x.P] =
  / total 1 /
  fn d ⇒ oft_linear_gen d [_,x:obj ⊢ upd/t _] [_,x:obj ⊢ del/t _]
  ;
