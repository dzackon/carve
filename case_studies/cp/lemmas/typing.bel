%======================================================%
% Lemmas about typing
%======================================================%

%------------------------------------------------------%
% Appearance of names in processes
%------------------------------------------------------%

% If P ⊢ Δ and x appears linearly in Δ, then x ∈ P

rec oft_lin_in : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ oft P Δ]
  → [Ψ ⊢ upd Δ n[] X X' A[] A'[] 𝟙 α[] Δ']
  → [Ψ ⊢ in_proc X P] =
  / total 1 /
  fn d, u ⇒
  let [_ ⊢ U] = u in
  case d of
  | [_ ⊢ oft/fwd _ U1 U2 E] ⇒
    (case comp_look [_ ⊢ U1] [_ ⊢ U] of
    | [_ ⊢ look-eq _ _] ⇒ [_ ⊢ inpr/fwd_2]
    | [_ ⊢ look-neq NEQ1[] _ _] ⇒
      let [_ ⊢ lookintm U'] = lookup_upd [_ ⊢ U1] u [ ⊢ NEQ1] in
      (case comp_look [_ ⊢ U2] [_ ⊢ U'] of
      | [_ ⊢ look-eq _ _] ⇒ [_ ⊢ inpr/fwd_1]
      | [_ ⊢ look-neq NEQ2[] _ _] ⇒
        let [_ ⊢ lookintm U3] = lookup_upd [_ ⊢ U2] [_ ⊢ U'] [ ⊢ NEQ2] in
        impossible exh_lookup [_ ⊢ E] [_ ⊢ U3]
      )
    )
  | [_ ⊢ oft/close U1 E] ⇒
    (case comp_look [_ ⊢ U1] [_ ⊢ U] of
    | [_ ⊢ look-eq _ _] ⇒ [_ ⊢ inpr/close]
    | [_ ⊢ look-neq NEQ[] _ _] ⇒
      let [_ ⊢ lookintm U2] = lookup_upd [_ ⊢ U1] u [ ⊢ NEQ] in
      impossible exh_lookup [_ ⊢ E] [_ ⊢ U2]
    )
  | [_ ⊢ oft/wait U1 O1] ⇒
    (case comp_look [_ ⊢ U1] [_ ⊢ U] of
    | [_ ⊢ look-eq _ _] ⇒ [_ ⊢ inpr/wait_1]
    | [_ ⊢ look-neq NEQ[] _ _] ⇒
      let [_ ⊢ lookintm U2] = lookup_upd [_ ⊢ U1] u [ ⊢ NEQ] in
      let [_ ⊢ IN] = oft_lin_in [_ ⊢ O1] [_ ⊢ U2] in
      [_ ⊢ inpr/wait_2 IN]
    )
  | [_ ⊢ oft/out U1 M (\x.O1) (\x.O2)] ⇒
    let [_ ⊢ merge-lookup U2 U3 T[] _ _] = merge_lookup [_ ⊢ U] [_ ⊢ M] in
    (case comp_look [_ ⊢ U1] [_ ⊢ U3] of
    | [_ ⊢ look-eq _ _] ⇒ [_ ⊢ inpr/out_1]
    | [_ ⊢ look-neq NEQ[] _ _] ⇒
      (case [ ⊢ T] of
      | [ ⊢ •/10] ⇒
        let [_,x:obj ⊢ IN] = oft_lin_in [_,x:obj ⊢ O1] [_ ⊢ upd/n U2[..]] in
        [_ ⊢ inpr/out_2 \x.IN]
      | [ ⊢ •/01] ⇒
        let [_ ⊢ lookintm U3'] = lookup_upd [_ ⊢ U1] [_ ⊢ U3] [ ⊢ NEQ] in
        let [_,x:obj ⊢ IN] = oft_lin_in [_,x:obj ⊢ O2] [_ ⊢ upd/n U3'[..]] in
        [_ ⊢ inpr/out_3 \x.IN]
      )
    )
  | [_ ⊢ oft/inp U1 \x.\y.O1] ⇒
    (case comp_look [_ ⊢ U1] [_ ⊢ U] of
    | [_ ⊢ look-eq _ _] ⇒ [_ ⊢ inpr/inp_1]
    | [_ ⊢ look-neq NEQ[] _ _] ⇒
      let [_ ⊢ lookintm U2] = lookup_upd [_ ⊢ U1] u [ ⊢ NEQ] in
      let [_,x:obj,y:obj ⊢ IN] =
        oft_lin_in [_,x:obj,y:obj ⊢ O1] [_ ⊢ upd/n (upd/n U2[..])] in
      [_ ⊢ inpr/inp_2 \x.\y.IN]
    )
  | [_ ⊢ oft/pcomp _ M (\x.O1) (\x.O2)] ⇒
    (case merge_lookup [_ ⊢ U] [_ ⊢ M] of
    | [_ ⊢ merge-lookup U1 _ •/10 _ _] ⇒
      let [_,x:obj ⊢ IN] = oft_lin_in [_,x:obj ⊢ O1] [_ ⊢ upd/n U1[..]] in
      [_ ⊢ inpr/pcomp_1 \x.IN]
    | [_ ⊢ merge-lookup _ U2 •/01 _ _] ⇒
      let [_,x:obj ⊢ IN] = oft_lin_in [_,x:obj ⊢ O2] [_ ⊢ upd/n U2[..]] in
      [_ ⊢ inpr/pcomp_2 \x.IN]
    )
  | [_ ⊢ oft/inl U1 \x.O1] ⇒
    (case comp_look [_ ⊢ U1] [_ ⊢ U] of
    | [_ ⊢ look-eq _ _] ⇒ [_ ⊢ inpr/inl_1]
    | [_ ⊢ look-neq NEQ[] _ _] ⇒
      let [_ ⊢ lookintm U2] = lookup_upd [_ ⊢ U1] u [ ⊢ NEQ] in
      let [_,x:obj ⊢ IN] = oft_lin_in [_,x:obj ⊢ O1] [_ ⊢ upd/n U2[..]] in
      [_ ⊢ inpr/inl_2 \x.IN]
    )
  | [_ ⊢ oft/inr U1 \x.O1] ⇒
    (case comp_look [_ ⊢ U1] [_ ⊢ U] of
    | [_ ⊢ look-eq _ _] ⇒ [_ ⊢ inpr/inr_1]
    | [_ ⊢ look-neq NEQ[] _ _] ⇒
      let [_ ⊢ lookintm U2] = lookup_upd [_ ⊢ U1] u [ ⊢ NEQ] in
      let [_,x:obj ⊢ IN] = oft_lin_in [_,x:obj ⊢ O1] [_ ⊢ upd/n U2[..]] in
      [_ ⊢ inpr/inr_2 \x.IN]
    )
  | [_ ⊢ oft/choice U1 (\x.O1) (\x.O2)] ⇒
    (case comp_look [_ ⊢ U1] [_ ⊢ U] of
    | [_ ⊢ look-eq _ _] ⇒ [_ ⊢ inpr/choice_1]
    | [_ ⊢ look-neq NEQ[] _ _] ⇒
      let [_ ⊢ lookintm U2] = lookup_upd [_ ⊢ U1] u [ ⊢ NEQ] in
      let [_,x:obj ⊢ IN] = oft_lin_in [_,x:obj ⊢ O1] [_ ⊢ upd/n U2[..]] in
      [_ ⊢ inpr/choice_2 \x.IN]
    )
  ;

% A linear name must occur, specialized to the second-topmost entry:
% (Δ, x :¹ A, y :β B) cannot type a process that does not mention x

rec oft_lin_absurd : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ,x:obj,y:obj ⊢ oft P[..,y] (cons (cons Δ[..] x A[] 𝟙) y B[] β[])]
  → [ ⊢ false] =
  / total 1 /
  fn d ⇒
  let [_,x:obj,y:obj ⊢ O]:
    [_,x:obj,y:obj ⊢ oft P[..,y] (cons (cons Δ[..] _ A[] _) _ _ _)] = d in
  let [_,x:obj ⊢ U] =
    upd_refl_top [_,x:obj ⊢ Δ[..]] [_,x:obj ⊢ x] [ ⊢ A] [ ⊢ 𝟙] in
  let [_,x:obj,y:obj ⊢ IN] =
    oft_lin_in [_,x:obj,y:obj ⊢ O] [_,x:obj,y:obj ⊢ upd/n U[..,x]] in
  impossible in_proc_contra [_,y:obj ⊢ P] [_,y:obj,x:obj ⊢ IN[..,x,y]]
  ;

%------------------------------------------------------%
% Structural properties of CP typing judgment
%------------------------------------------------------%

% Pruning: if the context does not mention x, neither does the
% process nor the typing derivation.

inductive PruneOft : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]]) {O:[Ψ ⊢ oft P Δ]} ctype =
  Prune-Oft : [Ψ ⊢ oft P Δ]
    → {O:[Ψ,x:obj ⊢ oft P[..] Δ[..]]} PruneOft [Ψ,x:obj ⊢ O];

rec prune_oft : {O:[Ψ,x:obj ⊢ oft P Δ[..]]} PruneOft [Ψ,x:obj ⊢ O] =
  / total 1 /
  mlam O ⇒ case [_,x:obj ⊢ O] of
  | [_,x:obj ⊢ oft/fwd DU[] U1 U2 E] ⇒
    let Prune-Upd [_ ⊢ U1'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1] in
    let Prune-Upd [_ ⊢ U2'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U2] in
    let [_ ⊢ E'] = prune_exh [_,x:obj ⊢ E] in
    Prune-Oft [_ ⊢ oft/fwd DU[] U1' U2' E'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/close U E] ⇒
    let Prune-Upd [_ ⊢ U'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U] in
    let [_ ⊢ E'] = prune_exh [_,x:obj ⊢ E] in
    Prune-Oft [_ ⊢ oft/close U' E'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/wait U O1] ⇒
    let Prune-Upd [_ ⊢ U'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U] in
    let Prune-Oft [_ ⊢ O1'] [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ O1] in
    Prune-Oft [_ ⊢ oft/wait U' O1'] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/out U M (\y.O1[..,y,x]) (\y.O2[..,y,x])] ⇒
    let Prune-Merge [_ ⊢ M'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M] in
    let Prune-Upd [_ ⊢ U'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U] in
    let Prune-Oft [_,y:obj ⊢ O1'] [_,y:obj,x:obj ⊢ _] =
      prune_oft [_,y:obj,x:obj ⊢ O1] in
    let Prune-Oft [_,y:obj ⊢ O2'] [_,y:obj,x:obj ⊢ _] =
      prune_oft [_,y:obj,x:obj ⊢ O2] in
    Prune-Oft [_ ⊢ oft/out U' M' (\y.O1') (\y.O2')] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/inp U (\y.\z.O1[..,y,z,x])] ⇒
    let Prune-Upd [_ ⊢ U'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U] in
    let Prune-Oft [_,y:obj,z:obj ⊢ O1'] [_,y:obj,z:obj,x:obj ⊢ _] =
      prune_oft [_,y:obj,z:obj,x:obj ⊢ O1] in
    Prune-Oft [_ ⊢ oft/inp U' (\y.\z.O1')] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/pcomp DU[] M (\y.O1[..,y,x]) (\y.O2[..,y,x])] ⇒
    let Prune-Merge [_ ⊢ M'] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M] in
    let Prune-Oft [_,y:obj ⊢ O1'] [_,y:obj,x:obj ⊢ _] =
      prune_oft [_,y:obj,x:obj ⊢ O1] in
    let Prune-Oft [_,y:obj ⊢ O2'] [_,y:obj,x:obj ⊢ _] =
      prune_oft [_,y:obj,x:obj ⊢ O2] in
    Prune-Oft [_ ⊢ oft/pcomp DU[] M' (\y.O1') (\y.O2')] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/inl U (\y.O1[..,y,x])] ⇒
    let Prune-Upd [_ ⊢ U'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U] in
    let Prune-Oft [_,y:obj ⊢ O1'] [_,y:obj,x:obj ⊢ _] =
      prune_oft [_,y:obj,x:obj ⊢ O1] in
    Prune-Oft [_ ⊢ oft/inl U' (\y.O1')] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/inr U (\y.O1[..,y,x])] ⇒
    let Prune-Upd [_ ⊢ U'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U] in
    let Prune-Oft [_,y:obj ⊢ O1'] [_,y:obj,x:obj ⊢ _] =
      prune_oft [_,y:obj,x:obj ⊢ O1] in
    Prune-Oft [_ ⊢ oft/inr U' (\y.O1')] [_,x:obj ⊢ _]
  | [_,x:obj ⊢ oft/choice U (\y.O1[..,y,x]) (\y.O2[..,y,x])] ⇒
    let Prune-Upd [_ ⊢ U'] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U] in
    let Prune-Oft [_,y:obj ⊢ O1'] [_,y:obj,x:obj ⊢ _] =
      prune_oft [_,y:obj,x:obj ⊢ O1] in
    let Prune-Oft [_,y:obj ⊢ O2'] [_,y:obj,x:obj ⊢ _] =
      prune_oft [_,y:obj,x:obj ⊢ O2] in
    Prune-Oft [_ ⊢ oft/choice U' (\y.O1') (\y.O2')] [_,x:obj ⊢ _]
  ;

% Exchange lemma:
% If P ⊢ Δ and Δ[(n, x) ↔ (m, y)] = Δ', P ⊢ Δ'
% (Plus two corollaries as helper lemmas for permuting the topmost elements of a
% context)

rec oft_exch : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ oft P Δ]
  → [Ψ ⊢ exch Δ n X m Y Δ']
  → [Ψ ⊢ oft P Δ'] =
  / total 1 /
  fn d, ex ⇒
  let [_ ⊢ exch/u NEQ[] EX1 EX2] = ex in
  case d of
  | [_ ⊢ oft/fwd DU U1 U2 E1] ⇒
    let [_ ⊢ exch-upd EX1' EX2' U3 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ U1] in
    let [_ ⊢ exch-upd EX1'' EX2'' U4 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ EX1'] [_ ⊢ EX2'] [_ ⊢ U2] in
    let [_ ⊢ E2] = exch_exh [_ ⊢ E1] [_ ⊢ exch/u NEQ[] EX1'' EX2''] in
    [_ ⊢ oft/fwd DU U3 U4 E2]
  | [_ ⊢ oft/close U1 E1] ⇒
    let [_ ⊢ exch-upd EX1' EX2' U2 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ U1] in
    let [_ ⊢ E2] = exch_exh [_ ⊢ E1] [_ ⊢ exch/u NEQ[] EX1' EX2'] in
    [_ ⊢ oft/close U2 E2]
  | [_ ⊢ oft/wait U1 O1] ⇒
    let [_ ⊢ exch-upd EX1' EX2' U2 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ U1] in
    let [_ ⊢ O2] = oft_exch [_ ⊢ O1] [_ ⊢ exch/u NEQ[] EX1' EX2'] in
    [_ ⊢ oft/wait U2 O2]
  | [_ ⊢ oft/out U1 M1 (\x.O1) (\x.O2)] ⇒
    let [_ ⊢ exch-merge EX1a EX2a EX1b EX2b _ M2 _ _ _ _ _] =
      exch_merge [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ M1] in
    let [_ ⊢ exch-upd EX1b' EX2b' U2 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ EX1b] [_ ⊢ EX2b] [_ ⊢ U1] in
    let [_,x:obj ⊢ O1'] = oft_exch [_,x:obj ⊢ O1]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n EX1a[..]) (upd/n EX2a[..])] in
    let [_,x:obj ⊢ O2'] = oft_exch [_,x:obj ⊢ O2]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n EX1b'[..]) (upd/n EX2b'[..])] in
    [_ ⊢ oft/out U2 M2 (\x.O1') (\x.O2')]
  | [_ ⊢ oft/inp U1 \x.\y.O1] ⇒
    let [_ ⊢ exch-upd EX1' EX2' U2 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ U1] in
    let [_,x:obj,y:obj ⊢ O2] = oft_exch [_,x:obj,y:obj ⊢ O1]
      [_,x:obj,y:obj ⊢ exch/u NEQ[] (upd/n (upd/n EX1'[..])) (upd/n (upd/n
      EX2'[..]))] in
    [_ ⊢ oft/inp U2 \x.\y.O2]
  | [_ ⊢ oft/pcomp DU M1 (\x.O1) (\x.O2)] ⇒
    let [_ ⊢ exch-merge EX1a EX2a EX1b EX2b _ M2 _ _ _ _ _] =
      exch_merge [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ M1] in
    let [_,x:obj ⊢ O1'] = oft_exch [_,x:obj ⊢ O1]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n EX1a[..]) (upd/n EX2a[..])] in
    let [_,x:obj ⊢ O2'] = oft_exch [_,x:obj ⊢ O2]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n EX1b[..]) (upd/n EX2b[..])] in
    [_ ⊢ oft/pcomp DU M2 (\x.O1') (\x.O2')]
  | [_ ⊢ oft/inl U1 \x.O1] ⇒
    let [_ ⊢ exch-upd EX1' EX2' U2 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ U1] in
    let [_,x:obj ⊢ O2] = oft_exch [_,x:obj ⊢ O1]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n EX1'[..]) (upd/n EX2'[..])] in
    [_ ⊢ oft/inl U2 \x.O2]
  | [_ ⊢ oft/inr U1 \x.O1] ⇒
    let [_ ⊢ exch-upd EX1' EX2' U2 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ U1] in
    let [_,x:obj ⊢ O2] = oft_exch [_,x:obj ⊢ O1]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n EX1'[..]) (upd/n EX2'[..])] in
    [_ ⊢ oft/inr U2 \x.O2]
  | [_ ⊢ oft/choice U1 (\x.O1) (\x.O2)] ⇒
    let [_ ⊢ exch-upd EX1' EX2' U2 _ _ _ _ _] =
      exch_upd [ ⊢ NEQ] [_ ⊢ EX1] [_ ⊢ EX2] [_ ⊢ U1] in
    let [_,x:obj ⊢ O1'] = oft_exch [_,x:obj ⊢ O1]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n EX1'[..]) (upd/n EX2'[..])] in
    let [_,x:obj ⊢ O2'] = oft_exch [_,x:obj ⊢ O2]
      [_,x:obj ⊢ exch/u NEQ[] (upd/n EX1'[..]) (upd/n EX2'[..])] in
    [_ ⊢ oft/choice U2 (\x.O1') (\x.O2')]
  ;

rec oft_exch_top : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ oft P (cons (cons Δ X A[] α[]) Y B[] β[])]
  → [Ψ ⊢ oft P (cons (cons Δ Y B[] β[]) X A[] α[])] =
  / total 1 /
  fn d ⇒ oft_exch d
    (exch_top [_ ⊢ _] [_ ⊢ _] [ ⊢ _] [ ⊢ _] [_ ⊢ _] [ ⊢ _] [ ⊢ _])
  ;

rec oft_exch_top2 : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ oft P (cons (cons (cons Δ X A[] α[]) Y B[] β[]) Z C[] γ[])]
  → [Ψ ⊢ oft P (cons (cons (cons Δ Y B[] β[]) Z C[] γ[]) X A[] α[])] =
  / total 1 /
  fn d ⇒
  let [_ ⊢ _]:[_ ⊢ oft _ (cons (cons (cons Δ X A[] α[]) Y B[] β[]) _ _ _)] =
    d in
  let [_ ⊢ exch/u NEQ[] EX1 EX2] =
    exch_top [_ ⊢ Δ] [_ ⊢ X] [ ⊢ A] [ ⊢ α] [_ ⊢ Y] [ ⊢ B] [ ⊢ β] in
  oft_exch_top (oft_exch d [_ ⊢ exch/u NEQ[] (upd/n EX1) (upd/n EX2)])
  ;

% Deletion lemma: an entry with multiplicity 𝟘 can be removed from the context.

rec oft_del : (Ψ:ctx) (Δ:[Ψ ⊢ lctx (suc N[])])
  [Ψ ⊢ oft P Δ] → [Ψ ⊢ del Δ n[] Δ'] → [Ψ ⊢ oft P Δ'] =
  / total 1 /
  fn d, dl ⇒
  let [_ ⊢ DL0] = dl in
  case d of
  | [_ ⊢ oft/fwd DU U1 U2 E] ⇒
    let [_ ⊢ del-upd U1' DL1 _ _ _] =
      del_upd [_ ⊢ DL0] [_ ⊢ U1] (fn e ⇒ impossible e) in
    let [_ ⊢ del-upd U2' DL2 _ _ _] =
      del_upd [_ ⊢ DL1] [_ ⊢ U2] (fn e ⇒ impossible e) in
    let [_ ⊢ E2] = del_exh [_ ⊢ DL2] [_ ⊢ E] in
    [_ ⊢ oft/fwd DU U1' U2' E2]
  | [_ ⊢ oft/close U1 E] ⇒
    let [_ ⊢ del-upd U1' DL1 _ _ _] =
      del_upd [_ ⊢ DL0] [_ ⊢ U1] (fn e ⇒ impossible e) in
    let [_ ⊢ E'] = del_exh [_ ⊢ DL1] [_ ⊢ E] in
    [_ ⊢ oft/close U1' E']
  | [_ ⊢ oft/wait U1 O1] ⇒
    let [_ ⊢ del-upd U1' DL1 _ _ _] =
      del_upd [_ ⊢ DL0] [_ ⊢ U1] (fn e ⇒ impossible e) in
    let [_ ⊢ O1'] = oft_del [_ ⊢ O1] [_ ⊢ DL1] in
    [_ ⊢ oft/wait U1' O1']
  | [_ ⊢ oft/out U1 M (\x.O1) (\x.O2)] ⇒
    let [_ ⊢ del-merge M' DL1 DL2 _ _] = del_merge [_ ⊢ DL0] [_ ⊢ M] in
    let [_ ⊢ del-upd U1' DL2' _ _ _] =
      del_upd [_ ⊢ DL2] [_ ⊢ U1] (fn e ⇒ impossible e) in
    let [_,x:obj ⊢ O1'] = oft_del [_,x:obj ⊢ O1] [_,x:obj ⊢ del/n DL1[..]] in
    let [_,x:obj ⊢ O2'] = oft_del [_,x:obj ⊢ O2] [_,x:obj ⊢ del/n DL2'[..]] in
    [_ ⊢ oft/out U1' M' (\x.O1') (\x.O2')]
  | [_ ⊢ oft/inp U1 \x.\y.O1] ⇒
    let [_ ⊢ del-upd U1' DL1 _ _ _] =
      del_upd [_ ⊢ DL0] [_ ⊢ U1] (fn e ⇒ impossible e) in
    let [_,x:obj,y:obj ⊢ O1'] =
      oft_del [_,x:obj,y:obj ⊢ O1] [_,x:obj,y:obj ⊢ del/n (del/n DL1[..])] in
    [_ ⊢ oft/inp U1' \x.\y.O1']
  | [_ ⊢ oft/pcomp DU M (\x.O1) (\x.O2)] ⇒
    let [_ ⊢ del-merge M' DL1 DL2 _ _] = del_merge [_ ⊢ DL0] [_ ⊢ M] in
    let [_,x:obj ⊢ O1'] = oft_del [_,x:obj ⊢ O1] [_,x:obj ⊢ del/n DL1[..]] in
    let [_,x:obj ⊢ O2'] = oft_del [_,x:obj ⊢ O2] [_,x:obj ⊢ del/n DL2[..]] in
    [_ ⊢ oft/pcomp DU M' (\x.O1') (\x.O2')]
  | [_ ⊢ oft/inl U1 \x.O1] ⇒
    let [_ ⊢ del-upd U1' DL1 _ _ _] =
      del_upd [_ ⊢ DL0] [_ ⊢ U1] (fn e ⇒ impossible e) in
    let [_,x:obj ⊢ O1'] = oft_del [_,x:obj ⊢ O1] [_,x:obj ⊢ del/n DL1[..]] in
    [_ ⊢ oft/inl U1' \x.O1']
  | [_ ⊢ oft/inr U1 \x.O1] ⇒
    let [_ ⊢ del-upd U1' DL1 _ _ _] =
      del_upd [_ ⊢ DL0] [_ ⊢ U1] (fn e ⇒ impossible e) in
    let [_,x:obj ⊢ O1'] = oft_del [_,x:obj ⊢ O1] [_,x:obj ⊢ del/n DL1[..]] in
    [_ ⊢ oft/inr U1' \x.O1']
  | [_ ⊢ oft/choice U1 (\x.O1) (\x.O2)] ⇒
    let [_ ⊢ del-upd U1' DL1 _ _ _] =
      del_upd [_ ⊢ DL0] [_ ⊢ U1] (fn e ⇒ impossible e) in
    let [_,x:obj ⊢ O1'] = oft_del [_,x:obj ⊢ O1] [_,x:obj ⊢ del/n DL1[..]] in
    let [_,x:obj ⊢ O2'] = oft_del [_,x:obj ⊢ O2] [_,x:obj ⊢ del/n DL1[..]] in
    [_ ⊢ oft/choice U1' (\x.O1') (\x.O2')]
  ;

% Strengthening lemmas (instances of deletion):
% (1) If P ⊢ (Δ, x :⁰ A), then P ⊢ Δ
% (2) if P ⊢ (Δ, x :⁰ A, y :¹ B), then P ⊢ (Δ, y :¹ B) [corollary of (1) using
% exchange lemma]

rec oft_str : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ oft P (cons Δ X A[] 𝟘)]
  → [Ψ ⊢ oft P Δ] =
  / total 1 /
  fn d ⇒ oft_del d [_ ⊢ del/t _]
  ;

rec oft_str_cor : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ,x:obj,y:obj ⊢ oft P[..,y] (cons (cons Δ[..] x A[] 𝟘) y B[] 𝟙)]
  → [Ψ,x:obj ⊢ oft P (cons Δ[..] x B[] 𝟙)] =
  / total 1 /
  fn d ⇒
  let [_,x:obj,y:obj ⊢ O1] = oft_del d [_ ⊢ del/n (del/t _)] in
  let Prune-Oft [_,x:obj ⊢ O2] [_,x:obj,y:obj ⊢ _] =
    prune_oft [_,x:obj,y:obj ⊢ O1[..,y,x]] in
  [_,x:obj ⊢ O2]
  ;

% Weakening lemma:
% If P ⊢ Δ, then P ⊢ (Δ, x :⁰ A) for any x, A

rec oft_weak : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ oft P Δ]
  → {X:[Ψ ⊢ obj]} {A:[ ⊢ tp]} [Ψ ⊢ oft P (cons Δ X A[] 𝟘)] =
  / total 1 /
  fn d ⇒ mlam X, A ⇒
  case d of
  | [_ ⊢ oft/fwd DU[] U1 U2 E] ⇒
    [_ ⊢ oft/fwd DU[] (upd/n U1) (upd/n U2) (exh/c E hal/0)]
  | [_ ⊢ oft/close U1 E] ⇒ [_ ⊢ oft/close (upd/n U1) (exh/c E hal/0)]
  | [_ ⊢ oft/wait U1 O1] ⇒
    let [_ ⊢ O1'] = oft_weak [_ ⊢ O1] [_ ⊢ X] [ ⊢ A] in
    [_ ⊢ oft/wait (upd/n U1) O1']
  | [_ ⊢ oft/out U1 M (\x.O1) (\x.O2)] ⇒
    let [_,x:obj ⊢ O1'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ O1] [_,x:obj ⊢ X[..]] [ ⊢ A]) in
    let [_,x:obj ⊢ O2'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ O2] [_,x:obj ⊢ X[..]] [ ⊢ A]) in
    [_ ⊢ oft/out (upd/n U1) (mg/c M •/00) (\x.O1') (\x.O2')]
  | [_ ⊢ oft/inp U1 \x.\y.O1] ⇒
    let [_,x:obj,y:obj ⊢ O1'] =
      oft_exch_top2 (oft_exch_top2
        (oft_weak [_,x:obj,y:obj ⊢ O1] [_,x:obj,y:obj ⊢ X[..]] [ ⊢ A])) in
    [_ ⊢ oft/inp (upd/n U1) \x.\y.O1']
  | [_ ⊢ oft/pcomp DU[] M (\x.O1) (\x.O2)] ⇒
    let [_,x:obj ⊢ O1'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ O1] [_,x:obj ⊢ X[..]] [ ⊢ A]) in
    let [_,x:obj ⊢ O2'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ O2] [_,x:obj ⊢ X[..]] [ ⊢ A]) in
    [_ ⊢ oft/pcomp DU[] (mg/c M •/00) (\x.O1') (\x.O2')]
  | [_ ⊢ oft/inl U1 \x.O1] ⇒
    let [_,x:obj ⊢ O1'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ O1] [_,x:obj ⊢ X[..]] [ ⊢ A]) in
    [_ ⊢ oft/inl (upd/n U1) \x.O1']
  | [_ ⊢ oft/inr U1 \x.O1] ⇒
    let [_,x:obj ⊢ O1'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ O1] [_,x:obj ⊢ X[..]] [ ⊢ A]) in
    [_ ⊢ oft/inr (upd/n U1) \x.O1']
  | [_ ⊢ oft/choice U1 (\x.O1) (\x.O2)] ⇒
    let [_,x:obj ⊢ O1'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ O1] [_,x:obj ⊢ X[..]] [ ⊢ A]) in
    let [_,x:obj ⊢ O2'] =
      oft_exch_top (oft_weak [_,x:obj ⊢ O2] [_,x:obj ⊢ X[..]] [ ⊢ A]) in
    [_ ⊢ oft/choice (upd/n U1) (\x.O1') (\x.O2')]
  ;

% Corollary: weakening below the topmost entry.
% If P ⊢ (Δ, y :β B), then P ⊢ (Δ, x :⁰ A, y :β B) for any A

rec oft_weak_cor : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ,y:obj ⊢ oft P (cons Δ[..] y B[] β[])]
  → {A:[ ⊢ tp]}
    [Ψ,x:obj,y:obj ⊢ oft P[..,y] (cons (cons Δ[..] x A[] 𝟘) y B[] β[])] =
  / total 1 /
  fn d ⇒ mlam A ⇒
  let [_,y:obj ⊢ O] = d in
  oft_exch_top (oft_weak [_,x:obj,y:obj ⊢ O[..,y]] [_,x:obj,y:obj ⊢ x] [ ⊢ A])
  ;

%------------------------------------------------------%
% Main lemmas
%------------------------------------------------------%

% Commutativity of cut: if (pcomp A P Q) ⊢ Δ and A ⊥ A', then
% (pcomp A' Q P) ⊢ Δ.

rec oft_comm : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ oft (pcomp A[] (\x.P[..,x]) (\x.Q[..,x])) Δ]
  → [ ⊢ dual A A']
  → [Ψ ⊢ oft (pcomp A'[] (\x.Q[..,x]) (\x.P[..,x])) Δ] =
  / total 1 /
  fn d, du ⇒
  let [_ ⊢ oft/pcomp DU1[] M1 (\x.O1) (\x.O2)] = d in
  let [ ⊢ DU] = du in
  let [ ⊢ tp/refl] = dual_unique [ ⊢ DU] [ ⊢ DU1] in
  let [_ ⊢ M2] = merge_comm [_ ⊢ M1] in
  let [ ⊢ DU2] = dual_symm [ ⊢ DU] in
  [_ ⊢ oft/pcomp DU2[] M2 (\x.O2) (\x.O1)]
  ;

% Associativity of cut, left to right.

rec oft_assoc : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ oft (pcomp B[] (\y.pcomp A[] (\z.P[..,z]) (\x.Q[..,x,y])) (\y.R[..,y])) Δ]
  → [Ψ ⊢ oft (pcomp A[] (\z.P[..,z]) (\x.pcomp B[] (\y.Q[..,x,y]) (\y.R[..,y]))) Δ] =
  / total 1 /
  fn d ⇒
  let [_ ⊢ oft/pcomp DU1[] M1 (\x.oft/pcomp DU2[] (mg/c M2' T1[]) (\y.O1)
    (\y.O2)) (\x.O3)] = d in
  let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M2'] in
  case [ ⊢ T1] of
  | [ ⊢ •/10] ⇒ impossible oft_lin_absurd [_,x:obj,y:obj ⊢ O1]
  | [ ⊢ •/01] ⇒
    let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M1] [_ ⊢ M2] in
    let [_,x:obj ⊢ O1'] = oft_str_cor [_,x:obj,y:obj ⊢ O1] in
    let [_,x:obj,y:obj ⊢ O2'[..,y,x]] = oft_exch_top [_,x:obj,y:obj ⊢ O2] in
    let [ ⊢ _]:[ ⊢ dual _ B'] = [ ⊢ DU2] in
    let [_,x:obj,y:obj ⊢ O3'] = oft_weak_cor [_,x:obj ⊢ O3] [ ⊢ B'] in
    [_ ⊢ oft/pcomp DU2[] M4 (\x.O1') (\x.oft/pcomp DU1[] (mg/c M3[..] •/10)
      (\y.O2') (\y.O3'))]
  ;

% Associativity of cut, right to left.

rec oft_assoc_inv : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ oft (pcomp A[] (\z.P[..,z]) (\x.pcomp B[] (\y.Q[..,x,y]) (\y.R[..,y]))) Δ]
  → [Ψ ⊢ oft (pcomp B[] (\y.pcomp A[] (\z.P[..,z]) (\x.Q[..,x,y])) (\y.R[..,y])) Δ] =
  / total 1 /
  fn d ⇒
  let [_ ⊢ oft/pcomp DU1[] M1 (\x.O1) (\x.oft/pcomp DU2[] (mg/c M2' T1[])
    (\y.O2) (\y.O3))] = d in
  let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M2'] in
  case [ ⊢ T1] of
  | [ ⊢ •/01] ⇒
    let [_,x:obj,y:obj ⊢ _]:
      [_,x:obj,y:obj ⊢ oft _ (cons (cons Δ₂[..] _ A'[] _) _ _ _)] =
      [_,x:obj,y:obj ⊢ O3] in
    let [_,x:obj ⊢ U] =
      upd_refl_top [_,x:obj ⊢ Δ₂[..]] [_,x:obj ⊢ x] [ ⊢ A'] [ ⊢ 𝟙] in
    let [_,x:obj,y:obj ⊢ NIN] =
      oft_lin_in [_,x:obj,y:obj ⊢ O3] [_,x:obj,y:obj ⊢ upd/n U[..,x]] in
    impossible in_proc_contra [_,x:obj ⊢ _] [_,x:obj,y:obj ⊢ NIN[..,y,x]]
  | [ ⊢ •/10] ⇒
    let [_ ⊢ M1c] = merge_comm [_ ⊢ M1] in
    let [_ ⊢ merge-assoc2 M3 M4 _ _] = merge_assoc_swap [_ ⊢ M1c] [_ ⊢ M2] in
    let [_ ⊢ M3c] = merge_comm [_ ⊢ M3] in
    let [ ⊢ _]:[ ⊢ dual B _] = [ ⊢ DU2] in
    let [_,y:obj,x:obj ⊢ O1'] = oft_exch_top
      (oft_weak [_,y:obj,x:obj ⊢ O1[..,x]] [_,y:obj,x:obj ⊢ y] [ ⊢ B]) in
    let [_,x:obj,y:obj ⊢ O2'[..,y,x]] = oft_exch_top [_,x:obj,y:obj ⊢ O2] in
    let [_,y:obj ⊢ O3'] = oft_str_cor [_,x:obj,y:obj ⊢ O3] in
    [_ ⊢ oft/pcomp DU2[] M4 (\y.oft/pcomp DU1[] (mg/c M3c[..] •/01)
      (\x.O1') (\x.O2')) (\y.O3')]
  ;

% Preservation of typing under structural congruence

rec oft_cong : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ oft P Δ]
  → [Ψ ⊢ P ≡ Q]
  → [Ψ ⊢ oft Q Δ] =
  / total 2 /
  fn d, c ⇒ case c of
  | [_ ⊢ ≡comm DU[]] ⇒ oft_comm d [ ⊢ DU]
  | [_ ⊢ ≡assoc] ⇒ oft_assoc d
  | [_ ⊢ ≡c/wait C1] ⇒
    let [_ ⊢ oft/wait U O] = d in
    let [_ ⊢ O'] = oft_cong [_ ⊢ O] [_ ⊢ C1] in [_ ⊢ oft/wait U O']
  | [_ ⊢ ≡c/out1 \x.C1] ⇒
    let [_ ⊢ oft/out U M (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O1'] = oft_cong [_,x:obj ⊢ O1] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/out U M (\x.O1') (\x.O2)]
  | [_ ⊢ ≡c/out2 \x.C1] ⇒
    let [_ ⊢ oft/out U M (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O2'] = oft_cong [_,x:obj ⊢ O2] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/out U M (\x.O1) (\x.O2')]
  | [_ ⊢ ≡c/inp \x.\y.C1] ⇒
    let [_ ⊢ oft/inp U (\x.\y.O)] = d in
    let [_,x:obj,y:obj ⊢ O'] = oft_cong [_,x:obj,y:obj ⊢ O] [_,x:obj,y:obj ⊢ C1] in
    [_ ⊢ oft/inp U (\x.\y.O')]
  | [_ ⊢ ≡c/pcomp1 \x.C1] ⇒
    let [_ ⊢ oft/pcomp DU[] M (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O1'] = oft_cong [_,x:obj ⊢ O1] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/pcomp DU[] M (\x.O1') (\x.O2)]
  | [_ ⊢ ≡c/pcomp2 \x.C1] ⇒
    let [_ ⊢ oft/pcomp DU[] M (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O2'] = oft_cong [_,x:obj ⊢ O2] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/pcomp DU[] M (\x.O1) (\x.O2')]
  | [_ ⊢ ≡c/inl \x.C1] ⇒
    let [_ ⊢ oft/inl U (\x.O)] = d in
    let [_,x:obj ⊢ O'] = oft_cong [_,x:obj ⊢ O] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/inl U (\x.O')]
  | [_ ⊢ ≡c/inr \x.C1] ⇒
    let [_ ⊢ oft/inr U (\x.O)] = d in
    let [_,x:obj ⊢ O'] = oft_cong [_,x:obj ⊢ O] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/inr U (\x.O')]
  | [_ ⊢ ≡c/choice1 \x.C1] ⇒
    let [_ ⊢ oft/choice U (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O1'] = oft_cong [_,x:obj ⊢ O1] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/choice U (\x.O1') (\x.O2)]
  | [_ ⊢ ≡c/choice2 \x.C1] ⇒
    let [_ ⊢ oft/choice U (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O2'] = oft_cong [_,x:obj ⊢ O2] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/choice U (\x.O1) (\x.O2')]
  | [_ ⊢ ≡refl] ⇒ d
  | [_ ⊢ ≡sym C1] ⇒ oft_cong_symm d [_ ⊢ C1]
  | [_ ⊢ ≡trans C1 C2] ⇒ oft_cong (oft_cong d [_ ⊢ C1]) [_ ⊢ C2]

and rec oft_cong_symm : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ ⊢ oft Q Δ]
  → [Ψ ⊢ P ≡ Q]
  → [Ψ ⊢ oft P Δ] =
  / total 2 /
   fn d, c ⇒ case c of
   | [_ ⊢ ≡comm DU[]] ⇒
    let [ ⊢ DU'] = dual_symm [ ⊢ DU] in
    oft_comm d [ ⊢ DU']
  | [_ ⊢ ≡assoc] ⇒ oft_assoc_inv d
  | [_ ⊢ ≡c/wait C1] ⇒
    let [_ ⊢ oft/wait U O] = d in
    let [_ ⊢ O'] = oft_cong_symm [_ ⊢ O] [_ ⊢ C1] in [_ ⊢ oft/wait U O']
  | [_ ⊢ ≡c/out1 \x.C1] ⇒
    let [_ ⊢ oft/out U M (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O1'] = oft_cong_symm [_,x:obj ⊢ O1] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/out U M (\x.O1') (\x.O2)]
  | [_ ⊢ ≡c/out2 \x.C1] ⇒
    let [_ ⊢ oft/out U M (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O2'] = oft_cong_symm [_,x:obj ⊢ O2] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/out U M (\x.O1) (\x.O2')]
  | [_ ⊢ ≡c/inp \x.\y.C1] ⇒
    let [_ ⊢ oft/inp U (\x.\y.O)] = d in
    let [_,x:obj,y:obj ⊢ O'] = oft_cong_symm [_,x:obj,y:obj ⊢ O] [_,x:obj,y:obj ⊢ C1] in
    [_ ⊢ oft/inp U (\x.\y.O')]
  | [_ ⊢ ≡c/pcomp1 \x.C1] ⇒
    let [_ ⊢ oft/pcomp DU[] M (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O1'] = oft_cong_symm [_,x:obj ⊢ O1] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/pcomp DU[] M (\x.O1') (\x.O2)]
  | [_ ⊢ ≡c/pcomp2 \x.C1] ⇒
    let [_ ⊢ oft/pcomp DU[] M (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O2'] = oft_cong_symm [_,x:obj ⊢ O2] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/pcomp DU[] M (\x.O1) (\x.O2')]
  | [_ ⊢ ≡c/inl \x.C1] ⇒
    let [_ ⊢ oft/inl U (\x.O)] = d in
    let [_,x:obj ⊢ O'] = oft_cong_symm [_,x:obj ⊢ O] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/inl U (\x.O')]
  | [_ ⊢ ≡c/inr \x.C1] ⇒
    let [_ ⊢ oft/inr U (\x.O)] = d in
    let [_,x:obj ⊢ O'] = oft_cong_symm [_,x:obj ⊢ O] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/inr U (\x.O')]
  | [_ ⊢ ≡c/choice1 \x.C1] ⇒
    let [_ ⊢ oft/choice U (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O1'] = oft_cong_symm [_,x:obj ⊢ O1] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/choice U (\x.O1') (\x.O2)]
  | [_ ⊢ ≡c/choice2 \x.C1] ⇒
    let [_ ⊢ oft/choice U (\x.O1) (\x.O2)] = d in
    let [_,x:obj ⊢ O2'] = oft_cong_symm [_,x:obj ⊢ O2] [_,x:obj ⊢ C1] in
    [_ ⊢ oft/choice U (\x.O1) (\x.O2')]
  | [_ ⊢ ≡refl] ⇒ d
  | [_ ⊢ ≡sym C1] ⇒ oft_cong d [_ ⊢ C1]
  | [_ ⊢ ≡trans C1 C2] ⇒ oft_cong_symm (oft_cong_symm d [_ ⊢ C2]) [_ ⊢ C1]
  ;

% Renaming lemma: if P ⊢ Δ₁ where x :¹ A is the k-th entry of Δ₁, the rest of
% Δ₁, written Δ₁', does not mention x, and X :⁰ A is the n-th entry, then P[X/x]
% is typable in the context where the k-th entry is x :⁰ A and the n-th is
% X :¹ A.

rec oft_rename_gen : (Ψ:ctx) (Δ₁:[Ψ,x:obj ⊢ lctx (suc N[])])
  [Ψ,x:obj ⊢ oft P Δ₁]
  → [Ψ,x:obj ⊢ upd Δ₁ k[] x x A[] A[] 𝟙 𝟘 Δ₁⁰]
  → [Ψ,x:obj ⊢ del Δ₁⁰ k[] Δ₁'[..]]
  → [Ψ,x:obj ⊢ upd Δ₁⁰ n[] X[..] X[..] A[] A[] 𝟘 𝟙 Δ₂]
  → [Ψ,x:obj ⊢ oft P[..,X[..]] Δ₂] =
  / total 1 /
  fn d, uk, dl, un ⇒
  let [_,x:obj ⊢ UK] = uk in
  let [_,x:obj ⊢ DL] = dl in
  let [_,x:obj ⊢ UN] = un in
  case d of
  | [_,x:obj ⊢ oft/fwd DU[] U1 U2 E] ⇒
    (case comp_look [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] in
      let [_,x:obj ⊢ V] = upd_symm [_,x:obj ⊢ UN] in
      let [_,x:obj ⊢ del-upd U2ᵣ _ _ _ _] =
        del_upd [_,x:obj ⊢ DL] [_,x:obj ⊢ U2] (fn e ⇒ impossible e) in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U2ᵣ] in
      [_,x:obj ⊢ oft/fwd DU[] V U2 E]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ UK' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ UK] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,x:obj ⊢ upd-pushout U1' UN' _ _] =
        upd_pushout [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]
          (lookup_mult_neq_r [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]) in
      (case comp_look [_,x:obj ⊢ UK'] [_,x:obj ⊢ U2] of
      | [_,x:obj ⊢ look-eq _ _] ⇒
        let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ UK'] [_,x:obj ⊢ U2] in
        let [_,x:obj ⊢ V] = upd_symm [_,x:obj ⊢ UN'] in
        [_,x:obj ⊢ oft/fwd DU[] U1' V E]
      | [_,x:obj ⊢ look-neq NEQ'[] _ _] ⇒
        let [_,x:obj ⊢ lookintm U7] =
          lookup_upd [_,x:obj ⊢ U2] [_,x:obj ⊢ UK'] (neq_comm [ ⊢ NEQ']) in
        impossible exh_lookup [_,x:obj ⊢ E] [_,x:obj ⊢ U7]
      )
    )
  | [_,x:obj ⊢ oft/close U1 E] ⇒
    (case comp_look [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] in
      let [_,x:obj ⊢ V] = upd_symm [_,x:obj ⊢ UN] in
      [_,x:obj ⊢ oft/close V E]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ lookintm U2] =
        lookup_upd [_,x:obj ⊢ U1] [_,x:obj ⊢ UK] (neq_comm [ ⊢ NEQ]) in
      impossible exh_lookup [_,x:obj ⊢ E] [_,x:obj ⊢ U2]
    )
  | [_,x:obj ⊢ oft/wait U1 O1] ⇒
    (case comp_look [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] in
      let [_,x:obj ⊢ V] = upd_symm [_,x:obj ⊢ UN] in
      let [_,x:obj ⊢ O1s] = oft_del [_,x:obj ⊢ O1] [_,x:obj ⊢ DL] in
      let Prune-Oft [_ ⊢ _] [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ O1s] in
      [_,x:obj ⊢ oft/wait V O1]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ UK' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ UK] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,x:obj ⊢ upd-pushout U1' UN' _ _] =
        upd_pushout [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]
          (lookup_mult_neq_r [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]) in
      let [_,x:obj ⊢ O1'] =
        oft_rename_gen [_,x:obj ⊢ O1] [_,x:obj ⊢ UK']
          [_,x:obj ⊢ DL'] [_,x:obj ⊢ UN'] in
      [_,x:obj ⊢ oft/wait U1' O1']
    )
  | [_,x:obj ⊢ oft/out U1 M (\y.O1[..,y,x]) (\y.O2[..,y,x])] ⇒
    let [_,x:obj ⊢ merge-upd UKa UKb T[] M⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ UK] [_,x:obj ⊢ M] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M⁰] in
    let Prune-Merge [_ ⊢ _] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M'] in
    (case [ ⊢ T] of
    | [ ⊢ •/10] ⇒
      let [_,x:obj ⊢ merge-upd UNa UNb •/00 M₂ _ _ _] =
        merge_upd_cor [_,x:obj ⊢ UN] [_,x:obj ⊢ M⁰] [ ⊢ •/10] in
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ UKb] in
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ UNb] in
      let [_,x:obj ⊢ del-upd U1ᵣ DL' _ _ _] =
        del_upd [_,x:obj ⊢ DLb] [_,x:obj ⊢ U1] (fn e ⇒ impossible e) in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,y:obj,x:obj ⊢ O2s] =
        oft_del [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ del/n DL'[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O2s] in
      let [_,y:obj,x:obj ⊢ O1'] =
        oft_rename_gen [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ upd/n UKa[..,x]]
          [_,y:obj,x:obj ⊢ del/n DLa[..,x]] [_,y:obj,x:obj ⊢ upd/n UNa[..,x]] in
      [_,x:obj ⊢ oft/out U1 M₂ (\y.O1'[..,y,x]) (\y.O2[..,y,x])]
    | [ ⊢ •/01] ⇒
      let [_,x:obj ⊢ merge-upd UNa UNb •/00 M₂ _ _ _] =
        merge_upd_cor [_,x:obj ⊢ UN] [_,x:obj ⊢ M⁰] [ ⊢ •/01] in
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ UKa] in
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ UNa] in
      let [_,y:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ del/n DLa[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O1s] in
      (case comp_look [_,x:obj ⊢ UKb] [_,x:obj ⊢ U1] of
      | [_,x:obj ⊢ look-eq _ _] ⇒
        let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ UKb] [_,x:obj ⊢ U1] in
        let [_,x:obj ⊢ V] = upd_symm [_,x:obj ⊢ UNb] in
        let [_,y:obj,x:obj ⊢ O2s] =
          oft_del [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ del/n DLb[..,x]] in
        let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
          prune_oft [_,y:obj,x:obj ⊢ O2s] in
        [_,x:obj ⊢ oft/out V M₂ (\y.O1[..,y,x]) (\y.O2[..,y,x])]
      | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
        let [_,x:obj ⊢ pushout-delete U1⁰ UK' DL' U1ᵣ _ _ _] =
          pushout_delete [_,x:obj ⊢ UKb] [_,x:obj ⊢ DLb] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
        let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
        let [_,x:obj ⊢ upd-pushout U1' UN' _ _] =
          upd_pushout [_,x:obj ⊢ UNb] [_,x:obj ⊢ U1⁰]
            (lookup_mult_neq_r [_,x:obj ⊢ UNb] [_,x:obj ⊢ U1⁰]) in
        let [_,y:obj,x:obj ⊢ O2'] =
          oft_rename_gen [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ upd/n UK'[..,x]]
            [_,y:obj,x:obj ⊢ del/n DL'[..,x]]
            [_,y:obj,x:obj ⊢ upd/n UN'[..,x]] in
        [_,x:obj ⊢ oft/out U1' M₂ (\y.O1[..,y,x]) (\y.O2'[..,y,x])]
      )
    )
  | [_,x:obj ⊢ oft/inp U1 (\y.\z.O1[..,y,z,x])] ⇒
    (case comp_look [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] in
      let [_,x:obj ⊢ V] = upd_symm [_,x:obj ⊢ UN] in
      let [_,y:obj,z:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,z:obj,x:obj ⊢ O1]
          [_,y:obj,z:obj,x:obj ⊢ del/n (del/n DL[..,x])] in
      let Prune-Oft [_,y:obj,z:obj ⊢ _] [_,y:obj,z:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,z:obj,x:obj ⊢ O1s] in
      [_,x:obj ⊢ oft/inp V (\y.\z.O1[..,y,z,x])]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ UK' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ UK] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,x:obj ⊢ upd-pushout U1' UN' _ _] =
        upd_pushout [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]
          (lookup_mult_neq_r [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]) in
      let [_,y:obj,z:obj,x:obj ⊢ O1'] =
        oft_rename_gen [_,y:obj,z:obj,x:obj ⊢ O1]
          [_,y:obj,z:obj,x:obj ⊢ upd/n (upd/n UK'[..,x])]
          [_,y:obj,z:obj,x:obj ⊢ del/n (del/n DL'[..,x])]
          [_,y:obj,z:obj,x:obj ⊢ upd/n (upd/n UN'[..,x])] in
      [_,x:obj ⊢ oft/inp U1' (\y.\z.O1'[..,y,z,x])]
    )
  | [_,x:obj ⊢ oft/pcomp DU[] M (\y.O1[..,y,x]) (\y.O2[..,y,x])] ⇒
    let [_,x:obj ⊢ merge-upd UKa UKb T[] M⁰ _ _ _] =
      merge_upd_cor [_,x:obj ⊢ UK] [_,x:obj ⊢ M] [ ⊢ •/00] in
    let [_,x:obj ⊢ del-merge M' DLa DLb _ _] =
      del_merge [_,x:obj ⊢ DL] [_,x:obj ⊢ M⁰] in
    let Prune-Merge [_ ⊢ _] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M'] in
    (case [ ⊢ T] of
    | [ ⊢ •/10] ⇒
      let [_,x:obj ⊢ merge-upd UNa UNb •/00 M₂ _ _ _] =
        merge_upd_cor [_,x:obj ⊢ UN] [_,x:obj ⊢ M⁰] [ ⊢ •/10] in
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ UKb] in
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ UNb] in
      let [_,y:obj,x:obj ⊢ O2s] =
        oft_del [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ del/n DLb[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O2s] in
      let [_,y:obj,x:obj ⊢ O1'] =
        oft_rename_gen [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ upd/n UKa[..,x]]
          [_,y:obj,x:obj ⊢ del/n DLa[..,x]] [_,y:obj,x:obj ⊢ upd/n UNa[..,x]] in
      [_,x:obj ⊢ oft/pcomp DU[] M₂ (\y.O1'[..,y,x]) (\y.O2[..,y,x])]
    | [ ⊢ •/01] ⇒
      let [_,x:obj ⊢ merge-upd UNa UNb •/00 M₂ _ _ _] =
        merge_upd_cor [_,x:obj ⊢ UN] [_,x:obj ⊢ M⁰] [ ⊢ •/01] in
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ UKa] in
      let [_,x:obj ⊢ ctx/refl] = upd_refl_cor [_,x:obj ⊢ UNa] in
      let [_,y:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ del/n DLa[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O1s] in
      let [_,y:obj,x:obj ⊢ O2'] =
        oft_rename_gen [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ upd/n UKb[..,x]]
          [_,y:obj,x:obj ⊢ del/n DLb[..,x]] [_,y:obj,x:obj ⊢ upd/n UNb[..,x]] in
      [_,x:obj ⊢ oft/pcomp DU[] M₂ (\y.O1[..,y,x]) (\y.O2'[..,y,x])]
    )
  | [_,x:obj ⊢ oft/inl U1 (\y.O1[..,y,x])] ⇒
    (case comp_look [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] in
      let [_,x:obj ⊢ V] = upd_symm [_,x:obj ⊢ UN] in
      let [_,y:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ del/n DL[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O1s] in
      [_,x:obj ⊢ oft/inl V (\y.O1[..,y,x])]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ UK' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ UK] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,x:obj ⊢ upd-pushout U1' UN' _ _] =
        upd_pushout [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]
          (lookup_mult_neq_r [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]) in
      let [_,y:obj,x:obj ⊢ O1'] =
        oft_rename_gen [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ upd/n UK'[..,x]]
          [_,y:obj,x:obj ⊢ del/n DL'[..,x]] [_,y:obj,x:obj ⊢ upd/n UN'[..,x]] in
      [_,x:obj ⊢ oft/inl U1' (\y.O1'[..,y,x])]
    )
  | [_,x:obj ⊢ oft/inr U1 (\y.O1[..,y,x])] ⇒
    (case comp_look [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] in
      let [_,x:obj ⊢ V] = upd_symm [_,x:obj ⊢ UN] in
      let [_,y:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ del/n DL[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O1s] in
      [_,x:obj ⊢ oft/inr V (\y.O1[..,y,x])]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ UK' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ UK] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,x:obj ⊢ upd-pushout U1' UN' _ _] =
        upd_pushout [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]
          (lookup_mult_neq_r [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]) in
      let [_,y:obj,x:obj ⊢ O1'] =
        oft_rename_gen [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ upd/n UK'[..,x]]
          [_,y:obj,x:obj ⊢ del/n DL'[..,x]] [_,y:obj,x:obj ⊢ upd/n UN'[..,x]] in
      [_,x:obj ⊢ oft/inr U1' (\y.O1'[..,y,x])]
    )
  | [_,x:obj ⊢ oft/choice U1 (\y.O1[..,y,x]) (\y.O2[..,y,x])] ⇒
    (case comp_look [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] of
    | [_,x:obj ⊢ look-eq _ _] ⇒
      let [_,x:obj ⊢ ctx/refl] = upd_func [_,x:obj ⊢ UK] [_,x:obj ⊢ U1] in
      let [_,x:obj ⊢ V] = upd_symm [_,x:obj ⊢ UN] in
      let [_,y:obj,x:obj ⊢ O1s] =
        oft_del [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ del/n DL[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O1s] in
      let [_,y:obj,x:obj ⊢ O2s] =
        oft_del [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ del/n DL[..,x]] in
      let Prune-Oft [_,y:obj ⊢ _] [_,y:obj,x:obj ⊢ _] =
        prune_oft [_,y:obj,x:obj ⊢ O2s] in
      [_,x:obj ⊢ oft/choice V (\y.O1[..,y,x]) (\y.O2[..,y,x])]
    | [_,x:obj ⊢ look-neq NEQ[] _ _] ⇒
      let [_,x:obj ⊢ pushout-delete U1⁰ UK' DL' U1ᵣ _ _ _] =
        pushout_delete [_,x:obj ⊢ UK] [_,x:obj ⊢ DL] [_,x:obj ⊢ U1] [ ⊢ NEQ] in
      let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1ᵣ] in
      let [_,x:obj ⊢ upd-pushout U1' UN' _ _] =
        upd_pushout [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]
          (lookup_mult_neq_r [_,x:obj ⊢ UN] [_,x:obj ⊢ U1⁰]) in
      let [_,y:obj,x:obj ⊢ O1'] =
        oft_rename_gen [_,y:obj,x:obj ⊢ O1] [_,y:obj,x:obj ⊢ upd/n UK'[..,x]]
          [_,y:obj,x:obj ⊢ del/n DL'[..,x]] [_,y:obj,x:obj ⊢ upd/n UN'[..,x]] in
      let [_,y:obj,x:obj ⊢ O2'] =
        oft_rename_gen [_,y:obj,x:obj ⊢ O2] [_,y:obj,x:obj ⊢ upd/n UK'[..,x]]
          [_,y:obj,x:obj ⊢ del/n DL'[..,x]] [_,y:obj,x:obj ⊢ upd/n UN'[..,x]] in
      [_,x:obj ⊢ oft/choice U1' (\y.O1'[..,y,x]) (\y.O2'[..,y,x])]
    )
  ;

% Renaming lemma:
% If P ⊢ (Δ, x :¹ A), then P[y/x] ⊢ Δ[y :⁰ A ↦ₙ y :¹ A]

rec oft_rename : (Ψ:ctx) (Δ:[Ψ ⊢ lctx N[]])
  [Ψ,x:obj ⊢ oft P (cons Δ[..] x A[] 𝟙)]
  → [Ψ ⊢ upd Δ n[] X X A[] A[] 𝟘 𝟙 Δ']
  → [Ψ ⊢ oft P[..,X] Δ'] =
  / total 1 /
  fn d, u ⇒
  let [_ ⊢ U] = u in
  let [_,x:obj ⊢ O1] = oft_rename_gen d [_,x:obj ⊢ upd/t _] [_,x:obj ⊢ del/t _]
    [_,x:obj ⊢ upd/n U[..]] in
  let [_,x:obj ⊢ O2] = oft_str [_,x:obj ⊢ O1] in
  let Prune-Oft d' [_,x:obj ⊢ _] = prune_oft [_,x:obj ⊢ O2] in
  d'
  ;
