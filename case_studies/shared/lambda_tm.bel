%======================================================%
% Terms
%======================================================%

% λ-calculus terms as objects (using HOAS)

LF obj : type =
| lam : (obj → obj) → obj
| app : obj → obj → obj
| bang : obj → obj
| letbang : obj → (obj → obj) → obj;

%------------------------------------------------------%
% Values
%------------------------------------------------------%

% V is a value.

LF val : obj → type =
| val/lam : val (lam M)
| val/bang : val (bang M);
