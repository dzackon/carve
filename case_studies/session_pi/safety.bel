%======================================================%
% Type safety
%======================================================%

% If Δ ⊢ P, then P is not in error form

rec safety_form : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft Δ P] → [Ψ ⊢ error_form P] → [ ⊢ false] =
  / total 2 /
  fn d, e ⇒ case e of
  | [_ ⊢ err/par NR] ⇒
    let [_ ⊢ oft/res DU[] \x.\y.oft/par Dpq _ (mg/c (mg/c M1 Tx[]) Ty[])] = d in
    let Prune-Merge [_,x:obj ⊢ M1'] [_,x:obj,y:obj ⊢ _] =
      prune_merge [_,x:obj,y:obj ⊢ M1] in
    let Prune-Merge [_ ⊢ _] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1'] in
    let [_,x:obj,y:obj ⊢ oft/par Dp Dq (mg/c (mg/c M2 Tx2[]) Ty2[])] =
      [_,x:obj,y:obj ⊢ Dpq] in
    let Prune-Merge [_,x:obj ⊢ M2'] [_,x:obj,y:obj ⊢ _] =
      prune_merge [_,x:obj,y:obj ⊢ M2] in
    let Prune-Merge [_ ⊢ _] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M2'] in
    let [_ ⊢ prfs (\x.\y.PF1) (\x.\y.PF2)] = pref_mismatch_pair [_ ⊢ NR] in
    let [ ⊢ mult/refl] = pref_lin [_,x:obj,y:obj ⊢ Dq] [_,x:obj,y:obj ⊢ PF2] in
    let [ ⊢ •/01] = [ ⊢ Ty2] in
    let [ ⊢ •/10] = [ ⊢ Ty] in
    let [_,x:obj,y:obj ⊢ Dp'] = oft_exch_top [_,x:obj,y:obj ⊢ Dp] in
    let [ ⊢ mult/refl] =
      pref_lin [_,y:obj,x:obj ⊢ Dp'[..,x,y]] [_,y:obj,x:obj ⊢ PF1[..,x,y]] in
    let [ ⊢ •/10] = [ ⊢ Tx2] in
    let Str-Top _ [_,x:obj,y:obj ⊢ _] = oft_str [_,x:obj,y:obj ⊢ Dp] in
    let [_,x:obj,y:obj ⊢ Dq'] = oft_exch_top [_,x:obj,y:obj ⊢ Dq] in
    let Str-Top _ [_,y:obj,x:obj ⊢ _] =
      oft_str [_,y:obj,x:obj ⊢ Dq'[..,x,y]] in
    typed_pref_mismatch_contra [_ ⊢ NR] [_,x:obj,y:obj ⊢ Dpq] [ ⊢ DU]
  | [_ ⊢ err/res \x.\y.E] ⇒
    let [_ ⊢ oft/res _ \x.\y.D1] = d in
    safety_form [_,x:obj,y:obj ⊢ D1] [_,x:obj,y:obj ⊢ E]
  ;

% If Δ ⊢ P, then P is not a run-time error

rec safety : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft Δ P] → [Ψ ⊢ runtime_error P] → [ ⊢ false] =
  / total 1 /
  fn d, e ⇒
  let [_ ⊢ runtime-error C E] = e in
  safety_form (oft_cong [_ ⊢ C] d) [_ ⊢ E]
  ;

% Corollary: No process reachable from a well-typed process has a
% prefix-mismatch error

rec safety_reachable : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ oft Δ P] → [Ψ ⊢ P ⇛* Q] → [Ψ ⊢ runtime_error Q]
  → [ ⊢ false] =
  / total /
  fn d, r, e ⇒ safety (preservation_multi r d) e
  ;
