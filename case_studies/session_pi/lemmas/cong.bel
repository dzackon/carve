%======================================================%
% Properties of process congruence
%======================================================%

% Structural congruence is reflexive

rec cong_refl : (Ψ:ctx) {P:[Ψ ⊢ proc]} [Ψ ⊢ P ≡ P] =
  / total 1 /
  mlam P ⇒ case [_ ⊢ P] of
  | [_ ⊢ null] ⇒ [_ ⊢ ≡c/null]
  | [_ ⊢ wait _ P'] ⇒
    let [_ ⊢ C1] = cong_refl [_ ⊢ P'] in
    [_ ⊢ ≡c/wait C1]
  | [_ ⊢ close _ P'] ⇒
    let [_ ⊢ C1] = cong_refl [_ ⊢ P'] in
    [_ ⊢ ≡c/close C1]
  | [_ ⊢ inp _ \x.P'] ⇒
    let [_,x:obj ⊢ C1] = cong_refl [_,x:obj ⊢ P'] in
    [_ ⊢ ≡c/inp \x.C1]
  | [_ ⊢ out _ _ P'] ⇒
    let [_ ⊢ C1] = cong_refl [_ ⊢ P'] in
    [_ ⊢ ≡c/out C1]
  | [_ ⊢ par P' P''] ⇒
    let [_ ⊢ C1] = cong_refl [_ ⊢ P'] in
    let [_ ⊢ C2] = cong_refl [_ ⊢ P''] in
    [_ ⊢ ≡trans (≡trans (≡c/par C1) (≡trans ≡par/comm (≡c/par C2))) ≡par/comm]
  | [_ ⊢ res \x.\y.P'] ⇒
    let [_,x:obj,y:obj ⊢ C1] = cong_refl [_,x:obj,y:obj ⊢ P'] in
    [_ ⊢ ≡c/res \x.\y.C1]
  ;

%------------------------------------------------------%
% Preservation for ≡
%------------------------------------------------------%

rec oft_cong : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ P ≡ Q]
  → [Ψ ⊢ oft Δ P]
  → [Ψ ⊢ oft Δ Q] =
  / total 1 /
  fn c, d ⇒ case c of
  % axioms
  | [_ ⊢ ≡par/comm] ⇒
    let [_ ⊢ oft/par D1 D2 M] = d in
    let [_ ⊢ M'] = merge_comm [_ ⊢ M] in
    [_ ⊢ oft/par D2 D1 M']
  | [_ ⊢ ≡par/assoc] ⇒
    let [_ ⊢ oft/par (oft/par D1 D2 M1) D3 M2] = d in
    let [_ ⊢ merge-assoc M3 M4 _ _] = merge_assoc [_ ⊢ M2] [_ ⊢ M1] in
    [_ ⊢ oft/par D1 (oft/par D2 D3 M3) M4]
  | [_ ⊢ ≡par/null _] ⇒
    let [_ ⊢ oft/par D1 (oft/null E) M] = d in
    let [_ ⊢ ctx/refl] = merge_id mult_halident (merge_comm [_ ⊢ M]) [_ ⊢ E] in
    [_ ⊢ D1]
  | [_ ⊢ ≡res/par] ⇒
    let [_ ⊢ oft/par (oft/res DU[] \x.\y.D1) D2 M] = d in
    let [ ⊢ _]:[ ⊢ dual T T'] = [ ⊢ DU] in
    let [_,x:obj ⊢ D3'] = oft_weak [_,x:obj ⊢ D2[..]] [_,x:obj ⊢ x] [ ⊢ T] in
    let [_,x:obj,y:obj ⊢ D3] =
      oft_weak [_,x:obj,y:obj ⊢ D3'[..,x]] [_,x:obj,y:obj ⊢ y] [ ⊢ T'] in
    [_ ⊢ oft/res DU[] \x.\y.oft/par D1 D3 (mg/c (mg/c M[..] •/10) •/10)]
  | [_ ⊢ ≡res/swapB] ⇒
    let [_ ⊢ oft/res DU1[] \w.\x.oft/res DU2[] \y.\z.D1] = d in
    let [_,w:obj,x:obj,y:obj,z:obj ⊢ _]:
      [_,w:obj,x:obj,y:obj,z:obj ⊢ oft
        (cons (cons (cons (cons Δ[..] _ T[] _) _ T'[] _) _ U[] _) _ U'[] _) _] =
      [_,w:obj,x:obj,y:obj,z:obj ⊢ D1] in
    let [_,x:obj,y:obj ⊢ exch/u NEQ[] EX1 EX2] =
      exch_top [_,x:obj,y:obj ⊢ Δ[..]] [_,x:obj,y:obj ⊢ x] [ ⊢ T] [ ⊢ 𝟙]
        [_,x:obj,y:obj ⊢ y] [ ⊢ U] [ ⊢ 𝟙] in
    let [_,w:obj,x:obj,y:obj,z:obj ⊢ D2'[..,y,z,w,x]] = oft_exch_top
      (oft_exch_top2 (oft_exch (oft_exch_top2 [_,w:obj,x:obj,y:obj,z:obj ⊢ D1])
      [_,w:obj,x:obj,y:obj,z:obj ⊢ exch/u NEQ[] (upd/n (upd/n EX1[..,w,y]))
        (upd/n (upd/n EX2[..,w,y]))])) in
    [_ ⊢ oft/res DU2[] \w.\x.oft/res DU1[] \y.\z.D2']
  | [_ ⊢ ≡res/swapC] ⇒
    let [_ ⊢ oft/res DU1[] \x.\y.D1] = d in
    let [_,x:obj,y:obj ⊢ D2] = oft_exch_top [_,x:obj,y:obj ⊢ D1] in
    let [ ⊢ DU2] = dual_symm [ ⊢ DU1] in
    [_ ⊢ oft/res DU2[] \x.\y.D2[..,y,x]]
  % congruence rules
  | [_ ⊢ ≡c/null] ⇒ d
  | [_ ⊢ ≡c/wait C1] ⇒
    let [_ ⊢ oft/wait U1 D1] = d in
    let [_ ⊢ D1'] = oft_cong [_ ⊢ C1] [_ ⊢ D1] in
    [_ ⊢ oft/wait U1 D1']
  | [_ ⊢ ≡c/close C1] ⇒
    let [_ ⊢ oft/close U1 D1] = d in
    let [_ ⊢ D1'] = oft_cong [_ ⊢ C1] [_ ⊢ D1] in
    [_ ⊢ oft/close U1 D1']
  | [_ ⊢ ≡c/inp \x.C1] ⇒
    let [_ ⊢ oft/inp U1 \x.D1] = d in
    let [_,x:obj ⊢ D1'] = oft_cong [_,x:obj ⊢ C1] [_,x:obj ⊢ D1] in
    [_ ⊢ oft/inp U1 \x.D1']
  | [_ ⊢ ≡c/out C1] ⇒
    let [_ ⊢ oft/out U1 U2 D1] = d in
    let [_ ⊢ D1'] = oft_cong [_ ⊢ C1] [_ ⊢ D1] in
    [_ ⊢ oft/out U1 U2 D1']
  | [_ ⊢ ≡c/par C1] ⇒
    let [_ ⊢ oft/par D1 D2 M] = d in
    let [_ ⊢ D1'] = oft_cong [_ ⊢ C1] [_ ⊢ D1] in
    [_ ⊢ oft/par D1' D2 M]
  | [_ ⊢ ≡c/res \x.\y.C1] ⇒
    let [_ ⊢ oft/res DU[] \x.\y.D1] = d in
    let [_,x:obj,y:obj ⊢ D1'] =
      oft_cong [_,x:obj,y:obj ⊢ C1] [_,x:obj,y:obj ⊢ D1] in
    [_ ⊢ oft/res DU[] \x.\y.D1']
  % symmetry, transitivity
  | [_ ⊢ ≡sym C1] ⇒ oft_cong_symm [_ ⊢ C1] d
  | [_ ⊢ ≡trans C1 C2] ⇒ oft_cong [_ ⊢ C2] (oft_cong [_ ⊢ C1] d)

and rec oft_cong_symm : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
  [Ψ ⊢ P ≡ Q]
  → [Ψ ⊢ oft Δ Q]
  → [Ψ ⊢ oft Δ P] =
  / total 1 /
  fn c, d ⇒ case c of
  | [_ ⊢ ≡par/comm] ⇒
    let [_ ⊢ oft/par D1 D2 M] = d in
    let [_ ⊢ M'] = merge_comm [_ ⊢ M] in
    [_ ⊢ oft/par D2 D1 M']
  | [_ ⊢ ≡par/assoc] ⇒
    let [_ ⊢ oft/par D1 (oft/par D2 D3 M1) M2] = d in
    let [_ ⊢ M2'] = merge_comm [_ ⊢ M2] in
    let [_ ⊢ merge-assoc2 M3' M4 _ _] = merge_assoc_swap [_ ⊢ M2'] [_ ⊢ M1] in
    let [_ ⊢ M3] = merge_comm [_ ⊢ M3'] in
    [_ ⊢ oft/par (oft/par D1 D2 M3) D3 M4]
  | [_ ⊢ ≡par/null _] ⇒
    let [_ ⊢ D1]:[_ ⊢ oft Δ _] = d in
    let [_ ⊢ merge-getid M E1] = merge_getid [_ ⊢ Δ] in
    [_ ⊢ oft/par D1 (oft/null E1) M]
  | [_ ⊢ ≡res/par] ⇒
    let [_ ⊢ oft/res DU[] \x.\y.oft/par D1 D2 (mg/c (mg/c M1 T1[]) T2[])] = d in
    let Prune-Merge [_,x:obj ⊢ M1'] [_,x:obj,y:obj ⊢ _] =
      prune_merge [_,x:obj,y:obj ⊢ M1] in
    let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1'] in
    let [ ⊢ mult/refl] = oft_notin_fv [_,x:obj ⊢ _] [_,x:obj,y:obj ⊢ D2]
      (upd_refl_top [_ ⊢ _] [_ ⊢ _] [ ⊢ _] [ ⊢ _]) in
    let Str-Top [_,x:obj ⊢ D2'] [_,x:obj,y:obj ⊢ _] =
      oft_str [_,x:obj,y:obj ⊢ D2] in
    let [ ⊢ mult/refl] = oft_notin_fv [_ ⊢ _] [_,x:obj ⊢ D2']
      (upd_refl_top [_ ⊢ _] [_ ⊢ _] [ ⊢ _] [ ⊢ _]) in
    let Str-Top [_ ⊢ D2''] [_,x:obj ⊢ _] = oft_str [_,x:obj ⊢ D2'] in
    let ([ ⊢ •/10],[ ⊢ •/10]) = ([ ⊢ T1],[ ⊢ T2]) in
    [_ ⊢ oft/par (oft/res DU[] \x.\y.D1) D2'' M2]
  | [_ ⊢ ≡res/swapB] ⇒
    let [_ ⊢ oft/res DU1[] \w.\x.oft/res DU2[] \y.\z.D1] = d in
    let [_,w:obj,x:obj,y:obj,z:obj ⊢ _]:
      [_,w:obj,x:obj,y:obj,z:obj ⊢ oft
        (cons (cons (cons (cons Δ[..] _ T[] _) _ T'[] _) _ U[] _) _ U'[] _) _] =
      [_,w:obj,x:obj,y:obj,z:obj ⊢ D1] in
    let [_,x:obj,y:obj ⊢ exch/u NEQ[] EX1 EX2] =
      exch_top [_,x:obj,y:obj ⊢ Δ[..]] [_,x:obj,y:obj ⊢ x] [ ⊢ T] [ ⊢ 𝟙]
        [_,x:obj,y:obj ⊢ y] [ ⊢ U] [ ⊢ 𝟙] in
    let [_,w:obj,x:obj,y:obj,z:obj ⊢ D2'[..,y,z,w,x]] =
      oft_exch_top (oft_exch_top2 (oft_exch
        (oft_exch_top2 [_,w:obj,x:obj,y:obj,z:obj ⊢ D1])
      [_,w:obj,x:obj,y:obj,z:obj ⊢ exch/u NEQ[] (upd/n (upd/n EX1[..,w,y]))
        (upd/n (upd/n EX2[..,w,y]))])) in
    [_ ⊢ oft/res DU2[] \w.\x.oft/res DU1[] \y.\z.D2']
  | [_ ⊢ ≡res/swapC] ⇒
    let [_ ⊢ oft/res DU1[] \x.\y.D1] = d in
    let [_,x:obj,y:obj ⊢ D2] = oft_exch_top [_,x:obj,y:obj ⊢ D1] in
    let [ ⊢ DU2] = dual_symm [ ⊢ DU1] in
    [_ ⊢ oft/res DU2[] \x.\y.D2[..,y,x]]
  % congruence rules
  | [_ ⊢ ≡c/null] ⇒ d
  | [_ ⊢ ≡c/wait C1] ⇒
    let [_ ⊢ oft/wait U1 D1] = d in
    let [_ ⊢ D1'] = oft_cong_symm [_ ⊢ C1] [_ ⊢ D1] in
    [_ ⊢ oft/wait U1 D1']
  | [_ ⊢ ≡c/close C1] ⇒
    let [_ ⊢ oft/close U1 D1] = d in
    let [_ ⊢ D1'] = oft_cong_symm [_ ⊢ C1] [_ ⊢ D1] in
    [_ ⊢ oft/close U1 D1']
  | [_ ⊢ ≡c/inp \x.C1] ⇒
    let [_ ⊢ oft/inp U1 \x.D1] = d in
    let [_,x:obj ⊢ D1'] = oft_cong_symm [_,x:obj ⊢ C1] [_,x:obj ⊢ D1] in
    [_ ⊢ oft/inp U1 \x.D1']
  | [_ ⊢ ≡c/out C1] ⇒
    let [_ ⊢ oft/out U1 U2 D1] = d in
    let [_ ⊢ D1'] = oft_cong_symm [_ ⊢ C1] [_ ⊢ D1] in
    [_ ⊢ oft/out U1 U2 D1']
  | [_ ⊢ ≡c/par C1] ⇒
    let [_ ⊢ oft/par D1 D2 M] = d in
    let [_ ⊢ D1'] = oft_cong_symm [_ ⊢ C1] [_ ⊢ D1] in
    [_ ⊢ oft/par D1' D2 M]
  | [_ ⊢ ≡c/res \x.\y.C1] ⇒
    let [_ ⊢ oft/res DU[] \x.\y.D1] = d in
    let [_,x:obj,y:obj ⊢ D1'] =
      oft_cong_symm [_,x:obj,y:obj ⊢ C1] [_,x:obj,y:obj ⊢ D1] in
    [_ ⊢ oft/res DU[] \x.\y.D1']
  % symmetry, transitivity
  | [_ ⊢ ≡sym C1] ⇒ oft_cong [_ ⊢ C1] d
  | [_ ⊢ ≡trans C1 C2] ⇒ oft_cong_symm [_ ⊢ C1] (oft_cong_symm [_ ⊢ C2] d)
  ;

%------------------------------------------------------%
% Canonical form lemmas
%------------------------------------------------------%

% Parallel compositions of canonical forms are congruent to canonical forms

rec canonical_form_lemma1 : (Ψ:ctx)
  [Ψ ⊢ can_par P]
  → [Ψ ⊢ can_par Q]
  → [Ψ ⊢ equiv_can_par (par P Q)] =
  / total 2 /
  fn c1, c2 ⇒ case c2 of
  | [_ ⊢ bcan/pref P1]:[_ ⊢ can_par Q] ⇒
    let [_ ⊢ C1]:[Ψ ⊢ can_par P] = c1 in
    let [_ ⊢ C3] = cong_refl [_ ⊢ par P Q] in
    [_ ⊢ equiv-can-par C3 (bcan/can C1 P1)]
  | [_ ⊢ bcan/can C2 P1] ⇒
    let [_ ⊢ equiv-can-par E C3] = canonical_form_lemma1 c1 [_ ⊢ C2] in
    [_ ⊢ equiv-can-par (≡trans (≡sym ≡par/assoc) (≡c/par E)) (bcan/can C3 P1)]
  ;

rec canonical_form_lemma2 : (Ψ:ctx)
  [Ψ ⊢ can_par P]
  → [Ψ ⊢ can_form Q]
  → [Ψ ⊢ equiv_can_form (par P Q)] =
  / total 2 /
  fn c1, c2 ⇒
  let [_ ⊢ C1] = c1 in
  case c2 of
  | [_ ⊢ can/null] ⇒ [_ ⊢ equiv-can-form (≡par/null _) (can/par C1)]
  | [_ ⊢ can/par C2] ⇒
    let [_ ⊢ equiv-can-par E C3] = canonical_form_lemma1 c1 [_ ⊢ C2] in
    [_ ⊢ equiv-can-form E (can/par C3)]
  | [_ ⊢ can/res \x.\y.C2] ⇒
    let [_,x:obj,y:obj ⊢ equiv-can-form E C3] =
      canonical_form_lemma2 [_,x:obj,y:obj ⊢ C1[..]] [_ ⊢ C2] in
    [_ ⊢ equiv-can-form
      (≡trans (≡trans ≡par/comm (≡trans ≡res/par (≡c/res \x.\y.≡par/comm)))
        (≡c/res \x.\y.E)) (can/res \x.\y.C3)]
  ;

rec canonical_form_lemma3 : (Ψ:ctx)
  [Ψ ⊢ can_form P]
  → [Ψ ⊢ can_form Q]
  → [Ψ ⊢ equiv_can_form (par P Q)] =
  / total 1 /
  fn c1, c2 ⇒ case c1 of
  | [_ ⊢ can/null] ⇒
    let [_ ⊢ C2] = c2 in
    [_ ⊢ equiv-can-form (≡trans ≡par/comm (≡par/null _)) C2]
  | [_ ⊢ can/par C1] ⇒ canonical_form_lemma2 [_ ⊢ C1] c2
  | [_ ⊢ can/res \x.\y.C1] ⇒
    let [_ ⊢ C2] = c2 in
    let [_,x:obj,y:obj ⊢ equiv-can-form E C3] =
      canonical_form_lemma3 [_,x:obj,y:obj ⊢ C1] [_,x:obj,y:obj ⊢ C2[..]] in
    [_ ⊢ equiv-can-form
      (≡trans ≡res/par (≡c/res \x.\y.E)) (can/res \x.\y.C3)]
  ;
