%======================================================%
% Dynamics of the session-typed calculus
%======================================================%

% Operational semantics

--infix ⇛ 10 left.
LF ⇛ : proc → proc → type =

| ⇛close :
  (res \x.\y.par (wait x P) (close y Q)) ⇛ (par P Q)

| ⇛com :
  (res \x.\y.par (inp x (P x y)) (out y (Z x y) (Q x y)))
  ⇛ (res \x.\y.par (P x y (Z x y)) (Q x y))

| ⇛par : P ⇛ P' → (par P Q) ⇛ (par P' Q)

| ⇛res : ({x:obj} {y:obj} (P x y) ⇛ (Q x y)) → (res P) ⇛ (res Q)

| ⇛struc : P ≡ P' → P' ⇛ Q' → Q' ≡ Q → P ⇛ Q;

% Reflexive-transitive closure

--infix ⇛* 10 left.
LF ⇛* : proc → proc → type =
| ⇛*refl : P ≡ P' → P ⇛* P'
| ⇛*trans : P ⇛ Q → Q ⇛* R → P ⇛* R;
